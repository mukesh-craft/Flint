# Brotli decompression, called from Flint.
# The compressed bytes below were produced by the reference `brotli` CLI
# (quality 9), not by this runtime, so decoding them proves interoperability.

fn main() {
    compressed = flint_read_file("tests/fixtures/brotli_ref.bin")

    # 54 bytes in, 2880 bytes out: the stream exercises backreferences
    # rather than literals.
    print(flint_brotli_decompress(compressed, 54, 0) == 1)
    print(flint_brotli_len() == 2880)

    decoded = flint_brotli_last()
    print(flint_str_substring(decoded, 0, 44) == "The quick brown fox jumps over the lazy dog.")

    # The output limit is enforced: the same stream against a 1 KiB cap fails
    # rather than allocating past the limit.
    print(flint_brotli_decompress(compressed, 54, 1024) == 0)
    print(flint_str_length(flint_brotli_error()) > 0)

    # Garbage, truncation and an empty buffer are all rejected.
    junk = flint_read_file("tests/fixtures/brotli_junk.bin")
    print(flint_brotli_decompress(junk, 8, 0) == 0)
    print(flint_brotli_decompress(compressed, 10, 0) == 0)
    print(flint_brotli_decompress(compressed, 0, 0) == 0)
}
