struct Point {
    x: i64,
    y: i64
}
enum Color {
    Red,
    Green,
    Blue
}
fn fact(n: i64) -> i64 {
    if n < 2 {
        1
    } else {
        n * fact(n - 1)
    }
}
fn paint(c: Color) -> i64 {
    m = match c {
        Color.Red => 10,
        Color.Green => 20,
        Color.Blue => 30
    }
    m
}
fn main() -> i64 {
    print(fact(8))
    p = Point { x: 3, y: 4 }
    print(p.x + p.y)
    print(paint(Color.Green))
    mut s: i64 = 0
    for v in 1..6 {
        s = s + v
    }
    print(s)
    print("do" + "ne")
    0
}
