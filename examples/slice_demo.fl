fn main() {
    let arr = [10, 20, 30, 40, 50]
    print(arr[0])
    print(arr[1])

    // Slice: arr[1:4] → [20, 30, 40]
    // This returns a Vec at runtime
    let sliced = arr[1:4]
    print(flint_vec_len(sliced))
    print(flint_vec_get(sliced, 0))
    print(flint_vec_get(sliced, 1))
    print(flint_vec_get(sliced, 2))

    // For-in over a Vec is not implemented yet (E0079); iterate by index.
    // A slice returns a runtime FlintVec*, so the length/get calls below are
    // the supported access path.
    print("--- indexed loop over the slice ---")
    mut i: i64 = 0
    while i < flint_vec_len(sliced) {
        print(flint_vec_get(sliced, i))
        i = i + 1
    }

    // For x in range still works
    print("--- for-in range ---")
    for i in 0..3 {
        print(i)
    }
}
