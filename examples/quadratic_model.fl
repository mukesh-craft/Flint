extern "C" {
    fn flt_create(ndim: i64, shape: str) -> str
    fn flt_create_2d(r: i64, c: i64) -> str
    fn flt_destroy(t: str)
    fn flt_fill(t: str, v: f64)
    fn flt_get(t: str, i: i64) -> f64
    fn flt_set(t: str, i: i64, v: f64)
    fn flt_uniform(t: str, lo: f64, hi: f64)
    fn mse_loss(p: str, t: str) -> f64
    fn mse_loss_grad(p: str, t: str) -> str
    fn flt_print_tensor(t: str, max: i64)
}

# y = 3*x^2 - 2*x + 1, learned by plain SGD on MSE.
fn main() -> i64 {
    n: i64 = 200
    shp = flint_array_alloc(2)
    sd = flint_array_data(shp)
    flint_array_write_i64(sd, 0, n)
    flint_array_write_i64(sd, 1, 1)

    x = flt_create(2, sd)
    y = flt_create(2, sd)
    flt_uniform(x, -2.0, 2.0)
    mut i: i64 = 0
    while i < n {
        xi: f64 = flt_get(x, i)
        flt_set(y, i, 3.0 * xi * xi - 2.0 * xi + 1.0)
        i = i + 1
    }

    w2: str = flt_create(2, sd)   # hack: same Nx1 shape, used as scalar holder
    w1: str = flt_create(2, sd)
    b: str = flt_create(2, sd)
    flt_fill(w2, 0.0)
    flt_fill(w1, 0.0)
    flt_fill(b, 0.0)

    pred = flt_create(2, sd)

    mut epoch: i64 = 0
    while epoch < 300 {
        mut j: i64 = 0
        while j < n {
            xj: f64 = flt_get(x, j)
            flt_set(pred, j, flt_get(w2, 0) * xj * xj + flt_get(w1, 0) * xj + flt_get(b, 0))
            j = j + 1
        }
        loss: f64 = mse_loss(pred, y)
        grad = mse_loss_grad(pred, y)
        mut dw2: f64 = 0.0
        mut dw1: f64 = 0.0
        mut db: f64 = 0.0
        j = 0
        while j < n {
            xj2: f64 = flt_get(x, j)
            dw2 = dw2 + flt_get(grad, j) * xj2 * xj2
            dw1 = dw1 + flt_get(grad, j) * xj2
            db = db + flt_get(grad, j)
            j = j + 1
        }
        flt_set(w2, 0, flt_get(w2, 0) - 0.05 * dw2)
        flt_set(w1, 0, flt_get(w1, 0) - 0.05 * dw1)
        flt_set(b, 0, flt_get(b, 0) - 0.05 * db)
        if epoch % 100 == 0 {
            flint_print("epoch ")
            flint_println_i64(epoch)
            flint_print("loss = ")
            flint_println_f64(loss)
        }
        flt_destroy(grad)
        epoch = epoch + 1
    }
    flint_print("final w2 = ")
    flint_println_f64(flt_get(w2, 0))
    flint_print("final w1 = ")
    flint_println_f64(flt_get(w1, 0))
    flint_print("final b  = ")
    flint_println_f64(flt_get(b, 0))
    flint_print("expected: w2~3.0 w1~-2.0 b~1.0\n")

    flt_destroy(x); flt_destroy(y); flt_destroy(w2); flt_destroy(w1); flt_destroy(b)
    flt_destroy(pred)
    return 0
}
