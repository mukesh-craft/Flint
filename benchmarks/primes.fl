fn main() -> i64 {
    limit = 10000000
    sieve = flint_array_alloc(limit + 1)

    t0 = flint_time_ns()
    mut i: i64 = 2
    while i * i <= limit {
        if flint_array_get(sieve, i) == 0 {
            mut j = i * i
            while j <= limit {
                flint_array_set(sieve, j, 1)
                j = j + i
            }
        }
        i = i + 1
    }

    mut count: i64 = 0
    i = 2
    while i <= limit {
        if flint_array_get(sieve, i) == 0 { count = count + 1 }
        i = i + 1
    }
    elapsed = flint_time_ns() - t0

    flint_print("primes up to 10M: ")
    flint_println(flint_i64_to_string(count))
    flint_print("time: ")
    flint_print(flint_i64_to_string(elapsed))
    flint_println(" ns")
    flint_array_free(sieve)
    0
}
