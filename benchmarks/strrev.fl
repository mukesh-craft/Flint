fn build_string(n: i64) -> str {
    # Linear builder path (R5): loop `+` concat is O(n^2) and leaks every
    # intermediate; the builder amortizes growth and frees once.
    sb = flint_sb_new()
    mut i: i64 = 0
    while i < n {
        ch = flint_i64_to_string(97 + (i % 26))
        flint_sb_append(sb, ch)
        flint_str_free(ch)
        i = i + 1
    }
    s = flint_sb_build(sb)
    flint_sb_free(sb)
    s
}

fn main() -> i64 {
    n = 100000
    s = build_string(n)
    t0 = flint_time_ns()
    mut sum: i64 = 0
    mut i: i64 = 0
    while i < n {
        sum = sum + flint_str_char_at(s, n - 1 - i)
        i = i + 1
    }
    elapsed = flint_time_ns() - t0
    flint_print("checksum: ")
    flint_println(flint_i64_to_string(sum))
    flint_print("time: ")
    flint_print(flint_i64_to_string(elapsed))
    flint_println(" ns")
    0
}
