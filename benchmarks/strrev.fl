fn build_string(n: i64) -> str {
    mut s = ""
    mut i: i64 = 0
    while i < n {
        ch = flint_i64_to_string(97 + (i % 26))
        s = flint_str_concat(s, ch)
        flint_str_free(ch)
        i = i + 1
    }
    s
}

fn main() -> i64 {
    n = 100000
    s = build_string(n)
    t0 = flint_time_ns()
    mut sum: i64 = 0
    mut i: i64 = 0
    while i < n {
        sum = sum + flint_str_char_at(s, n - 1 - i)
        i = i + 1
    }
    elapsed = flint_time_ns() - t0
    flint_print("checksum: ")
    flint_println(flint_i64_to_string(sum))
    flint_print("time: ")
    flint_print(flint_i64_to_string(elapsed))
    flint_println(" ns")
    0
}
