# stage3/flint_emit.fl — S-expr to LLVM IR text (Stage 3, self-hosting).
#
# Usage: flintc stage3/flint_emit.fl -- prog.sexp prog.ll
# Reads an S-expression IR file (Stage-2 output), writes LLVM IR text.
# Scope: G0 (prog/main/decl/assign/return/call-print/num/str/var) +
# G1 (binops/if/while/break/continue + overflow/divzero panics) +
# G2 (multi-fn, calls with defaults/promo/variadics, extern, returns,
# trailing-expr values, C-escape unescaping) +
# G3 (i64 arrays/index/bounds-checks, str indexing, len, concat) +
# G4 (for over range/array/str with break/continue, versioned locals) +
# G5 (structs/nested, tag-only enums, exhaustive match + panic backstop) +
# G6 (maps/methods, runtime passthrough, globals, conversions, string
# ==/!=, {{ }}/escapes, merged imports). Allocas entry-hoisted (pre-pass)
# for LLVM dominance. Two passes: signatures, then emit. This compiler
# compiles itself (see tests/test_selfhost.sh Phase A/B/C).
#
# DESIGN (proven Stage 1/2 patterns): S-expr cursor is a 1-elem vec (EC);
# expression emitters RETURN LLVM value text and set ETYPE (typecode side
# channel, like pp's PPPREC); sym tables are scope-stamped maps (like PDECL);
# no short-circuit `and` relied on; `mut` loop bounds; `//` is a comment.
# Type codes: 1 i64, 2 f64, 3 str/ptr, 0 void/unknown.
import "../stage1/flint_lex"
# S-expr input globals (set once by driver; never reassigned, only read).
mut ESRC: str = ""
EC = flint_vec_new()
# Counters + output builder (mutated, never reassigned).
mut ETMP: i64 = 0
mut ESTR: i64 = 0
mut EERR: i64 = 0
mut ETYPE: i64 = 0
mut ELBL: i64 = 0
mut ETERM: i64 = 0
mut EBREAK: str = ""
mut ECONT: str = ""
mut ECUR: str = "entry"
EOUT = flint_sb_new()
# String globals buffer (emitted at module top after prelude, before body).
EGLOB = flint_sb_new()
# Symbol tables: name -> scope id / typecode.
EMAP = map {
    "": 0
}
ETYPEMAP = map {
    "": 0
}
mut ESCOPE: i64 = 1
# Local versions: name -> decl count (shadowing/redeclaration emits a fresh
# alloca; version 0 keeps the legacy `%nm.addr` name for stable goldens).
EVERSION = map {
    "": 0
}
# ---- G2: function signature registry (pre-scan pass) ----
# Flint vecs hold i64 only, so default-arg S-expr texts live concatenated
# in ESIGTEXT; EFPOFF/EFPLEN locate each param's default (off -1 = none).
# NOTE: these must precede ANY function that touches them — C++ resolves
# method calls by declaration order (use-before-decl falls back to `fa_*`
# and fails closed with "undefined function").
EFNMAP = map {
    "": 0
}
EFNN = flint_vec_new()
EFNRET = flint_vec_new()
EFNEXT = flint_vec_new()
EFNVAR = flint_vec_new()
EFNPB = flint_vec_new()
EFPTYPE = flint_vec_new()
EFPOFF = flint_vec_new()
EFPLEN = flint_vec_new()
EFPNOff = flint_vec_new()
EFPNLen = flint_vec_new()
mut ESIGTEXT: str = ""
# ---- G6a: top-level globals (self-hosting) ----
# EGNAME name->idx; EGCODE/EGOff/EGLen parallel; init S-expr texts in EGTEXT.
# NOTE: kept up here (not with the G6a code below) — C++ resolves method
# calls by declaration order, like the G2 block above.
EGNAME = map {
    "": 0
}
EGCODE = flint_vec_new()
EGOff = flint_vec_new()
EGLen = flint_vec_new()
EGNameOff = flint_vec_new()
EGNameLen = flint_vec_new()
mut EGTEXT: str = ""
# ---- G5: named types (structs + enums share codes 100+) ----
# ENTMAP name->code; ENTKind (0 struct, 1 tag-enum, 2 payload-enum);
# ENTN fields; ENTBase flat base; flat ENFNameOff/Len (in ENTTEXT) +
# ENFCode; struct/enum body text via ENTBodyOff/Len (tag enums are i64);
# ENTSIZE alloc sizes; variant payloads via ENFNP/ENFPB + flat ENFPT.
ENTMAP = map {
    "": 0
}
ENTKind = flint_vec_new()
ENTN = flint_vec_new()
ENTBase = flint_vec_new()
ENTBodyOff = flint_vec_new()
ENTBodyLen = flint_vec_new()
ENFNameOff = flint_vec_new()
ENFNameLen = flint_vec_new()
ENFCode = flint_vec_new()
ENTNameOff = flint_vec_new()
ENTNameLen = flint_vec_new()
# ENTSIZE: alloc size per named-type code (structs laid out, enums tagged).
ENTSIZE = flint_vec_new()
# Variant payloads: ENFNP (count) + ENFPB (base) per field-slot, flat ENFPT.
ENFNP = flint_vec_new()
ENFPB = flint_vec_new()
ENFPT = flint_vec_new()
mut ENTTEXT: str = ""
mut ENTNEXT: i64 = 100
# Match coverage scratch (arm variant indices; logically cleared per match).
EMATCHCOV = flint_vec_new()
# Match phi-entry scratch: value/block texts in EMATCHTEXT located by
# flat EMATCHD quads (voff, vlen, boff, blen); logically cleared per match.
EMATCHD = flint_vec_new()
mut EMATCHTEXT: str = ""
# ---- G7e: lambdas (outline + creation-frozen caps, C++ parity) ----
# ELAMMAP name->lidx; ELAMFN name->defining-fn-id; ELAMNCAP per lidx;
# ELAMOFF/ELAMLEN locate synthesized `(fn ...)` in ELAMTEXT; ELAMN counter.
ELAMMAP = map {
    "": 0
}
ELAMFN = map {
    "": 0
}
ELAMNCAP = flint_vec_new()
ELAMOFF = flint_vec_new()
ELAMLEN = flint_vec_new()
mut ELAMTEXT: str = ""
mut ELAMN: i64 = 0
mut ELAMCUR: i64 = -1
# Current function id (monotonic per e_fn_body) + free-walk scratches.
mut EFNCUR: i64 = 0
mut EFNID: i64 = 0
mut ELAMFREE: str = ""
mut ELAMBOUND: str = ""
mut ELAMASSIGN: str = ""
# Cap name/code scratch (offsets into ESIGTEXT + parallel code vec).
ELAMCAPO = flint_vec_new()
ELAMCAPL = flint_vec_new()
ELAMCAPC = flint_vec_new()
# Scratch-set membership ("\n"-framed).
fn e_lam_mem(settext: str, name: str) -> i64 {
    key = "\n" + name + "\n"
    hk = flint_str_index_of(settext, key)
    if hk == -1 {
        0
    } else {
        1
    }
}
# Free-variable walk over [bstart, bend): collects (var X) names, bound
# names (decl/for), assign targets; skips strings; errors on nested lambda.
# Appends "\n"-framed names to ELAMFREE/ELAMBOUND/ELAMASSIGN. No output.
fn e_lam_walk(bstart: i64, bend: i64) -> i64 {
    saved = e_pos()
    flint_vec_set(EC, 0, bstart)
    n = flint_str_length(ESRC)
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_pos() >= bend {
            go = 0
        } else {
            if e_peek() == 40 {
                as = e_at_str()
                if as == 1 {
                    e_skip_str()
                } else {
                    e_adv()
                    e_skip()
                    w = e_word()
                    if w == "var" {
                        e_skip()
                        vn = e_word()
                        if e_lam_mem(ELAMFREE, vn) == 0 {
                            ELAMFREE = ELAMFREE + vn + "\n"
                        }
                        e_skip()
                        if e_peek() == 41 {
                            e_adv()
                        }
                    } else {
                        if w == "lambda" {
                            EERR = EERR + 1
                            print("emit error: lambdas cannot be passed as values")
                            e_skip_value()
                        } else {
                            if w == "decl" {
                                e_skip()
                                e_word()
                                e_skip()
                                dn = e_word()
                                if e_lam_mem(ELAMBOUND, dn) == 0 {
                                    ELAMBOUND = ELAMBOUND + dn + "\n"
                                }
                            } else {
                                if w == "assign" {
                                    e_skip()
                                    an = e_word()
                                    if e_lam_mem(ELAMASSIGN, an) == 0 {
                                        ELAMASSIGN = ELAMASSIGN + an + "\n"
                                    }
                                } else {
                                    if w == "compound-assign" {
                                        e_skip()
                                        e_word()
                                        e_skip()
                                        cn = e_word()
                                        if e_lam_mem(ELAMASSIGN, cn) == 0 {
                                            ELAMASSIGN = ELAMASSIGN + cn + "\n"
                                        }
                                    } else {
                                        if w == "for" {
                                            e_skip()
                                            fn2 = e_word()
                                            if e_lam_mem(ELAMBOUND, fn2) == 0 {
                                                ELAMBOUND = ELAMBOUND + fn2 + "\n"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                e_adv()
            }
        }
    }
    flint_vec_set(EC, 0, saved)
    1
}
# Typecode back to annotation text (for synthesized signatures).
fn e_lam_typetext(code: i64) -> str {
    if code == 1 {
        "i64"
    } else {
        if code == 2 {
            "f64"
        } else {
            if code == 3 {
                "str"
            } else {
                if code == 4 {
                    "[i64]"
                } else {
                    if code == 6 {
                        "map"
                    } else {
                        if code == 8 {
                            "ptr"
                        } else {
                            if code == 7 {
                                "-"
                            } else {
                                if code >= 100 {
                                    e_ent_name(code)
                                } else {
                                    "-"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
# Param-name hit inside synthesized params text (word-boundary check).
fn e_lam_param_hit(pstext: str, name: str) -> i64 {
    key = "(" + name + " "
    hk = flint_str_index_of(pstext, key)
    if hk == -1 {
        0
    } else {
        1
    }
}
mut EPHASE: i64 = 0
# Outline `(lambda (PARAMS) BODY)` bound to nm (cursor past `lambda`).
# Freezes captures into mid-function slots, registers + defers a synthesized
# top-level fn. Returns 1 ok, 0 error. No EMAP entry (callable-only name).
fn e_decl_lambda(nm: str) -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
    } else {
        EERR = EERR + 1
        return 0
    }
    lidx = ELAMN
    gen = "lam." + flint_i64_to_string(lidx)
    fnidx = flint_vec_len(EFNN)
    flint_vec_push(EFNN, 0)
    flint_vec_push(EFNRET, 1)
    flint_vec_push(EFNVAR, 0)
    flint_vec_push(EFNPB, flint_vec_len(EFPTYPE))
    flint_vec_push(EFNEXT, 0)
    EFNMAP.set(gen, fnidx)
    mut n: i64 = 0
    mut go: i64 = 1
    mut ok: i64 = 1
    psb = flint_sb_new()
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                e_adv()
                e_skip()
                pn = e_word()
                pt = e_word()
                mut ptc: i64 = e_ann_code(pt)
                if pt == "-" {
                    ptc = 1
                }
                if ptc == 0 {
                    EERR = EERR + 1
                    print("emit error: bad lambda param type")
                    print(pn)
                    ok = 0
                }
                e_skip()
                if e_peek() == 40 {
                    din = e_skip_balanced_fn()
                    doff = flint_str_length(ESIGTEXT)
                    ESIGTEXT = ESIGTEXT + din
                    flint_vec_push(EFPTYPE, ptc)
                    flint_vec_push(EFPOFF, doff)
                    flint_vec_push(EFPLEN, flint_str_length(din))
                    flint_sb_append(psb, "(" + pn + " " + pt + " (" + din + ")) ")
                } else {
                    dw = e_word()
                    if dw == "-" {
                        flint_vec_push(EFPTYPE, ptc)
                        flint_vec_push(EFPOFF, -1)
                        flint_vec_push(EFPLEN, 0)
                    } else {
                        doff2 = flint_str_length(ESIGTEXT)
                        ESIGTEXT = ESIGTEXT + dw
                        flint_vec_push(EFPTYPE, ptc)
                        flint_vec_push(EFPOFF, doff2)
                        flint_vec_push(EFPLEN, flint_str_length(dw))
                    }
                    flint_sb_append(psb, "(" + pn + " " + pt + " " + dw + ") ")
                }
                noff = flint_str_length(ESIGTEXT)
                ESIGTEXT = ESIGTEXT + pn
                flint_vec_push(EFPNOff, noff)
                flint_vec_push(EFPNLen, flint_str_length(pn))
                e_skip()
                if e_peek() == 41 {
                    e_adv()
                } else {
                    EERR = EERR + 1
                    ok = 0
                }
                n = n + 1
            } else {
                EERR = EERR + 1
                ok = 0
                go = 0
            }
        }
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        ok = 0
    }
    flint_vec_set(EFNN, fnidx, n)
    if ok == 0 {
        flint_sb_free(psb)
        return 0
    }
    pstext = flint_sb_build(psb)
    flint_sb_free(psb)
    e_skip()
    bstart = e_pos()
    e_skip_value()
    bend = e_pos()
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        return 0
    }
    ELAMFREE = "\n"
    ELAMBOUND = "\n"
    ELAMASSIGN = "\n"
    e_lam_walk(bstart, bend)
    if EERR > 0 {
        return 0
    }
    capbase = flint_vec_len(ELAMCAPC)
    mut ncap: i64 = 0
    mut si: i64 = 1
    fl = flint_str_length(ELAMFREE)
    mut cok: i64 = 1
    while si < fl {
        rest = flint_str_substring(ELAMFREE, si, fl)
        k = flint_str_index_of(rest, "\n")
        if k == -1 {
            si = fl
        } else {
            rnm = flint_str_substring(ELAMFREE, si, si + k)
            if e_lam_param_hit(pstext, rnm) == 0 {
                if rnm != nm {
                    if EGNAME.has(rnm) == 0 {
                        if e_lam_mem(ELAMBOUND, rnm) == 0 {
                            if ETYPEMAP.has(rnm) == 1 {
                                rcode = ETYPEMAP.get(rnm)
                                rnoff = flint_str_length(ESIGTEXT)
                                ESIGTEXT = ESIGTEXT + rnm
                                flint_vec_push(ELAMCAPO, rnoff)
                                flint_vec_push(ELAMCAPL, flint_str_length(rnm))
                                flint_vec_push(ELAMCAPC, rcode)
                                ncap = ncap + 1
                            } else {
                                EERR = EERR + 1
                                print("emit error: lambda cannot capture unknown")
                                print(rnm)
                                cok = 0
                            }
                        }
                    }
                }
            }
            si = si + k + 1
        }
    }
    if cok == 0 {
        return 0
    }
    mut ci: i64 = 0
    while ci < ncap {
        cn2 = flint_str_substring(ESIGTEXT, flint_vec_get(ELAMCAPO, capbase + ci), flint_vec_get(ELAMCAPO, capbase + ci) + flint_vec_get(ELAMCAPL, capbase + ci))
        if e_lam_mem(ELAMASSIGN, cn2) == 1 {
            EERR = EERR + 1
            print("emit error: lambda cannot assign to captured")
            print(cn2)
            return 0
        }
        ci = ci + 1
    }
    mut cj: i64 = 0
    while cj < ncap {
        foff = flint_vec_get(ELAMCAPO, capbase + cj)
        fln = flint_vec_get(ELAMCAPL, capbase + cj)
        fcode = flint_vec_get(ELAMCAPC, capbase + cj)
        fval = e_var_rd(flint_str_substring(ESIGTEXT, foff, foff + fln))
        slot = "%lamcap." + flint_i64_to_string(lidx) + "." + flint_i64_to_string(cj)
        e_emit("  " + slot + " = alloca " + e_llvm_typecode(fcode) + "\n")
        e_emit("  store " + e_llvm_typecode(fcode) + " " + fval + ", ptr " + slot + "\n")
        flint_vec_push(EFPTYPE, fcode)
        flint_vec_push(EFPOFF, -1)
        flint_vec_push(EFPLEN, 0)
        fnoff = flint_str_length(ESIGTEXT)
        ESIGTEXT = ESIGTEXT + flint_str_substring(ESIGTEXT, foff, foff + fln)
        flint_vec_push(EFPNOff, fnoff)
        flint_vec_push(EFPNLen, fln)
        cj = cj + 1
    }
    flint_vec_set(EFNN, fnidx, n + ncap)
    csb = flint_sb_new()
    mut qk: i64 = 0
    while qk < ncap {
        qoff = flint_vec_get(ELAMCAPO, capbase + qk)
        qln = flint_vec_get(ELAMCAPL, capbase + qk)
        qcode = flint_vec_get(ELAMCAPC, capbase + qk)
        qnm = flint_str_substring(ESIGTEXT, qoff, qoff + qln)
        flint_sb_append(csb, "(" + qnm + " " + e_lam_typetext(qcode) + " -) ")
        qk = qk + 1
    }
    captext = flint_sb_build(csb)
    flint_sb_free(csb)
    btxt = flint_str_substring(ESRC, bstart, bend)
    mut bwrap: str = "(block (expr " + btxt + "))"
    bhead = flint_str_substring(btxt, 0, 6)
    if bhead == "(block" {
        bwrap = btxt
    }
    sbs = flint_sb_new()
    flint_sb_append(sbs, "(fn " + gen + " (tparams) (" + pstext + captext + ") i64 ")
    flint_sb_append(sbs, bwrap)
    flint_sb_append(sbs, ")")
    ftxt = flint_sb_build(sbs)
    flint_sb_free(sbs)
    foff = flint_str_length(ELAMTEXT)
    ELAMTEXT = ELAMTEXT + ftxt
    flint_vec_push(ELAMOFF, foff)
    flint_vec_push(ELAMLEN, flint_str_length(ftxt))
    flint_vec_push(ELAMNCAP, ncap)
    ELAMMAP.set(nm, lidx)
    ELAMFN.set(nm, EFNCUR)
    ELAMN = ELAMN + 1
    1
}
# Call a lambda-bound name (same function only; caps reload from slots).
# Parses args up to `)`; the closing paren belongs to the caller.
fn e_lambda_call(name: str) -> str {
    lidx = ELAMMAP.get(name)
    dfn = ELAMFN.get(name)
    cur = EFNCUR
    alm = ELAMCUR
    mut samefn: i64 = 0
    if dfn == cur {
        samefn = 1
    } else {
        if lidx == alm {
            samefn = 1
        }
    }
    if samefn == 0 {
        EERR = EERR + 1
        print("emit error: lambda cannot leave its function")
        print(name)
        return ""
    }
    gen = "lam." + flint_i64_to_string(lidx)
    fidx = e_sig_lookup(gen)
    n = flint_vec_get(EFNN, fidx)
    base = flint_vec_get(EFNPB, fidx)
    ncap = flint_vec_get(ELAMNCAP, lidx)
    nuser = n - ncap
    sb = flint_sb_new()
    mut ne: i64 = 0
    mut ok: i64 = 1
    mut ui: i64 = 0
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if ui < nuser {
                if ne > 0 {
                    flint_sb_append(sb, ", ")
                }
                a = e_expr()
                ac = ETYPE
                want = flint_vec_get(EFPTYPE, base + ui)
                esv = EERR
                cv = e_conv(a, ac, want)
                er2 = EERR
                if er2 == esv {
                    flint_sb_append(sb, e_llvm_typecode(want) + " " + cv)
                    ne = ne + 1
                } else {
                    print("emit error: lambda arg mismatch calling")
                    print(name)
                    ok = 0
                }
            } else {
                e_skip_value()
                EERR = EERR + 1
                print("emit error: too many args calling lambda")
                print(name)
                ok = 0
            }
            ui = ui + 1
        }
    }
    while ui < nuser {
        if ne > 0 {
            flint_sb_append(sb, ", ")
        }
        want2 = flint_vec_get(EFPTYPE, base + ui)
        off = flint_vec_get(EFPOFF, base + ui)
        if off == -1 {
            EERR = EERR + 1
            print("emit error: missing arg, no default calling lambda")
            print(name)
            ok = 0
            ui = nuser
        } else {
            ln = flint_vec_get(EFPLEN, base + ui)
            d = e_eval_default(off, ln)
            dc = ETYPE
            esv2 = EERR
            dv = e_conv(d, dc, want2)
            er3 = EERR
            if er3 == esv2 {
                flint_sb_append(sb, e_llvm_typecode(want2) + " " + dv)
                ne = ne + 1
            } else {
                print("emit error: default type mismatch calling lambda")
                print(name)
                ok = 0
            }
            ui = ui + 1
        }
    }
    mut ci: i64 = 0
    while ci < ncap {
        if ne > 0 {
            flint_sb_append(sb, ", ")
        }
        wtc = flint_vec_get(EFPTYPE, base + nuser + ci)
        slot = "%lamcap." + flint_i64_to_string(lidx) + "." + flint_i64_to_string(ci)
        lv = e_fresh()
        e_emit("  " + lv + " = load " + e_llvm_typecode(wtc) + ", ptr " + slot + "\n")
        flint_sb_append(sb, e_llvm_typecode(wtc) + " " + lv)
        ne = ne + 1
        ci = ci + 1
    }
    argstr = flint_sb_build(sb)
    flint_sb_free(sb)
    if ok == 0 {
        ETYPE = 0
        ""
    } else {
        lret = flint_vec_get(EFNRET, fidx)
        t3 = e_fresh()
        e_emit("  " + t3 + " = call " + e_llvm_typecode(lret) + " @" + gen + "(" + argstr + ")\n")
        ETYPE = lret
        t3
    }
}
# Drain deferred outlined lambdas (end of e_prog): replay each synthesized
# `(fn ...)` through e_form. Growth-safe (nested outlines append more).
fn e_drain_lambdas() -> i64 {
    mut li: i64 = 0
    while li < ELAMN {
        off = flint_vec_get(ELAMOFF, li)
        ln = flint_vec_get(ELAMLEN, li)
        saved = ESRC
        savedp = e_pos()
        oldcur = EFNCUR
        oldlam = ELAMCUR
        ELAMCUR = li
        ESRC = flint_str_substring(ELAMTEXT, off, off + ln)
        flint_vec_set(EC, 0, 0)
        e_form()
        ESRC = saved
        flint_vec_set(EC, 0, savedp)
        EFNCUR = oldcur
        ELAMCUR = oldlam
        li = li + 1
    }
    1
}
# (G6a registry block moved up before first use; stub left here.)
mut EMAINDONE: i64 = 0
# (G2 + G6a registry globals moved up before first use; see notes above.)
# Current function being emitted (for return codegen).
mut EFNRET_CUR: i64 = 1
mut EFNMAIN: i64 = 0
# Last bare expression statement value (implicit fn return).
mut EBLOCKEXPR: i64 = 0
mut EBLOCKVAL: str = ""
mut EBLOCKCODE: i64 = 0
# ---- S-expr reader (length-aware strings, mirrors pp reader) ----
fn e_pos() -> i64 {
    flint_vec_get(EC, 0)
}
fn e_at_end() -> i64 {
    if e_pos() < flint_str_length(ESRC) {
        0
    } else {
        1
    }
}
fn e_peek() -> i64 {
    if e_at_end() == 1 {
        -1
    } else {
        flint_str_char_at(ESRC, e_pos())
    }
}
fn e_adv() -> i64 {
    c = e_peek()
    flint_vec_set(EC, 0, e_pos() + 1)
    c
}
fn e_skip() -> i64 {
    # Bulk whitespace skip: one C scan replaces the per-character
    # peek/advance round trips (P1.1: reader hot loop).
    flint_vec_set(EC, 0, flint_str_skip_ws(ESRC, flint_vec_get(EC, 0)))
    0
}
# Raw word (to whitespace/paren). Skips leading whitespace.
fn e_word() -> str {
    # Bulk word read: one C scan + one substring replaces the per-character
    # builder round trips (P1.1: reader hot loop). Stops at space, newline,
    # parens (NOT tab/CR, matching the old loop), or end of input.
    e_skip()
    s0 = flint_vec_get(EC, 0)
    e1 = flint_str_word_end(ESRC, s0)
    r = flint_str_substring(ESRC, s0, e1)
    flint_vec_set(EC, 0, e1)
    r
}
fn e_expect(c: i64) -> i64 {
    e_skip()
    if e_peek() == c {
        e_adv()
        1
    } else {
        EERR = EERR + 1
        0
    }
}
fn e_emit(s: str) -> i64 {
    flint_sb_append(EOUT, s)
    0
}
fn e_emit_glob(s: str) -> i64 {
    flint_sb_append(EGLOB, s)
    0
}
fn e_fresh() -> str {
    ETMP = ETMP + 1
    "%t" + flint_i64_to_string(ETMP)
}
fn e_strname() -> str {
    n = "@.s" + flint_i64_to_string(ESTR)
    ESTR = ESTR + 1
    n
}
fn e_label(pre: str) -> str {
    ELBL = ELBL + 1
    pre + flint_i64_to_string(ELBL)
}
# LLVM-escape a raw string inner for c"..." (from LangRef research: only
# `\\` and `\XX` escapes; `"` MUST be `\22`, never `\"`).
# Hex digit value, or -1. Mirrors C++ hexVal (string \xXX \uXXXX).
fn e_hex_val(c: i64) -> i64 {
    if c == 48 {
        0
    } else {
        if c == 49 {
            1
        } else {
            if c == 50 {
                2
            } else {
                if c == 51 {
                    3
                } else {
                    if c == 52 {
                        4
                    } else {
                        if c == 53 {
                            5
                        } else {
                            if c == 54 {
                                6
                            } else {
                                if c == 55 {
                                    7
                                } else {
                                    if c == 56 {
                                        8
                                    } else {
                                        if c == 57 {
                                            9
                                        } else {
                                            if c == 65 {
                                                10
                                            } else {
                                                if c == 66 {
                                                    11
                                                } else {
                                                    if c == 67 {
                                                        12
                                                    } else {
                                                        if c == 68 {
                                                            13
                                                        } else {
                                                            if c == 69 {
                                                                14
                                                            } else {
                                                                if c == 70 {
                                                                    15
                                                                } else {
                                                                    if c == 97 {
                                                                        10
                                                                    } else {
                                                                        if c == 98 {
                                                                            11
                                                                        } else {
                                                                            if c == 99 {
                                                                                12
                                                                            } else {
                                                                                if c == 100 {
                                                                                    13
                                                                                } else {
                                                                                    if c == 101 {
                                                                                        14
                                                                                    } else {
                                                                                        if c == 102 {
                                                                                            15
                                                                                        } else {
                                                                                            -1
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
# C-like unescape of raw S-expr string text (stage1 keeps escapes raw;
# C++ unescapes at lex). Supports \n \t \r \\ \" \xXX \uXXXX (BMP->UTF8);
# unknown escapes stay literal backslash+char (mirrors C++ P1-9).
fn e_unescape(raw: str) -> str {
    sb = flint_sb_new()
    n = flint_str_length(raw)
    mut i: i64 = 0
    while i < n {
        i = e_unescape_step(sb, raw, i, n)
    }
    r = flint_sb_build(sb)
    flint_sb_free(sb)
    r
}
# One unescape step at pos (appends to sb): `{`{{`{` `}}` C-escapes
# \xXX \uXXXX (BMP->UTF8); unknown stays literal. Returns next pos.
fn e_unescape_step(sb: i64, raw: str, pos: i64, n: i64) -> i64 {
    c = flint_str_char_at(raw, pos)
    if c == 123 {
        if pos + 1 < n {
            nx = flint_str_char_at(raw, pos + 1)
            if nx == 123 {
                flint_sb_append_char(sb, 123)
                pos + 2
            } else {
                flint_sb_append_char(sb, c)
                pos + 1
            }
        } else {
            flint_sb_append_char(sb, c)
            pos + 1
        }
    } else {
        if c == 125 {
            if pos + 1 < n {
                nx2 = flint_str_char_at(raw, pos + 1)
                if nx2 == 125 {
                    flint_sb_append_char(sb, 125)
                    pos + 2
                } else {
                    flint_sb_append_char(sb, c)
                    pos + 1
                }
            } else {
                flint_sb_append_char(sb, c)
                pos + 1
            }
        } else {
            if c == 92 {
                e_unescape_back(sb, raw, pos, n)
            } else {
                flint_sb_append_char(sb, c)
                pos + 1
            }
        }
    }
}
# Backslash escape at pos (raw[pos] == 92). Returns next pos.
fn e_unescape_back(sb: i64, raw: str, pos: i64, n: i64) -> i64 {
    if pos + 1 < n {
        e2 = flint_str_char_at(raw, pos + 1)
        if e2 == 110 {
            flint_sb_append_char(sb, 10)
            pos + 2
        } else {
            if e2 == 116 {
                flint_sb_append_char(sb, 9)
                pos + 2
            } else {
                if e2 == 114 {
                    flint_sb_append_char(sb, 13)
                    pos + 2
                } else {
                    if e2 == 92 {
                        flint_sb_append_char(sb, 92)
                        pos + 2
                    } else {
                        if e2 == 34 {
                            flint_sb_append_char(sb, 34)
                            pos + 2
                        } else {
                            if e2 == 120 {
                                ux = e_unescape_hex(raw, pos + 2, n)
                                if ux == -1 {
                                    flint_sb_append_char(sb, 92)
                                    flint_sb_append_char(sb, e2)
                                    pos + 2
                                } else {
                                    flint_sb_append_char(sb, ux)
                                    pos + 4
                                }
                            } else {
                                if e2 == 117 {
                                    uu = e_unescape_uni(raw, pos + 2, n)
                                    if uu == -1 {
                                        flint_sb_append_char(sb, 92)
                                        flint_sb_append_char(sb, e2)
                                        pos + 2
                                    } else {
                                        e_unescape_emit_utf8(sb, uu)
                                        pos + 6
                                    }
                                } else {
                                    flint_sb_append_char(sb, 92)
                                    flint_sb_append_char(sb, e2)
                                    pos + 2
                                }
                            }
                        }
                    }
                }
            }
        }
    } else {
        flint_sb_append_char(sb, 92)
        pos + 1
    }
}
# Two hex digits at pos -> byte value, or -1 if invalid/short.
fn e_unescape_hex(raw: str, pos: i64, n: i64) -> i64 {
    if pos + 1 < n {
        h0 = e_hex_val(flint_str_char_at(raw, pos))
        h1 = e_hex_val(flint_str_char_at(raw, pos + 1))
        if h0 == -1 {
            -1
        } else {
            if h1 == -1 {
                -1
            } else {
                h0 * 16 + h1
            }
        }
    } else {
        -1
    }
}
# Four hex digits at pos -> code point, or -1 if invalid/short.
fn e_unescape_uni(raw: str, pos: i64, n: i64) -> i64 {
    if pos + 3 < n {
        d0 = e_hex_val(flint_str_char_at(raw, pos))
        d1 = e_hex_val(flint_str_char_at(raw, pos + 1))
        d2 = e_hex_val(flint_str_char_at(raw, pos + 2))
        d3 = e_hex_val(flint_str_char_at(raw, pos + 3))
        if d0 == -1 {
            -1
        } else {
            if d1 == -1 {
                -1
            } else {
                if d2 == -1 {
                    -1
                } else {
                    if d3 == -1 {
                        -1
                    } else {
                        d0 * 4096 + d1 * 256 + d2 * 16 + d3
                    }
                }
            }
        }
    } else {
        -1
    }
}
# Append BMP code point as UTF-8 bytes (mirrors C++ appendUtf8).
fn e_unescape_emit_utf8(sb: i64, cp: i64) -> i64 {
    if cp < 128 {
        flint_sb_append_char(sb, cp)
    } else {
        if cp < 2048 {
            flint_sb_append_char(sb, 192 + cp / 64)
            flint_sb_append_char(sb, 128 + cp % 64)
        } else {
            flint_sb_append_char(sb, 224 + cp / 4096)
            flint_sb_append_char(sb, 128 + cp / 64 % 64)
            flint_sb_append_char(sb, 128 + cp % 64)
        }
    }
    0
}
fn e_llvm_str(raw: str) -> str {
    sb = flint_sb_new()
    n = flint_str_length(raw)
    mut i: i64 = 0
    while i < n {
        c = flint_str_char_at(raw, i)
        if c == 92 {
            flint_sb_append(sb, "\\\\")
        } else {
            if c == 34 {
                flint_sb_append(sb, "\\22")
            } else {
                if c == 10 {
                    flint_sb_append(sb, "\\0A")
                } else {
                    if c == 13 {
                        flint_sb_append(sb, "\\0D")
                    } else {
                        if c == 9 {
                            flint_sb_append(sb, "\\09")
                        } else {
                            flint_sb_append_char(sb, c)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    r = flint_sb_build(sb)
    flint_sb_free(sb)
    r
}
# (str LEN RAW) with cursor after `(str `: returns RAW, leaves `)` for caller.
fn e_read_str() -> str {
    e_skip()
    ln = e_read_num_raw()
    n = flint_str_to_i64(ln)
    if e_peek() == 32 {
        e_adv()
    } else {
        EERR = EERR + 1
        return ""
    }
    st = e_pos()
    mut i: i64 = 0
    while i < n {
        e_adv()
        i = i + 1
    }
    flint_str_substring(ESRC, st, st + n)
}
# Raw decimal digits (for counts).
fn e_read_num_raw() -> str {
    sb = flint_sb_new()
    mut go: i64 = 1
    while go == 1 {
        c = e_peek()
        if c >= 48 {
            if c <= 57 {
                flint_sb_append_char(sb, c)
                e_adv()
            } else {
                go = 0
            }
        } else {
            go = 0
        }
    }
    r = flint_sb_build(sb)
    flint_sb_free(sb)
    r
}
# ---- expression emitter (returns LLVM value text, sets ETYPE) ----
# Type codes: 1 i64, 2 f64, 3 str/ptr, 0 void/unknown.
fn e_llvm_type(ty: str) -> str {
    if ty == "i64" {
        "i64"
    } else {
        if ty == "f64" {
            "double"
        } else {
            if ty == "str" {
                "ptr"
            } else {
                if ty == "bool" {
                    "i1"
                } else {
                    "i64"
                }
            }
        }
    }
}
# (num RAW[d]) -> inline constant. Sets ETYPE (2 if float else 1).
fn e_num() -> str {
    raw = e_word()
    mut v: str = raw
    mut float: i64 = 0
    if flint_str_length(raw) == 0 {
        v = v
    } else {
        if flint_str_char_at(raw, flint_str_length(raw) - 1) == 100 {
            v = flint_str_substring(raw, 0, flint_str_length(raw) - 1)
            float = 1
        }
    }
    if float == 1 {
        ETYPE = 2
        v
    } else {
        ETYPE = 1
        v
    }
}
# String literal: emit global, return its name. Sets ETYPE=3.
fn e_str_lit() -> str {
    e_skip()
    ln = e_read_num_raw()
    n = flint_str_to_i64(ln)
    if e_peek() == 32 {
        e_adv()
    } else {
        EERR = EERR + 1
        return ""
    }
    st = e_pos()
    mut i: i64 = 0
    while i < n {
        e_adv()
        i = i + 1
    }
    raw = flint_str_substring(ESRC, st, st + n)
    un = e_unescape(raw)
    unlen = flint_str_length(un)
    esc = e_llvm_str(un)
    tot = unlen + 1
    nm = e_strname()
    flint_sb_append(EGLOB, nm + " = private unnamed_addr constant [" + flint_i64_to_string(tot) + " x i8] c\"" + esc + "\\00\"\n")
    ETYPE = 3
    nm
}
# String-aware skip of one S-expr form or token (for pre-count passes;
# plain e_skip_balanced desyncs on parens inside string literals).
fn e_skip_value() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        w = e_word()
        if w == "str" {
            e_skip()
            ln = e_read_num_raw()
            n = flint_str_to_i64(ln)
            if e_peek() == 32 {
                e_adv()
            } else {
                EERR = EERR + 1
                return 0
            }
            mut k: i64 = 0
            while k < n {
                e_adv()
                k = k + 1
            }
            e_skip()
            if e_peek() == 41 {
                e_adv()
            } else {
                EERR = EERR + 1
                0
            }
        } else {
            mut go: i64 = 1
            while go == 1 {
                e_skip()
                pk = e_peek()
                if pk == 41 {
                    e_adv()
                    go = 0
                } else {
                    if pk == -1 {
                        EERR = EERR + 1
                        return 0
                    } else {
                        if pk == 40 {
                            e_skip_value()
                        } else {
                            e_word()
                        }
                    }
                }
            }
            1
        }
    } else {
        if e_peek() == -1 {
            0
        } else {
            e_adv()
            1
        }
    }
}
# (array E*): i64-only array literal -> {ptr,i64} struct value (typecode 4).
# Two passes: count (string-aware skip), then emit+store via rewind.
fn e_array() -> str {
    estart = e_pos()
    # Spread pre-scan: any `(spread E)` element forces the dynamic path.
    # Consumes forward, then rewinds (real passes below re-walk).
    mut has_spread: i64 = 0
    mut gs: i64 = 1
    while gs == 1 {
        e_skip()
        if e_peek() == 41 {
            gs = 0
        } else {
            if e_peek() == -1 {
                EERR = EERR + 1
                return ""
            } else {
                if e_peek() == 40 {
                    e_adv()
                    e_skip()
                    w = e_word()
                    if w == "spread" {
                        has_spread = 1
                    }
                    e_skip_rest()
                } else {
                    e_word()
                }
            }
        }
    }
    flint_vec_set(EC, 0, estart)
    if has_spread == 1 {
        e_array_dynamic()
    } else {
        mut n: i64 = 0
        mut go: i64 = 1
        while go == 1 {
            e_skip()
            pk = e_peek()
            if pk == 41 {
                go = 0
            } else {
                if pk == -1 {
                    EERR = EERR + 1
                    return ""
                } else {
                    e_skip_value()
                    n = n + 1
                }
            }
        }
        ns = flint_i64_to_string(n)
        arr = e_fresh()
        e_emit("  " + arr + " = alloca [" + ns + " x i64]\n")
        flint_vec_set(EC, 0, estart)
        mut i: i64 = 0
        mut ok: i64 = 1
        mut go2: i64 = 1
        while go2 == 1 {
            e_skip()
            pk2 = e_peek()
            if pk2 == 41 {
                go2 = 0
            } else {
                v = e_expr()
                vc = ETYPE
                if vc == 1 {
                    ep = e_fresh()
                    e_emit("  " + ep + " = getelementptr [" + ns + " x i64], ptr " + arr + ", i64 0, i64 " + flint_i64_to_string(i) + "\n")
                    e_emit("  store i64 " + v + ", ptr " + ep + "\n")
                } else {
                    EERR = EERR + 1
                    print("emit error: only i64 arrays in G3")
                    ok = 0
                }
                i = i + 1
            }
        }
        if ok == 0 {
            ETYPE = 0
            ""
        } else {
            dp = e_fresh()
            e_emit("  " + dp + " = getelementptr [" + ns + " x i64], ptr " + arr + ", i64 0, i64 0\n")
            s0 = e_fresh()
            e_emit("  " + s0 + " = insertvalue {{ptr, i64}} undef, ptr " + dp + ", 0\n")
            s1 = e_fresh()
            e_emit("  " + s1 + " = insertvalue {{ptr, i64}} " + s0 + ", i64 " + ns + ", 1\n")
            ETYPE = 4
            s1
        }
    }
}
# Dynamic array literal (has spread): fold chunks with flint_array_concat.
# Cursor at first element (after pre-scan rewind).
fn e_array_dynamic() -> str {
    e_rt_declare("flint_array_concat", e_rt_sig("flint_array_concat"))
    mut cur: str = "zeroinitializer"
    mut ok: i64 = 1
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                elstart = e_pos()
                e_adv()
                e_skip()
                w = e_word()
                mut chunk: str = ""
                if w == "spread" {
                    se = e_expr()
                    sc = ETYPE
                    e_skip()
                    if e_peek() == 41 {
                        e_adv()
                    } else {
                        EERR = EERR + 1
                        ok = 0
                    }
                    if sc == 4 {
                        chunk = se
                    } else {
                        EERR = EERR + 1
                        print("emit error: spread needs an array")
                        ok = 0
                    }
                } else {
                    flint_vec_set(EC, 0, elstart)
                    ev = e_expr()
                    ec = ETYPE
                    if ec == 1 {
                        wa = e_fresh()
                        e_emit("  " + wa + " = alloca [1 x i64]\n")
                        we = e_fresh()
                        e_emit("  " + we + " = getelementptr [1 x i64], ptr " + wa + ", i64 0, i64 0\n")
                        e_emit("  store i64 " + ev + ", ptr " + we + "\n")
                        ws0 = e_fresh()
                        e_emit("  " + ws0 + " = insertvalue {{ptr, i64}} undef, ptr " + we + ", 0\n")
                        ws1 = e_fresh()
                        e_emit("  " + ws1 + " = insertvalue {{ptr, i64}} " + ws0 + ", i64 1, 1\n")
                        chunk = ws1
                    } else {
                        EERR = EERR + 1
                        print("emit error: only i64 arrays in G7")
                        ok = 0
                    }
                }
                if ok == 1 {
                    nv = e_fresh()
                    e_emit("  " + nv + " = call {{ptr, i64}} @flint_array_concat({{ptr, i64}} " + cur + ", {{ptr, i64}} " + chunk + ")\n")
                    cur = nv
                }
            } else {
                EERR = EERR + 1
                ok = 0
                go = 0
            }
        }
    }
    if ok == 0 {
        ETYPE = 0
        ""
    } else {
        ETYPE = 4
        cur
    }
}
# (index A I): array -> i64 element; str -> i64 byte. Bounds-checked.
# Inline bounds fast path (R1): icmp ult + br; the cold block reuses
# flint_bounds_check so the panic message is byte-identical. ECUR moves to
# the ok block so later PHI predecessors stay honest. `ult` covers
# negative indices (they wrap huge unsigned).
fn e_bounds_inline(iv: str, lnv: str) -> i64 {
    cv = e_fresh()
    e_emit("  " + cv + " = icmp ult i64 " + iv + ", " + lnv + "\n")
    okb = e_label("bounds_ok.")
    pnb = e_label("bounds_panic.")
    e_emit("  br i1 " + cv + ", label %" + okb + ", label %" + pnb + "\n")
    e_emit(pnb + ":\n")
    ECUR = pnb
    e_emit("  call void @flint_bounds_check(i64 " + iv + ", i64 " + lnv + ")\n")
    e_emit("  br label %" + okb + "\n")
    e_emit(okb + ":\n")
    ECUR = okb
    1
}
fn e_index() -> str {
    a = e_expr()
    ac = ETYPE
    i = e_expr()
    ic = ETYPE
    if ic != 1 {
        EERR = EERR + 1
        print("emit error: index needs i64")
        return ""
    }
    if ac == 4 {
        dp = e_fresh()
        e_emit("  " + dp + " = extractvalue {{ptr, i64}} " + a + ", 0\n")
        ln = e_fresh()
        e_emit("  " + ln + " = extractvalue {{ptr, i64}} " + a + ", 1\n")
        e_bounds_inline(i, ln)
        ep = e_fresh()
        e_emit("  " + ep + " = getelementptr i64, ptr " + dp + ", i64 " + i + "\n")
        t = e_fresh()
        e_emit("  " + t + " = load i64, ptr " + ep + "\n")
        ETYPE = 1
        t
    } else {
        if ac == 3 {
            ln2 = e_fresh()
            e_emit("  " + ln2 + " = call i64 @flint_str_length(ptr " + a + ")\n")
            e_bounds_inline(i, ln2)
            ep2 = e_fresh()
            e_emit("  " + ep2 + " = getelementptr i8, ptr " + a + ", i64 " + i + "\n")
            b = e_fresh()
            e_emit("  " + b + " = load i8, ptr " + ep2 + "\n")
            t2 = e_fresh()
            e_emit("  " + t2 + " = zext i8 " + b + " to i64\n")
            ETYPE = 1
            t2
        } else {
            EERR = EERR + 1
            print("emit error: index needs array or str")
            ""
        }
    }
}
# (idx-set A I V): array element store (strings immutable). Yields void.
fn e_idx_set() -> str {
    a = e_expr()
    ac = ETYPE
    i = e_expr()
    ic = ETYPE
    v = e_expr()
    vc = ETYPE
    if ac != 4 {
        EERR = EERR + 1
        print("emit error: idx-set needs array (strings are immutable)")
        return ""
    }
    if ic != 1 {
        EERR = EERR + 1
        print("emit error: idx-set needs i64 index")
        return ""
    }
    if vc != 1 {
        EERR = EERR + 1
        print("emit error: idx-set needs i64 value in G3")
        return ""
    }
    dp = e_fresh()
    e_emit("  " + dp + " = extractvalue {{ptr, i64}} " + a + ", 0\n")
    ln = e_fresh()
    e_emit("  " + ln + " = extractvalue {{ptr, i64}} " + a + ", 1\n")
    e_bounds_inline(i, ln)
    ep = e_fresh()
    e_emit("  " + ep + " = getelementptr i64, ptr " + dp + ", i64 " + i + "\n")
    e_emit("  store i64 " + v + ", ptr " + ep + "\n")
    ETYPE = 0
    ""
}
# Current alloca name for a local (versioned).
fn e_var_addr(nm: str) -> str {
    mut ver: i64 = 0
    if EVERSION.has(nm) == 1 {
        ver = EVERSION.get(nm)
    }
    if ver == 0 {
        "%" + nm + ".addr"
    } else {
        "%" + nm + ".addr.v" + flint_i64_to_string(ver)
    }
}
# Declare (or redeclare) a local: fresh versioned alloca + store, maps set.
# Returns the alloca name. Callers pass the already-checked typecode.
fn e_declare_var(nm: str, code: i64, val: str) -> str {
    # Store only: the pre-pass bumped versions and emitted every alloca
    # at function entry (dominance for self-hosting).
    an = e_var_addr(nm)
    e_emit("  store " + e_llvm_typecode(code) + " " + val + ", ptr " + an + "\n")
    EMAP.set(nm, ESCOPE)
    ETYPEMAP.set(nm, code)
    an
}
# Convert value text from one typecode to another (emits + returns new
# text, or "" with EERR). Exact, i64<->f64, i64<->ptr-family, ptr-family
# interop (all LLVM ptr); everything else is an error.
fn e_conv(val: str, from: i64, want: i64) -> str {
    if from == want {
        val
    } else {
        if from == 1 {
            if want == 2 {
                t = e_fresh()
                e_emit("  " + t + " = sitofp i64 " + val + " to double\n")
                t
            } else {
                if want == 3 {
                    t2 = e_fresh()
                    e_emit("  " + t2 + " = inttoptr i64 " + val + " to ptr\n")
                    t2
                } else {
                    if want == 6 {
                        t3 = e_fresh()
                        e_emit("  " + t3 + " = inttoptr i64 " + val + " to ptr\n")
                        t3
                    } else {
                        if want == 7 {
                            t4 = e_fresh()
                            e_emit("  " + t4 + " = inttoptr i64 " + val + " to ptr\n")
                            t4
                        } else {
                            EERR = EERR + 1
                            print("emit error: bad int conversion")
                            ""
                        }
                    }
                }
            }
        } else {
            if want == 1 {
                if from == 3 {
                    u = e_fresh()
                    e_emit("  " + u + " = ptrtoint ptr " + val + " to i64\n")
                    u
                } else {
                    if from == 6 {
                        u2 = e_fresh()
                        e_emit("  " + u2 + " = ptrtoint ptr " + val + " to i64\n")
                        u2
                    } else {
                        if from == 7 {
                            u3 = e_fresh()
                            e_emit("  " + u3 + " = ptrtoint ptr " + val + " to i64\n")
                            u3
                        } else {
                            EERR = EERR + 1
                            print("emit error: bad to-int conversion")
                            ""
                        }
                    }
                }
            } else {
                if from == 3 {
                    if want == 6 {
                        val
                    } else {
                        if want == 7 {
                            val
                        } else {
                            EERR = EERR + 1
                            print("emit error: bad str conversion")
                            ""
                        }
                    }
                } else {
                    if from == 6 {
                        if want == 3 {
                            val
                        } else {
                            if want == 7 {
                                val
                            } else {
                                EERR = EERR + 1
                                print("emit error: bad map conversion")
                                ""
                            }
                        }
                    } else {
                        if from == 7 {
                            if want == 3 {
                                val
                            } else {
                                if want == 6 {
                                    val
                                } else {
                                    EERR = EERR + 1
                                    print("emit error: bad handle conversion")
                                    ""
                                }
                            }
                        } else {
                            EERR = EERR + 1
                            print("emit error: bad conversion")
                            ""
                        }
                    }
                }
            }
        }
    }
}
# Variable read: load from deterministic alloca. Sets ETYPE from table.
# (struct-lit NAME ((F EXPR)*)): build struct value via insertvalue chain.
# Fields may appear in any order; all required, no duplicates.
fn e_struct_lit() -> str {
    e_skip()
    nm = e_word()
    code = e_ent_lookup(nm)
    if code == -1 {
        EERR = EERR + 1
        print("emit error: unknown struct")
        print(nm)
        return ""
    }
    kk = flint_vec_get(ENTKind, code - 100)
    if kk != 0 {
        EERR = EERR + 1
        print("emit error: not a struct")
        print(nm)
        return ""
    }
    n = flint_vec_get(ENTN, code - 100)
    base = flint_vec_get(ENTBase, code - 100)
    body = e_llvm_typecode(code)
    exs = e_expect(40)
    if exs == 0 {
        return ""
    }
    mut cur: str = "undef"
    mut matched: i64 = 0
    mut ok: i64 = 1
    cov0 = flint_vec_len(EMATCHCOV)
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                e_adv()
                e_skip()
                fn2 = e_word()
                fx = e_ent_field(code, fn2)
                if fx == -1 {
                    EERR = EERR + 1
                    print("emit error: unknown field")
                    print(fn2)
                    ok = 0
                } else {
                    dup = e_cov_has(cov0, fx)
                    if dup == 1 {
                        EERR = EERR + 1
                        print("emit error: duplicate field")
                        print(fn2)
                        ok = 0
                    } else {
                        flint_vec_push(EMATCHCOV, fx)
                    }
                }
                fv = e_expr()
                fc = ETYPE
                if fx == -1 {
                    ok = 0
                } else {
                    w1 = flint_vec_get(ENFCode, base + fx)
                    if fc == w1 {
                        nv = e_fresh()
                        e_emit("  " + nv + " = insertvalue " + body + " " + cur + ", " + e_llvm_typecode(w1) + " " + fv + ", " + flint_i64_to_string(fx) + "\n")
                        cur = nv
                        matched = matched + 1
                    } else {
                        if fc == 1 {
                            if w1 == 2 {
                                tt = e_fresh()
                                e_emit("  " + tt + " = sitofp i64 " + fv + " to double\n")
                                nv2 = e_fresh()
                                e_emit("  " + nv2 + " = insertvalue " + body + " " + cur + ", double " + tt + ", " + flint_i64_to_string(fx) + "\n")
                                cur = nv2
                                matched = matched + 1
                            } else {
                                EERR = EERR + 1
                                print("emit error: field type mismatch")
                                print(fn2)
                                ok = 0
                            }
                        } else {
                            EERR = EERR + 1
                            print("emit error: field type mismatch")
                            print(fn2)
                            ok = 0
                        }
                    }
                }
                e_skip()
                if e_peek() == 41 {
                    e_adv()
                } else {
                    EERR = EERR + 1
                    ok = 0
                }
            } else {
                EERR = EERR + 1
                ok = 0
                go = 0
            }
        }
    }
    # Consume the fields-list close; our own `)` belongs to e_expr.
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        ok = 0
    }
    # Cursor stays before our own `)` (e_expr consumes it).
    if ok == 0 {
        ETYPE = 0
        ""
    } else {
        if matched != n {
            EERR = EERR + 1
            print("emit error: struct literal missing fields")
            print(nm)
            ETYPE = 0
            ""
        } else {
            ETYPE = code
            cur
        }
    }
}
# Coverage-set helper: 1 if v present in EMATCHCOV from start, else 0.
fn e_cov_has(start: i64, v: i64) -> i64 {
    mut i: i64 = start
    top = flint_vec_len(EMATCHCOV)
    mut found: i64 = 0
    while i < top {
        if flint_vec_get(EMATCHCOV, i) == v {
            found = 1
            i = top
        } else {
            i = i + 1
        }
    }
    found
}
# (field BASE F): struct field extract.
fn e_field() -> str {
    b = e_expr()
    bc = ETYPE
    e_skip()
    fn2 = e_word()
    if bc < 100 {
        EERR = EERR + 1
        print("emit error: field needs a struct")
        return ""
    }
    kk = flint_vec_get(ENTKind, bc - 100)
    if kk != 0 {
        EERR = EERR + 1
        print("emit error: field needs a struct")
        return ""
    }
    fx = e_ent_field(bc, fn2)
    if fx == -1 {
        EERR = EERR + 1
        print("emit error: unknown field")
        print(fn2)
        return ""
    }
    base = flint_vec_get(ENTBase, bc - 100)
    fc = flint_vec_get(ENFCode, base + fx)
    t = e_fresh()
    e_emit("  " + t + " = extractvalue " + e_llvm_typecode(bc) + " " + b + ", " + flint_i64_to_string(fx) + "\n")
    ETYPE = fc
    t
}
# (enum-lit E V): tag-only variant -> i64 tag index. Payloads need G7.
fn e_enum_lit() -> str {
    e_skip()
    en = e_word()
    vn = e_word()
    code = e_ent_lookup(en)
    if code == -1 {
        EERR = EERR + 1
        print("emit error: unknown enum")
        print(en)
        return ""
    }
    kk = flint_vec_get(ENTKind, code - 100)
    if kk == 0 {
        EERR = EERR + 1
        print("emit error: not an enum")
        print(en)
        return ""
    }
    vx = e_ent_field(code, vn)
    if vx == -1 {
        EERR = EERR + 1
        print("emit error: unknown variant")
        print(vn)
        return ""
    }
    e_skip()
    if e_peek() == 41 {
        if kk == 2 {
            t0 = e_fresh()
            e_emit("  " + t0 + " = insertvalue " + e_llvm_typecode(code) + " zeroinitializer, i8 " + flint_i64_to_string(vx) + ", 0\n")
            ETYPE = code
            t0
        } else {
            ETYPE = code
            flint_i64_to_string(vx)
        }
    } else {
        e_enum_lit_payload(code, kk, vx, vn)
    }
}
# Payload construction after `(enum-lit E V`; cursor at first arg.
fn e_enum_lit_payload(code: i64, kk: i64, vx: i64, vn: str) -> str {
    base = flint_vec_get(ENTBase, code - 100)
    np = flint_vec_get(ENFNP, base + vx)
    pb = flint_vec_get(ENFPB, base + vx)
    if kk != 2 {
        EERR = EERR + 1
        print("emit error: variant takes no payload")
        print(vn)
        return ""
    }
    body = e_llvm_typecode(code)
    vty = e_variant_type(code, vx)
    ev = e_fresh()
    e_emit("  " + ev + " = alloca " + body + "\n")
    e_emit("  store i8 " + flint_i64_to_string(vx) + ", ptr " + ev + "\n")
    mut ok: i64 = 1
    mut j: i64 = 0
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if j < np {
                want = flint_vec_get(ENFPT, pb + j)
                a = e_expr()
                ac = ETYPE
                esv = EERR
                cv = e_conv(a, ac, want)
                er2 = EERR
                if er2 == esv {
                    pp = e_fresh()
                    e_emit("  " + pp + " = getelementptr " + vty + ", ptr " + ev + ", i32 0, i32 " + flint_i64_to_string(j + 1) + "\n")
                    e_emit("  store " + e_llvm_typecode(want) + " " + cv + ", ptr " + pp + "\n")
                } else {
                    print("emit error: payload type mismatch")
                    print(vn)
                    ok = 0
                }
                j = j + 1
            } else {
                EERR = EERR + 1
                print("emit error: too many payload args")
                print(vn)
                ok = 0
                e_skip_value()
            }
        }
    }
    # Cursor stays before our own `)` (e_expr consumes it).
    if ok == 0 {
        ETYPE = 0
        ""
    } else {
        if j != np {
            EERR = EERR + 1
            print("emit error: payload count mismatch")
            print(vn)
            ETYPE = 0
            ""
        } else {
            lv = e_fresh()
            e_emit("  " + lv + " = load " + body + ", ptr " + ev + "\n")
            ETYPE = code
            lv
        }
    }
}
# Bind arm payload 0 to NAME (inside the arm, before its body).
# The pre-pass allocated the slot; this stores. Returns 1 ok, 0 error.
fn e_match_bind(code: i64, vx: i64, vn: str, nm: str, sa: str) -> i64 {
    base = flint_vec_get(ENTBase, code - 100)
    np = flint_vec_get(ENFNP, base + vx)
    if np == 0 {
        EERR = EERR + 1
        print("emit error: cannot bind empty variant")
        print(vn)
        0
    } else {
        pb = flint_vec_get(ENFPB, base + vx)
        p0 = flint_vec_get(ENFPT, pb)
        vty = e_variant_type(code, vx)
        bp = e_fresh()
        e_emit("  " + bp + " = bitcast ptr " + sa + " to " + vty + "*\n")
        ep = e_fresh()
        e_emit("  " + ep + " = getelementptr " + vty + ", ptr " + bp + ", i32 0, i32 1\n")
        lv = e_fresh()
        e_emit("  " + lv + " = load " + e_llvm_typecode(p0) + ", ptr " + ep + "\n")
        e_declare_var(nm, p0, lv)
        1
    }
}
# (unwrap X) / (try X): panic on tag-0 payload enums, else payload 0.
# Non-enums pass through (mirrors C++ no-op); structs are a loud error.
# Only uniform single-payload enums unwrap soundly (heterogeneous ones
# would need runtime dispatch; C++ silently assumes i64).
fn e_unwrap() -> str {
    x = e_expr()
    xc = ETYPE
    if xc < 100 {
        x
    } else {
        kk = flint_vec_get(ENTKind, xc - 100)
        if kk == 0 {
            EERR = EERR + 1
            print("emit error: unwrap needs an enum")
            ""
        } else {
            if kk == 1 {
                x
            } else {
                np = e_enum_payload_sig(xc, 0)
                cp = e_enum_payload_sig(xc, 1)
                if np != 1 {
                    EERR = EERR + 1
                    print("emit error: unwrap needs uniform single payload")
                    ""
                } else {
                    if cp == -1 {
                        EERR = EERR + 1
                        print("emit error: unwrap needs uniform single payload")
                        ""
                    } else {
                        body = e_llvm_typecode(xc)
                        xa = e_fresh()
                        e_emit("  " + xa + " = alloca " + body + "\n")
                        e_emit("  store " + body + " " + x + ", ptr " + xa + "\n")
                        tp = e_fresh()
                        e_emit("  " + tp + " = getelementptr " + body + ", ptr " + xa + ", i32 0, i32 0\n")
                        tb = e_fresh()
                        e_emit("  " + tb + " = load i8, ptr " + tp + "\n")
                        cb = e_fresh()
                        e_emit("  " + cb + " = icmp eq i8 " + tb + ", 0\n")
                        okb = e_label("unwrap.ok.")
                        pnb = e_label("unwrap.panic.")
                        e_emit("  br i1 " + cb + ", label %" + pnb + ", label %" + okb + "\n")
                        e_emit(pnb + ":\n")
                        ECUR = pnb
                        pm = e_panic_msg("unwrap of None/Err")
                        e_emit("  call void @flint_panic(ptr " + pm + ")\n")
                        e_emit("  unreachable\n")
                        e_emit(okb + ":\n")
                        ECUR = okb
                        vty = e_enum_variant_text(xc)
                        bp = e_fresh()
                        e_emit("  " + bp + " = bitcast ptr " + xa + " to " + vty + "*\n")
                        ep = e_fresh()
                        e_emit("  " + ep + " = getelementptr " + vty + ", ptr " + bp + ", i32 0, i32 1\n")
                        lv = e_fresh()
                        e_emit("  " + lv + " = load " + e_llvm_typecode(cp) + ", ptr " + ep + "\n")
                        ETYPE = cp
                        lv
                    }
                }
            }
        }
    }
}
# First payload-carrying variant's struct text (for unwrap bitcast).
fn e_enum_variant_text(code: i64) -> str {
    n = flint_vec_get(ENTN, code - 100)
    base = flint_vec_get(ENTBase, code - 100)
    mut i: i64 = 0
    mut r: str = "{{i8}}"
    while i < n {
        np = flint_vec_get(ENFNP, base + i)
        if np > 0 {
            r = e_variant_type(code, i)
            i = n
        } else {
            i = i + 1
        }
    }
    r
}
# (match S (arms ((PAT BODY))*)): enum tag dispatch with if/else chain.
# Exhaustiveness is a compile error (mirrors C++); a panic backstop guards
# corrupted tags. Value arms merge through a hidden result slot (avoids phi
# bookkeeping for N arms): all fallthrough arms must yield the same type.
fn e_match() -> str {
    s = e_expr()
    sc = ETYPE
    if sc < 100 {
        EERR = EERR + 1
        print("emit error: match needs an enum in G5")
        return ""
    }
    kk = flint_vec_get(ENTKind, sc - 100)
    if kk == 0 {
        EERR = EERR + 1
        print("emit error: match needs an enum in G5")
        return ""
    }
    # Tag value: direct for tag enums, extracted for payload enums.
    # Payload enums also spill to a temp alloca (bindings bitcast it).
    mut tagv: str = s
    mut sa: str = ""
    if kk == 2 {
        sbody = e_llvm_typecode(sc)
        sa = e_fresh()
        e_emit("  " + sa + " = alloca " + sbody + "\n")
        e_emit("  store " + sbody + " " + s + ", ptr " + sa + "\n")
        tg = e_fresh()
        e_emit("  " + tg + " = extractvalue " + sbody + " " + s + ", 0\n")
        te = e_fresh()
        e_emit("  " + te + " = zext i8 " + tg + " to i64\n")
        tagv = te
    }
    ename = e_ent_name(sc)
    nv = flint_vec_get(ENTN, sc - 100)
    exs = e_expect(40)
    if exs == 0 {
        return ""
    }
    e_skip()
    aw = e_word()
    if aw != "arms" {
        EERR = EERR + 1
        print("emit error: match needs arms")
        return ""
    }
    # Pre-create arm + check labels (names only; bodies emit in order).
    mut na: i64 = 0
    mut go0: i64 = 1
    pcount = e_pos()
    while go0 == 1 {
        e_skip()
        if e_peek() == 41 {
            go0 = 0
        } else {
            e_skip_value()
            na = na + 1
        }
    }
    flint_vec_set(EC, 0, pcount)
    mb = e_label("match.end.")
    pb = e_label("match.panic.")
    first_chk = e_label("match.chk.")
    e_emit("  br label %" + first_chk + "\n")
    mut pending: str = first_chk
    mut mcode: i64 = 0
    mut allterm: i64 = 1
    mut ok: i64 = 1
    cov0 = flint_vec_len(EMATCHCOV)
    d0 = flint_vec_len(EMATCHD)
    mut ai: i64 = 0
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                e_adv()
                e_skip()
                if e_peek() == 40 {
                    e_adv()
                    e_skip()
                    pw = e_word()
                    if pw != "pat-var" {
                        EERR = EERR + 1
                        print("emit error: bad match pattern")
                        ok = 0
                    }
                    pen = e_word()
                    pvn = e_word()
                    pbd = e_word()
                    e_skip()
                    if e_peek() == 41 {
                        e_adv()
                    } else {
                        EERR = EERR + 1
                        ok = 0
                    }
                    if pen != ename {
                        EERR = EERR + 1
                        print("emit error: match arm enum mismatch")
                        print(pen)
                        ok = 0
                    }
                    vx = e_ent_field(sc, pvn)
                    if vx == -1 {
                        EERR = EERR + 1
                        print("emit error: unknown variant")
                        print(pvn)
                        ok = 0
                    } else {
                        dup = e_cov_has(cov0, vx)
                        if dup == 1 {
                            EERR = EERR + 1
                            print("emit error: duplicate match arm")
                            print(pvn)
                            ok = 0
                        } else {
                            flint_vec_push(EMATCHCOV, vx)
                        }
                    }
                    if pbd != "-" {
                        if kk != 2 {
                            EERR = EERR + 1
                            print("emit error: cannot bind tag-only variant")
                            print(pvn)
                            ok = 0
                        }
                    }
                    # Check block: tag == idx -> arm, else next check/panic.
                    # One-step lookahead: this check's false edge names the
                    # next check, which the next iteration emits (no pads).
                    ab = e_label("match.arm.")
                    chk = pending
                    last = ai + 1
                    mut fol: str = pb
                    if last != na {
                        fol = e_label("match.chk.")
                    }
                    e_emit(chk + ":\n")
                    ECUR = chk
                    cmpt = e_fresh()
                    e_emit("  " + cmpt + " = icmp eq i64 " + tagv + ", " + flint_i64_to_string(vx) + "\n")
                    e_emit("  br i1 " + cmpt + ", label %" + ab + ", label %" + fol + "\n")
                    pending = fol
                    e_emit(ab + ":\n")
                    ECUR = ab
                    if pbd != "-" {
                        if kk == 2 {
                            if e_match_bind(sc, vx, pvn, pbd, sa) == 0 {
                                ok = 0
                            }
                        }
                    }
                    # Arm body: block or single form.
                    e_skip()
                    ppos = e_pos()
                    mut tm: i64 = 0
                    if e_peek() == 40 {
                        e_adv()
                        e_skip()
                        bw = e_word()
                        flint_vec_set(EC, 0, ppos)
                        if bw == "block" {
                            tb2 = e_block()
                            tm = ETERM
                        } else {
                            ts2 = e_stmt()
                            tm = ETERM
                        }
                    } else {
                        EERR = EERR + 1
                        ok = 0
                    }
                    if tm == 0 {
                        bv = EBLOCKVAL
                        bc = EBLOCKCODE
                        bx = EBLOCKEXPR
                        inb = ECUR
                        if bx == 1 {
                            if bc != 0 {
                                if mcode == 0 {
                                    mcode = bc
                                }
                                if bc == mcode {
                                    vo = flint_str_length(EMATCHTEXT)
                                    EMATCHTEXT = EMATCHTEXT + bv
                                    bo = flint_str_length(EMATCHTEXT)
                                    EMATCHTEXT = EMATCHTEXT + inb
                                    flint_vec_push(EMATCHD, vo)
                                    flint_vec_push(EMATCHD, flint_str_length(bv))
                                    flint_vec_push(EMATCHD, bo)
                                    flint_vec_push(EMATCHD, flint_str_length(inb))
                                } else {
                                    EERR = EERR + 1
                                    print("emit error: match arms must agree in type")
                                    ok = 0
                                }
                            }
                        }
                        e_emit("  br label %" + mb + "\n")
                        allterm = 0
                    }
                    e_skip()
                    if e_peek() == 41 {
                        e_adv()
                    } else {
                        EERR = EERR + 1
                        ok = 0
                    }
                    ai = ai + 1
                } else {
                    EERR = EERR + 1
                    ok = 0
                    go = 0
                }
            } else {
                EERR = EERR + 1
                ok = 0
                go = 0
            }
        }
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        ok = 0
    }
    if ok == 0 {
        ETYPE = 0
        ""
    } else {
        covn = flint_vec_len(EMATCHCOV) - cov0
        if covn != nv {
            EERR = EERR + 1
            print("emit error: non-exhaustive match")
            print(ename)
            ETYPE = 0
            ""
        } else {
            e_emit(pb + ":\n")
            ECUR = pb
            pmn = e_panic_msg("non-exhaustive match")
            e_emit("  call void @flint_panic(ptr " + pmn + ")\n")
            e_emit("  unreachable\n")
            e_emit(mb + ":\n")
            ECUR = mb
            if allterm == 1 {
                ETERM = 1
            } else {
                ETERM = 0
            }
            if mcode == 0 {
                EBLOCKEXPR = 0
                EBLOCKVAL = ""
                EBLOCKCODE = 0
                ETYPE = 0
                ""
            } else {
                lr = e_fresh()
                psb = flint_sb_new()
                flint_sb_append(psb, "  " + lr + " = phi " + e_llvm_typecode(mcode) + " ")
                mut di: i64 = d0
                dtop = flint_vec_len(EMATCHD)
                mut first_e: i64 = 1
                while di < dtop {
                    vo = flint_vec_get(EMATCHD, di)
                    vl = flint_vec_get(EMATCHD, di + 1)
                    bo = flint_vec_get(EMATCHD, di + 2)
                    bl = flint_vec_get(EMATCHD, di + 3)
                    vv = flint_str_substring(EMATCHTEXT, vo, vo + vl)
                    bb2 = flint_str_substring(EMATCHTEXT, bo, bo + bl)
                    if first_e == 0 {
                        flint_sb_append(psb, ", ")
                    }
                    flint_sb_append(psb, "[" + vv + ", %" + bb2 + "]")
                    first_e = 0
                    di = di + 4
                }
                flint_sb_append(psb, "\n")
                e_emit(flint_sb_build(psb))
                flint_sb_free(psb)
                EBLOCKEXPR = 1
                EBLOCKVAL = lr
                EBLOCKCODE = mcode
                ETYPE = mcode
                lr
            }
        }
    }
}
# ---- G6: runtime passthrough + maps/methods (self-hosting) ----
# Opaque handles (vec/sb) are code 7; maps are code 6 (str-keyed, i64 vals).
# e_rt_sig returns "RET:PARAMS" with digit codes, or "" when unknown.
fn e_rt_sig(name: str) -> str {
    # Process/env control (early returns keep the table below balanced).
    if name == "flint_exit" {
        return "0:1"
    }
    if name == "flint_str_skip_ws" {
        return "1:3,1"
    }
    if name == "flint_str_word_end" {
        return "1:3,1"
    }
    # AEGIS leases (codes: 0 void, 1 i64). Lease ids are i64 handles.
    if name == "flint_aegis_alloc" {
        return "1:1"
    }
    if name == "flint_aegis_free" {
        return "1:1"
    }
    if name == "flint_aegis_read_i64" {
        return "1:1,1"
    }
    if name == "flint_aegis_write_i64" {
        return "0:1,1,1"
    }
    if name == "flint_aegis_read_i64_unchecked" {
        return "1:1,1"
    }
    if name == "flint_aegis_write_i64_unchecked" {
        return "0:1,1,1"
    }
    if name == "flint_aegis_len" {
        return "1:1"
    }
    if name == "flint_aegis_check" {
        return "1:1"
    }
    if name == "flint_aegis_move" {
        return "1:1"
    }
    if name == "flint_aegis_borrow" {
        return "1:1"
    }
    if name == "flint_aegis_unborrow" {
        return "1:1"
    }
    if name == "flint_aegis_read_u8" {
        return "1:1,1"
    }
    if name == "flint_aegis_write_u8" {
        return "0:1,1,1"
    }
    # Channels (3 ptr; i64 converts via inttoptr/ptrtoint in e_conv).
    if name == "flint_chan_new" {
        return "3:1"
    }
    if name == "flint_chan_free" {
        return "0:3"
    }
    if name == "flint_chan_send" {
        return "1:3,1"
    }
    if name == "flint_chan_recv" {
        return "1:3"
    }
    if name == "flint_chan_close" {
        return "1:3"
    }
    if name == "flint_chan_len" {
        return "1:3"
    }
    if name == "flint_exists" {
        return "1:3"
    }
    if name == "flint_command" {
        return "1:3"
    }
    if name == "flint_str_to_upper" {
        return "3:3"
    }
    if name == "flint_str_to_lower" {
        return "3:3"
    }
    if name == "flint_str_trim" {
        return "3:3"
    }
    if name == "flint_str_reverse" {
        return "3:3"
    }
    if name == "flint_str_repeat" {
        return "3:3,1"
    }
    if name == "flint_str_replace" {
        return "3:3,3,3"
    }
    if name == "flint_str_starts_with" {
        return "1:3,3"
    }
    if name == "flint_str_ends_with" {
        return "1:3,3"
    }
    if name == "flint_map_keys" {
        return "3:6"
    }
    if name == "flint_vec_new" {
        "7:"
    } else {
        if name == "flint_vec_free" {
            "0:7"
        } else {
            if name == "flint_vec_len" {
                "1:7"
            } else {
                if name == "flint_vec_get" {
                    "1:7,1"
                } else {
                    if name == "flint_vec_set" {
                        "0:7,1,1"
                    } else {
                        if name == "flint_vec_push" {
                            "0:7,1"
                        } else {
                            if name == "flint_vec_pop" {
                                "1:7"
                            } else {
                                if name == "flint_vec_clear" {
                                    "0:7"
                                } else {
                                    if name == "flint_sb_new" {
                                        "7:"
                                    } else {
                                        if name == "flint_sb_free" {
                                            "0:7"
                                        } else {
                                            if name == "flint_sb_append" {
                                                "0:7,3"
                                            } else {
                                                if name == "flint_sb_append_char" {
                                                    "0:7,1"
                                                } else {
                                                    if name == "flint_sb_append_i64" {
                                                        "0:7,1"
                                                    } else {
                                                        if name == "flint_sb_append_f64" {
                                                            "0:7,2"
                                                        } else {
                                                            if name == "flint_sb_len" {
                                                                "1:7"
                                                            } else {
                                                                if name == "flint_sb_build" {
                                                                    "3:7"
                                                                } else {
                                                                    if name == "flint_str_length" {
                                                                        "1:3"
                                                                    } else {
                                                                        if name == "flint_str_char_at" {
                                                                            "1:3,1"
                                                                        } else {
                                                                            if name == "flint_str_substring" {
                                                                                "3:3,1,1"
                                                                            } else {
                                                                                if name == "flint_str_compare" {
                                                                                    "1:3,3"
                                                                                } else {
                                                                                    if name == "flint_str_to_i64" {
                                                                                        "1:3"
                                                                                    } else {
                                                                                        if name == "flint_str_to_f64" {
                                                                                            "2:3"
                                                                                        } else {
                                                                                            if name == "flint_str_concat" {
                                                                                                "3:3,3"
                                                                                            } else {
                                                                                                if name == "flint_str_index_of" {
                                                                                                    "1:3,3"
                                                                                                } else {
                                                                                                    if name == "flint_i64_to_string" {
                                                                                                        "3:1"
                                                                                                    } else {
                                                                                                        if name == "flint_read_file" {
                                                                                                            "3:3"
                                                                                                        } else {
                                                                                                            if name == "flint_write_file" {
                                                                                                                "1:3,3"
                                                                                                            } else {
                                                                                                                if name == "flint_get_arg" {
                                                                                                                    "3:1"
                                                                                                                } else {
                                                                                                                    if name == "flint_arg_count" {
                                                                                                                        "1:"
                                                                                                                    } else {
                                                                                                                        if name == "flint_err_occurred" {
                                                                                                                            "1:"
                                                                                                                        } else {
                                                                                                                            if name == "flint_panic" {
                                                                                                                                "0:3"
                                                                                                                            } else {
                                                                                                                                if name == "flint_bounds_check" {
                                                                                                                                    "0:1,1"
                                                                                                                                } else {
                                                                                                                                    if name == "flint_array_concat" {
                                                                                                                                        "4:4,4"
                                                                                                                                    } else {
                                                                                                                                        if name == "flint_map_new" {
                                                                                                                                            "6:"
                                                                                                                                        } else {
                                                                                                                                            if name == "flint_map_free" {
                                                                                                                                                "0:6"
                                                                                                                                            } else {
                                                                                                                                                if name == "flint_map_has" {
                                                                                                                                                    "1:6,3"
                                                                                                                                                } else {
                                                                                                                                                    if name == "flint_map_get" {
                                                                                                                                                        "1:6,3"
                                                                                                                                                    } else {
                                                                                                                                                        if name == "flint_map_set" {
                                                                                                                                                            "0:6,3,1"
                                                                                                                                                        } else {
                                                                                                                                                            if name == "flint_map_len" {
                                                                                                                                                                "1:6"
                                                                                                                                                            } else {
                                                                                                                                                                ""
                                                                                                                                                            }
                                                                                                                                                        }
                                                                                                                                                    }
                                                                                                                                                }
                                                                                                                                            }
                                                                                                                                        }
                                                                                                                                    }
                                                                                                                                }
                                                                                                                            }
                                                                                                                        }
                                                                                                                    }
                                                                                                                }
                                                                                                            }
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
# Declare-once registry for runtime externs (emitted to module top).
ERTDECL = map {
    "": 0
}
# Emit `declare` for a runtime fn from its sig (once per name).
fn e_rt_declare(name: str, sig: str) -> i64 {
    if ERTDECL.has(name) == 1 {
        1
    } else {
        ERTDECL.set(name, 1)
        rc = flint_str_char_at(sig, 0) - 48
        sb = flint_sb_new()
        flint_sb_append(sb, "declare " + e_llvm_typecode(rc) + " @" + name + "(")
        mut pi: i64 = 2
        mut firstp: i64 = 1
        n = flint_str_length(sig)
        while pi < n {
            c = flint_str_char_at(sig, pi)
            if c == 44 {
                pi = pi + 1
            } else {
                if firstp == 0 {
                    flint_sb_append(sb, ", ")
                }
                flint_sb_append(sb, e_llvm_typecode(c - 48))
                firstp = 0
                pi = pi + 1
            }
        }
        flint_sb_append(sb, ")\n")
        e_emit_glob(flint_sb_build(sb))
        flint_sb_free(sb)
        1
    }
}
# Call a runtime fn by sig ("R:P..."): strict arg checking, auto-declare.
# Parses args up to `)`; the closing paren belongs to the caller.
fn e_rt_call(name: str, sig: str) -> str {
    e_rt_declare(name, sig)
    rc = flint_str_char_at(sig, 0) - 48
    sb = flint_sb_new()
    mut pi: i64 = 2
    mut ok: i64 = 1
    mut go: i64 = 1
    n = flint_str_length(sig)
    mut ai: i64 = 0
    mut want: i64 = -1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            want = -1
            if pi < n {
                c = flint_str_char_at(sig, pi)
                if c == 44 {
                    pi = pi + 1
                    c2 = flint_str_char_at(sig, pi)
                    want = c2 - 48
                    pi = pi + 1
                } else {
                    want = c - 48
                    pi = pi + 1
                }
            } else {
                EERR = EERR + 1
                print("emit error: too many args calling runtime")
                print(name)
                ok = 0
            }
            a = e_expr()
            ac = ETYPE
            if want == -1 {
                ok = 0
            } else {
                if ai > 0 {
                    flint_sb_append(sb, ", ")
                }
                esv = EERR
                cv = e_conv(a, ac, want)
                er2 = EERR
                if er2 == esv {
                    flint_sb_append(sb, e_llvm_typecode(want) + " " + cv)
                } else {
                    print("emit error: runtime arg mismatch calling")
                    print(name)
                    ok = 0
                }
            }
            ai = ai + 1
        }
    }
    # Missing args check: consumed sig must be exhausted.
    mut qi: i64 = pi
    while qi < n {
        qc = flint_str_char_at(sig, qi)
        if qc == 44 {
            qi = qi + 1
        } else {
            EERR = EERR + 1
            print("emit error: too few args calling runtime")
            print(name)
            ok = 0
            qi = n
        }
    }
    argstr = flint_sb_build(sb)
    flint_sb_free(sb)
    if ok == 0 {
        ETYPE = 0
        ""
    } else {
        if rc == 0 {
            e_emit("  call void @" + name + "(" + argstr + ")\n")
            ETYPE = 0
            ""
        } else {
            t = e_fresh()
            e_emit("  " + t + " = call " + e_llvm_typecode(rc) + " @" + name + "(" + argstr + ")\n")
            ETYPE = rc
            t
        }
    }
}
# (map-lit K V ...): string keys, i64 values via flint_map_new/set.
fn e_map_lit() -> str {
    m = e_fresh()
    e_emit("  " + m + " = call ptr @flint_map_new()\n")
    e_rt_declare("flint_map_new", e_rt_sig("flint_map_new"))
    mut ok: i64 = 1
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            k = e_expr()
            kc = ETYPE
            v = e_expr()
            vc = ETYPE
            if kc == 3 {
                if vc == 1 {
                    e_rt_declare("flint_map_set", e_rt_sig("flint_map_set"))
                    e_emit("  call void @flint_map_set(ptr " + m + ", ptr " + k + ", i64 " + v + ")\n")
                } else {
                    EERR = EERR + 1
                    print("emit error: map values need i64 in G6")
                    ok = 0
                }
            } else {
                EERR = EERR + 1
                print("emit error: map keys need str in G6")
                ok = 0
            }
        }
    }
    if ok == 0 {
        ETYPE = 0
        ""
    } else {
        ETYPE = 6
        m
    }
}
# (method BASE NAME ARGS...): zero-cost sugar over runtime calls
# (mirrors the C++ method tables). str: len/upper/lower/trim/reverse/
# repeat/replace/startswith/endswith/indexof/get. map: get/set/has/len/keys.
fn e_method() -> str {
    b = e_expr()
    bc = ETYPE
    e_skip()
    mn = e_word()
    if bc == 3 {
        e_method_str(b, mn)
    } else {
        if bc == 6 {
            e_method_map(b, mn)
        } else {
            EERR = EERR + 1
            print("emit error: methods need str/map in G7")
            print(mn)
            ""
        }
    }
}
# One string arg of expected code; "" with EERR on mismatch.
fn e_method_arg(want: i64) -> str {
    a = e_expr()
    ac = ETYPE
    if ac == want {
        a
    } else {
        EERR = EERR + 1
        print("emit error: method arg mismatch")
        ""
    }
}
# Zero-arg str method returning TYPE via runtime R.
fn e_method_str0(b: str, r: str, code: i64) -> str {
    e_rt_declare(r, e_rt_sig(r))
    t = e_fresh()
    e_emit("  " + t + " = call " + e_llvm_typecode(code) + " @" + r + "(ptr " + b + ")\n")
    ETYPE = code
    t
}
# One-arg str method.
fn e_method_str1(b: str, r: str, code: i64, ac: i64) -> str {
    a = e_method_arg(ac)
    e_rt_declare(r, e_rt_sig(r))
    t = e_fresh()
    e_emit("  " + t + " = call " + e_llvm_typecode(code) + " @" + r + "(ptr " + b + ", " + e_llvm_typecode(ac) + " " + a + ")\n")
    ETYPE = code
    t
}
# Two-arg str method (both str).
fn e_method_str2(b: str, r: str, code: i64) -> str {
    a = e_method_arg(3)
    c = e_method_arg(3)
    e_rt_declare(r, e_rt_sig(r))
    t = e_fresh()
    e_emit("  " + t + " = call " + e_llvm_typecode(code) + " @" + r + "(ptr " + b + ", ptr " + a + ", ptr " + c + ")\n")
    ETYPE = code
    t
}
fn e_method_str(b: str, mn: str) -> str {
    if mn == "len" {
        e_method_str0(b, "flint_str_length", 1)
    } else {
        if mn == "upper" {
            e_method_str0(b, "flint_str_to_upper", 3)
        } else {
            if mn == "lower" {
                e_method_str0(b, "flint_str_to_lower", 3)
            } else {
                if mn == "trim" {
                    e_method_str0(b, "flint_str_trim", 3)
                } else {
                    if mn == "reverse" {
                        e_method_str0(b, "flint_str_reverse", 3)
                    } else {
                        if mn == "repeat" {
                            e_method_str1(b, "flint_str_repeat", 3, 1)
                        } else {
                            if mn == "replace" {
                                e_method_str2(b, "flint_str_replace", 3)
                            } else {
                                if mn == "startswith" {
                                    e_method_str1(b, "flint_str_starts_with", 1, 3)
                                } else {
                                    if mn == "endswith" {
                                        e_method_str1(b, "flint_str_ends_with", 1, 3)
                                    } else {
                                        if mn == "indexof" {
                                            e_method_str1(b, "flint_str_index_of", 1, 3)
                                        } else {
                                            if mn == "get" {
                                                e_method_str1(b, "flint_str_char_at", 1, 1)
                                            } else {
                                                EERR = EERR + 1
                                                print("emit error: unknown str method")
                                                print(mn)
                                                ""
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
fn e_method_map(b: str, mn: str) -> str {
    if mn == "has" {
        k = e_method_arg(3)
        e_rt_declare("flint_map_has", e_rt_sig("flint_map_has"))
        t = e_fresh()
        e_emit("  " + t + " = call i64 @flint_map_has(ptr " + b + ", ptr " + k + ")\n")
        ETYPE = 1
        t
    } else {
        if mn == "get" {
            k2 = e_method_arg(3)
            e_rt_declare("flint_map_get", e_rt_sig("flint_map_get"))
            t2 = e_fresh()
            e_emit("  " + t2 + " = call i64 @flint_map_get(ptr " + b + ", ptr " + k2 + ")\n")
            ETYPE = 1
            t2
        } else {
            if mn == "set" {
                k3 = e_method_arg(3)
                v3 = e_method_arg(1)
                e_rt_declare("flint_map_set", e_rt_sig("flint_map_set"))
                e_emit("  call void @flint_map_set(ptr " + b + ", ptr " + k3 + ", i64 " + v3 + ")\n")
                ETYPE = 0
                ""
            } else {
                if mn == "len" {
                    e_rt_declare("flint_map_len", e_rt_sig("flint_map_len"))
                    t4 = e_fresh()
                    e_emit("  " + t4 + " = call i64 @flint_map_len(ptr " + b + ")\n")
                    ETYPE = 1
                    t4
                } else {
                    if mn == "keys" {
                        e_rt_declare("flint_map_keys", e_rt_sig("flint_map_keys"))
                        t5 = e_fresh()
                        e_emit("  " + t5 + " = call ptr @flint_map_keys(ptr " + b + ")\n")
                        ETYPE = 3
                        t5
                    } else {
                        EERR = EERR + 1
                        print("emit error: unknown map method")
                        print(mn)
                        ""
                    }
                }
            }
        }
    }
}
# String-form lookahead: 1 if cursor is at `(str LEN RAW)`, else 0.
# Never consumes (always rewinds to entry position). Paren-counting skips
# must not count RAW bytes.
fn e_at_str() -> i64 {
    sp0 = e_pos()
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        w = e_word()
        flint_vec_set(EC, 0, sp0)
        if w == "str" {
            1
        } else {
            0
        }
    } else {
        flint_vec_set(EC, 0, sp0)
        0
    }
}
# Skip one whole `(str LEN RAW)` unit (cursor at its `(`).
fn e_skip_str() -> i64 {
    e_adv()
    e_skip()
    e_word()
    e_skip()
    ln = e_read_num_raw()
    n2 = flint_str_to_i64(ln)
    if e_peek() == 32 {
        e_adv()
    }
    mut k: i64 = 0
    while k < n2 {
        e_adv()
        k = k + 1
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
        1
    } else {
        EERR = EERR + 1
        0
    }
}
# String-aware depth skipper (shared core): from current position with
# entry depth d, consume to (and through) the matching close.
fn e_skip_depth(d: i64) -> i64 {
    n = flint_str_length(ESRC)
    mut depth: i64 = d
    mut go: i64 = 1
    while go == 1 {
        if e_pos() < n {
            e_skip()
            if e_peek() == -1 {
                go = 0
            } else {
                as = e_at_str()
                if as == 1 {
                    e_skip_str()
                } else {
                    c = e_adv()
                    if c == 40 {
                        depth = depth + 1
                    } else {
                        if c == 41 {
                            depth = depth - 1
                            if depth == 0 {
                                go = 0
                            }
                        }
                    }
                }
            }
        } else {
            go = 0
        }
    }
    0
}
# Skip to the matching close paren from MID-FORM (depth starts at 1).
# For inference skips after `(` + tag were consumed (e_skip_balanced only
# starts at a form boundary).
fn e_skip_rest() -> i64 {
    e_skip_depth(1)
}
# Tail value typecode of a `(block ...)` (0 for statement tails).
# Cursor at the block form; consumed through it.
fn e_infer_block_tail() -> i64 {
    e_adv()
    e_skip()
    w = e_word()
    if w != "block" {
        EERR = EERR + 1
        e_skip_rest()
        0
    } else {
        mut tail: i64 = 0
        mut go: i64 = 1
        while go == 1 {
            e_skip()
            if e_peek() == 41 {
                go = 0
            } else {
                if e_peek() == -1 {
                    go = 0
                } else {
                    tail = e_infer_init()
                }
            }
        }
        e_skip()
        if e_peek() == 41 {
            e_adv()
        }
        tail
    }
}
# Value typecode of `(if C T [E])` with block arms (0 when no mergeable
# value, mirroring emit's arm-phi rule).
fn e_infer_if() -> i64 {
    e_skip_value()
    mut t1: i64 = 0
    e_skip()
    if e_peek() == 40 {
        t1 = e_infer_block_tail()
    }
    mut t2: i64 = 0
    mut has_else: i64 = 0
    e_skip()
    if e_peek() == 40 {
        has_else = 1
        t2 = e_infer_block_tail()
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    }
    if has_else == 0 {
        0
    } else {
        if t1 == t2 {
            if t1 == 0 {
                0
            } else {
                t1
            }
        } else {
            0
        }
    }
}
# Value typecode of `(match S (arms ...))` (0 unless all arms agree).
fn e_infer_match() -> i64 {
    e_skip_value()
    exs = e_expect(40)
    if exs == 0 {
        return 0
    }
    e_skip()
    aw = e_word()
    mut agree: i64 = 1
    mut mt: i64 = 0
    mut firstm: i64 = 1
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                e_adv()
                e_skip()
                if e_peek() == 40 {
                    e_adv()
                    e_skip()
                    e_word()
                    e_skip()
                    ien = e_word()
                    ivn = e_word()
                    ibd = e_word()
                    e_skip()
                    if e_peek() == 41 {
                        e_adv()
                    }
                    if ibd != "-" {
                        icode = e_ent_lookup(ien)
                        if icode != -1 {
                            ik = flint_vec_get(ENTKind, icode - 100)
                            if ik == 2 {
                                iex = e_ent_field(icode, ivn)
                                if iex != -1 {
                                    ibase = flint_vec_get(ENTBase, icode - 100)
                                    inp = flint_vec_get(ENFNP, ibase + iex)
                                    if inp > 0 {
                                        ipb = flint_vec_get(ENFPB, ibase + iex)
                                        ip0 = flint_vec_get(ENFPT, ipb)
                                        e_pre_declare(ibd, ip0)
                                    }
                                }
                            }
                        }
                    }
                } else {
                    e_skip_balanced()
                }
                e_skip()
                ppos = e_pos()
                mut bt: i64 = 0
                if e_peek() == 40 {
                    e_adv()
                    e_skip()
                    bw = e_word()
                    flint_vec_set(EC, 0, ppos)
                    if bw == "block" {
                        bt = e_infer_block_tail()
                    } else {
                        bt = e_infer_init()
                    }
                }
                if firstm == 1 {
                    mt = bt
                    firstm = 0
                } else {
                    if bt != mt {
                        agree = 0
                    }
                }
                e_skip()
                if e_peek() == 41 {
                    e_adv()
                }
            } else {
                go = 0
            }
        }
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    }
    if agree == 0 {
        0
    } else {
        mt
    }
}
# Infer the typecode of a top-level initializer WITHOUT emitting (scan
# pass). Cursor at the init form; consumed through it. Covers the shapes
# stage sources use (literals, calls, vars, index, bin, struct/enum).
fn e_infer_init() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        tag = e_word()
        if tag == "num" {
            e_skip_rest()
            1
        } else {
            if tag == "str" {
                e_skip_str_tail()
                3
            } else {
                if tag == "true" {
                    e_skip_rest()
                    1
                } else {
                    if tag == "false" {
                        e_skip_rest()
                        1
                    } else {
                        if tag == "array" {
                            e_skip_rest()
                            4
                        } else {
                            if tag == "slice" {
                                e_skip_rest()
                                4
                            } else {
                                if tag == "map-lit" {
                                    e_skip_rest()
                                    6
                                } else {
                                    if tag == "struct-lit" {
                                        e_skip()
                                        snm = e_word()
                                        sc = e_ent_lookup(snm)
                                        e_skip_rest()
                                        if sc == -1 {
                                            EERR = EERR + 1
                                            0
                                        } else {
                                            sc
                                        }
                                    } else {
                                        if tag == "enum-lit" {
                                            e_skip()
                                            enm = e_word()
                                            ec = e_ent_lookup(enm)
                                            e_skip_rest()
                                            if ec == -1 {
                                                EERR = EERR + 1
                                                0
                                            } else {
                                                ec
                                            }
                                        } else {
                                            if tag == "var" {
                                                e_skip()
                                                vn = e_word()
                                                e_skip_rest()
                                                if ETYPEMAP.has(vn) == 1 {
                                                    ETYPEMAP.get(vn)
                                                } else {
                                                    EERR = EERR + 1
                                                    print("emit error: unknown name in global init")
                                                    print(vn)
                                                    0
                                                }
                                            } else {
                                                if tag == "index" {
                                                    e_skip_rest()
                                                    1
                                                } else {
                                                    if tag == "field" {
                                                        e_skip_rest()
                                                        EERR = EERR + 1
                                                        print("emit error: field global init needs annotation")
                                                        0
                                                    } else {
                                                        if tag == "bin" {
                                                            e_skip()
                                                            bo = e_word()
                                                            lc = e_infer_init()
                                                            rc = e_infer_init()
                                                            e_skip_rest()
                                                            if lc == 2 {
                                                                2
                                                            } else {
                                                                1
                                                            }
                                                        } else {
                                                            if tag == "lambda" {
                                                                e_skip_rest()
                                                                8
                                                            } else {
                                                                if tag == "call" {
                                                                    e_skip()
                                                                    cn = e_word()
                                                                    if cn == "print" {
                                                                        e_skip_rest()
                                                                        0
                                                                    } else {
                                                                        if cn == "len" {
                                                                            e_skip_rest()
                                                                            1
                                                                        } else {
                                                                            si = e_sig_lookup(cn)
                                                                            if si == -1 {
                                                                                rs = e_rt_sig(cn)
                                                                                if rs == "" {
                                                                                    e_skip_rest()
                                                                                    EERR = EERR + 1
                                                                                    0
                                                                                } else {
                                                                                    e_skip_rest()
                                                                                    flint_str_char_at(rs, 0) - 48
                                                                                }
                                                                            } else {
                                                                                e_skip_rest()
                                                                                flint_vec_get(EFNRET, si)
                                                                            }
                                                                        }
                                                                    }
                                                                } else {
                                                                    if tag == "decl" {
                                                                        e_skip_rest()
                                                                        0
                                                                    } else {
                                                                        if tag == "assign" {
                                                                            e_skip_rest()
                                                                            0
                                                                        } else {
                                                                            if tag == "return" {
                                                                                e_skip_rest()
                                                                                0
                                                                            } else {
                                                                                if tag == "break" {
                                                                                    e_skip_rest()
                                                                                    0
                                                                                } else {
                                                                                    if tag == "continue" {
                                                                                        e_skip_rest()
                                                                                        0
                                                                                    } else {
                                                                                        if tag == "while" {
                                                                                            e_skip_rest()
                                                                                            0
                                                                                        } else {
                                                                                            if tag == "for" {
                                                                                                e_skip_rest()
                                                                                                0
                                                                                            } else {
                                                                                                if tag == "idx-set" {
                                                                                                    e_skip_rest()
                                                                                                    0
                                                                                                } else {
                                                                                                    if tag == "expr" {
                                                                                                        e_skip()
                                                                                                        r2 = e_infer_init()
                                                                                                        e_skip()
                                                                                                        if e_peek() == 41 {
                                                                                                            e_adv()
                                                                                                        }
                                                                                                        r2
                                                                                                    } else {
                                                                                                        if tag == "if" {
                                                                                                            e_infer_if()
                                                                                                        } else {
                                                                                                            if tag == "match" {
                                                                                                                e_infer_match()
                                                                                                            } else {
                                                                                                                if tag == "ref" {
                                                                                                                    e_skip_rest()
                                                                                                                    8
                                                                                                                } else {
                                                                                                                    if tag == "deref" {
                                                                                                                        e_skip_rest()
                                                                                                                        1
                                                                                                                    } else {
                                                                                                                        if tag == "compound-assign" {
                                                                                                                            e_skip_rest()
                                                                                                                            0
                                                                                                                        } else {
                                                                                                                            if tag == "method" {
                                                                                                                                e_skip()
                                                                                                                                if e_peek() == 40 {
                                                                                                                                    e_skip_value()
                                                                                                                                }
                                                                                                                                e_skip()
                                                                                                                                mn = e_word()
                                                                                                                                e_skip_rest()
                                                                                                                                if mn == "set" {
                                                                                                                                    0
                                                                                                                                } else {
                                                                                                                                    1
                                                                                                                                }
                                                                                                                            } else {
                                                                                                                                e_skip_rest()
                                                                                                                                0
                                                                                                                            }
                                                                                                                        }
                                                                                                                    }
                                                                                                                }
                                                                                                            }
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    } else {
        w = e_word()
        if w == "-" {
            0
        } else {
            1
        }
    }
}
# Scan `(decl KIND NAME TYPE INIT)` at top level; cursor past `decl`.
# Records the global (inits emit in main prologue, in order).
fn e_scan_global() -> i64 {
    e_skip()
    k = e_word()
    nm = e_word()
    ty = e_word()
    gi = flint_vec_len(EGCODE)
    EGNAME.set(nm, gi)
    flint_vec_push(EGCODE, 0)
    flint_vec_push(EGOff, 0)
    flint_vec_push(EGLen, 0)
    noff = flint_str_length(EGTEXT)
    EGTEXT = EGTEXT + nm
    flint_vec_push(EGNameOff, noff)
    flint_vec_push(EGNameLen, flint_str_length(nm))
    # Capture init text (rewind + balanced capture via positions).
    e_skip()
    istart = e_pos()
    icode = e_infer_init()
    iend = e_pos()
    itext = flint_str_substring(ESRC, istart, iend)
    if ty == "-" {
        flint_vec_set(EGCODE, gi, icode)
    } else {
        ac = e_ann_code(ty)
        if ac == 0 {
            EERR = EERR + 1
            print("emit error: bad global type")
            print(nm)
            return 0
        }
        flint_vec_set(EGCODE, gi, ac)
    }
    if icode == 0 {
        if ty == "-" {
            EERR = EERR + 1
            print("emit error: void global init")
            print(nm)
            return 0
        }
    }
    off = flint_str_length(EGTEXT)
    EGTEXT = EGTEXT + itext
    flint_vec_set(EGOff, gi, off)
    flint_vec_set(EGLen, gi, flint_str_length(itext))
    EMAP.set(nm, ESCOPE)
    ETYPEMAP.set(nm, flint_vec_get(EGCODE, gi))
    1
}
# Emit `@NAME = global T zeroinitializer` decls (to module top) + init
# stores (inline, in order) for all scanned globals. Called once from main.
fn e_emit_prologue_globals() -> i64 {
    mut gi: i64 = 0
    top = flint_vec_len(EGCODE)
    mut ok: i64 = 1
    while gi < top {
        no = flint_vec_get(EGNameOff, gi)
        nl = flint_vec_get(EGNameLen, gi)
        gnm = flint_str_substring(EGTEXT, no, no + nl)
        gc = flint_vec_get(EGCODE, gi)
        e_emit_glob("@" + gnm + " = global " + e_llvm_typecode(gc) + " zeroinitializer\n")
        io = flint_vec_get(EGOff, gi)
        il = flint_vec_get(EGLen, gi)
        iv = e_eval_global(io, il)
        ic = ETYPE
        if ic == gc {
            e_emit("  store " + e_llvm_typecode(gc) + " " + iv + ", ptr @" + gnm + "\n")
        } else {
            esv = EERR
            cv = e_conv(iv, ic, gc)
            er2 = EERR
            if er2 == esv {
                e_emit("  store " + e_llvm_typecode(gc) + " " + cv + ", ptr @" + gnm + "\n")
            } else {
                print("emit error: global init mismatch")
                print(gnm)
                ok = 0
            }
        }
        gi = gi + 1
    }
    ok
}
# Sub-emit stored global init text (like defaults, separate scratch).
fn e_eval_global(off: i64, len: i64) -> str {
    saved = ESRC
    savedp = e_pos()
    ESRC = flint_str_substring(EGTEXT, off, off + len)
    flint_vec_set(EC, 0, 0)
    v = e_expr()
    c = ETYPE
    ESRC = saved
    flint_vec_set(EC, 0, savedp)
    ETYPE = c
    v
}
# (slice A L R): clamped copy like C++ flint_array_slice (start<0→0,
# end>len→len, empty when start>=end). Arrays only. Yields fresh array.
fn e_slice() -> str {
    a = e_expr()
    ac = ETYPE
    l = e_expr()
    lc = ETYPE
    r = e_expr()
    rc = ETYPE
    if ac != 4 {
        EERR = EERR + 1
        print("emit error: slice needs an array in G7")
        return ""
    }
    if lc != 1 {
        EERR = EERR + 1
        print("emit error: slice bounds need i64")
        return ""
    }
    if rc != 1 {
        EERR = EERR + 1
        print("emit error: slice bounds need i64")
        return ""
    }
    dp = e_fresh()
    e_emit("  " + dp + " = extractvalue {{ptr, i64}} " + a + ", 0\n")
    ln = e_fresh()
    e_emit("  " + ln + " = extractvalue {{ptr, i64}} " + a + ", 1\n")
    c0 = e_fresh()
    e_emit("  " + c0 + " = icmp slt i64 " + l + ", 0\n")
    s1 = e_fresh()
    e_emit("  " + s1 + " = select i1 " + c0 + ", i64 0, i64 " + l + "\n")
    c1 = e_fresh()
    e_emit("  " + c1 + " = icmp sgt i64 " + r + ", " + ln + "\n")
    e1 = e_fresh()
    e_emit("  " + e1 + " = select i1 " + c1 + ", i64 " + ln + ", i64 " + r + "\n")
    raw = e_fresh()
    e_emit("  " + raw + " = sub i64 " + e1 + ", " + s1 + "\n")
    c2 = e_fresh()
    e_emit("  " + c2 + " = icmp sgt i64 " + raw + ", 0\n")
    cnt = e_fresh()
    e_emit("  " + cnt + " = select i1 " + c2 + ", i64 " + raw + ", i64 0\n")
    buf = e_fresh()
    e_emit("  " + buf + " = alloca i64, i64 " + cnt + "\n")
    cb = e_label("slice.cond.")
    bb = e_label("slice.body.")
    eb = e_label("slice.end.")
    ix = e_fresh()
    e_emit("  " + ix + " = alloca i64\n")
    e_emit("  store i64 0, ptr " + ix + "\n")
    e_emit("  br label %" + cb + "\n")
    e_emit(cb + ":\n")
    ECUR = cb
    cur = e_fresh()
    e_emit("  " + cur + " = load i64, ptr " + ix + "\n")
    cc = e_fresh()
    e_emit("  " + cc + " = icmp slt i64 " + cur + ", " + cnt + "\n")
    e_emit("  br i1 " + cc + ", label %" + bb + ", label %" + eb + "\n")
    e_emit(bb + ":\n")
    ECUR = bb
    saved_b = EBREAK
    saved_c = ECONT
    EBREAK = eb
    ECONT = eb
    src = e_fresh()
    e_emit("  " + src + " = add i64 " + s1 + ", " + cur + "\n")
    ep = e_fresh()
    e_emit("  " + ep + " = getelementptr i64, ptr " + dp + ", i64 " + src + "\n")
    ev = e_fresh()
    e_emit("  " + ev + " = load i64, ptr " + ep + "\n")
    dp2 = e_fresh()
    e_emit("  " + dp2 + " = getelementptr i64, ptr " + buf + ", i64 " + cur + "\n")
    e_emit("  store i64 " + ev + ", ptr " + dp2 + "\n")
    nxt = e_fresh()
    e_emit("  " + nxt + " = add i64 " + cur + ", 1\n")
    e_emit("  store i64 " + nxt + ", ptr " + ix + "\n")
    e_emit("  br label %" + cb + "\n")
    EBREAK = saved_b
    ECONT = saved_c
    ETERM = 0
    e_emit(eb + ":\n")
    ECUR = eb
    s0 = e_fresh()
    e_emit("  " + s0 + " = insertvalue {{ptr, i64}} undef, ptr " + buf + ", 0\n")
    s1b = e_fresh()
    e_emit("  " + s1b + " = insertvalue {{ptr, i64}} " + s0 + ", i64 " + cnt + ", 1\n")
    ETYPE = 4
    s1b
}
fn e_var_rd(name: str) -> str {
    if ELAMMAP.has(name) == 1 {
        EERR = EERR + 1
        print("emit error: lambdas cannot be passed as values")
        print(name)
        return ""
    }
    t = e_fresh()
    mut code: i64 = 1
    if ETYPEMAP.has(name) == 1 {
        code = ETYPEMAP.get(name)
    } else {
        EERR = EERR + 1
        print("emit error: undefined variable")
        print(name)
        return ""
    }
    if EGNAME.has(name) == 1 {
        e_emit("  " + t + " = load " + e_llvm_typecode(code) + ", ptr @" + name + "\n")
        ETYPE = code
        t
    } else {
        if code == 2 {
            e_emit("  " + t + " = load double, ptr " + e_var_addr(name) + "\n")
        } else {
            if code == 3 {
                e_emit("  " + t + " = load ptr, ptr " + e_var_addr(name) + "\n")
            } else {
                if code == 4 {
                    e_emit("  " + t + " = load {{ptr, i64}}, ptr " + e_var_addr(name) + "\n")
                } else {
                    if code == 1 {
                        e_emit("  " + t + " = load i64, ptr " + e_var_addr(name) + "\n")
                    } else {
                        e_emit("  " + t + " = load " + e_llvm_typecode(code) + ", ptr " + e_var_addr(name) + "\n")
                    }
                }
            }
        }
        ETYPE = code
        t
    }
}
# Calls. `print` builtin dispatches on arg typecode; other names resolve
# via the pre-scanned registry (positional args, defaults fill trailing
# missing params, i64->f64 promotes, variadics pass through).
# Parses args up to `)`; the closing paren belongs to the caller.
fn e_call(name: str) -> str {
    if ELAMMAP.has(name) == 1 {
        e_lambda_call(name)
    } else {
        if name == "print" {
            a = e_expr()
            ac = ETYPE
            if ac == 2 {
                e_emit("  call void @flint_println_f64(double " + a + ")\n")
            } else {
                if ac == 3 {
                    e_emit("  call void @flint_println_str(ptr " + a + ")\n")
                } else {
                    if ac == 1 {
                        e_emit("  call void @flint_println_i64(i64 " + a + ")\n")
                    } else {
                        EERR = EERR + 1
                        print("emit error: print needs i64/f64/str in G3")
                        print(name)
                    }
                }
            }
            ETYPE = 0
            ""
        } else {
            if name == "len" {
                la = e_expr()
                lac = ETYPE
                if lac == 4 {
                    lt = e_fresh()
                    e_emit("  " + lt + " = extractvalue {{ptr, i64}} " + la + ", 1\n")
                    ETYPE = 1
                    lt
                } else {
                    if lac == 3 {
                        lt2 = e_fresh()
                        e_emit("  " + lt2 + " = call i64 @flint_str_length(ptr " + la + ")\n")
                        ETYPE = 1
                        lt2
                    } else {
                        if lac == 6 {
                            lt3 = e_fresh()
                            e_rt_declare("flint_map_len", e_rt_sig("flint_map_len"))
                            e_emit("  " + lt3 + " = call i64 @flint_map_len(ptr " + la + ")\n")
                            ETYPE = 1
                            lt3
                        } else {
                            EERR = EERR + 1
                            print("emit error: len needs array, str or map")
                            ""
                        }
                    }
                }
            } else {
                idx = e_sig_lookup(name)
                if idx == -1 {
                    rs = e_rt_sig(name)
                    if rs == "" {
                        EERR = EERR + 1
                        print("emit error: unknown function")
                        print(name)
                        ""
                    } else {
                        e_rt_call(name, rs)
                    }
                } else {
                    n = flint_vec_get(EFNN, idx)
                    base = flint_vec_get(EFNPB, idx)
                    varg = flint_vec_get(EFNVAR, idx)
                    ret = flint_vec_get(EFNRET, idx)
                    fixed = n - varg
                    sb = flint_sb_new()
                    mut i: i64 = 0
                    mut ok: i64 = 1
                    mut go: i64 = 1
                    while go == 1 {
                        e_skip()
                        if e_peek() == 41 {
                            go = 0
                        } else {
                            if i > 0 {
                                flint_sb_append(sb, ", ")
                            }
                            a = e_expr()
                            ac = ETYPE
                            if i < fixed {
                                want = flint_vec_get(EFPTYPE, base + i)
                                esv = EERR
                                cv = e_conv(a, ac, want)
                                er2 = EERR
                                if er2 == esv {
                                    flint_sb_append(sb, e_llvm_typecode(want) + " " + cv)
                                } else {
                                    print("emit error: arg type mismatch calling")
                                    print(name)
                                    ok = 0
                                }
                            } else {
                                if varg == 1 {
                                    if ac == 0 {
                                        EERR = EERR + 1
                                        print("emit error: void variadic arg")
                                        ok = 0
                                    } else {
                                        flint_sb_append(sb, e_llvm_typecode(ac) + " " + a)
                                    }
                                } else {
                                    EERR = EERR + 1
                                    print("emit error: too many args calling")
                                    print(name)
                                    ok = 0
                                }
                            }
                            i = i + 1
                        }
                    }
                    while i < fixed {
                        if i > 0 {
                            flint_sb_append(sb, ", ")
                        }
                        want2 = flint_vec_get(EFPTYPE, base + i)
                        off = flint_vec_get(EFPOFF, base + i)
                        if off == -1 {
                            EERR = EERR + 1
                            print("emit error: missing arg, no default calling")
                            print(name)
                            ok = 0
                            i = fixed
                        } else {
                            ln = flint_vec_get(EFPLEN, base + i)
                            d = e_eval_default(off, ln)
                            dc = ETYPE
                            esv2 = EERR
                            dv = e_conv(d, dc, want2)
                            er3 = EERR
                            if er3 == esv2 {
                                flint_sb_append(sb, e_llvm_typecode(want2) + " " + dv)
                            } else {
                                print("emit error: default type mismatch calling")
                                print(name)
                                ok = 0
                            }
                            i = i + 1
                        }
                    }
                    argstr = flint_sb_build(sb)
                    flint_sb_free(sb)
                    if ok == 0 {
                        ETYPE = 0
                        ""
                    } else {
                        if ret == 0 {
                            e_emit("  call void @" + name + "(" + argstr + ")\n")
                            ETYPE = 0
                            ""
                        } else {
                            t3 = e_fresh()
                            e_emit("  " + t3 + " = call " + e_llvm_typecode(ret) + " @" + name + "(" + argstr + ")\n")
                            ETYPE = ret
                            t3
                        }
                    }
                }
            }
        }
    }
}
fn e_expr() -> str {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        tag = e_word()
        r = e_expr_tagged(tag)
        e_skip()
        if e_peek() == 41 {
            e_adv()
            r
        } else {
            EERR = EERR + 1
            r
        }
    } else {
        EERR = EERR + 1
        e_adv()
        ""
    }
}
fn e_expr_tagged(tag: str) -> str {
    if tag == "num" {
        e_num()
    } else {
        if tag == "expr" {
            # Wrapper around a nested expression (statement position).
            e_expr()
        } else {
            if tag == "str" {
                e_str_lit()
            } else {
                if tag == "var" {
                    e_skip()
                    nm = e_word()
                    e_var_rd(nm)
                } else {
                    if tag == "call" {
                        e_skip()
                        nm = e_word()
                        e_call(nm)
                    } else {
                        if tag == "bin" {
                            e_skip()
                            op = e_word()
                            e_bin(op)
                        } else {
                            if tag == "neg" {
                                e = e_expr()
                                t = e_fresh()
                                e_emit("  " + t + " = sub i64 0, " + e + "\n")
                                ETYPE = 1
                                t
                            } else {
                                if tag == "not" {
                                    e = e_expr()
                                    t = e_fresh()
                                    e_emit("  " + t + " = icmp eq i64 " + e + ", 0\n")
                                    e_emit_to_i64(t)
                                } else {
                                    if tag == "true" {
                                        ETYPE = 1
                                        "1"
                                    } else {
                                        if tag == "false" {
                                            ETYPE = 1
                                            "0"
                                        } else {
                                            if tag == "if" {
                                                e_if_expr()
                                            } else {
                                                if tag == "array" {
                                                    e_array()
                                                } else {
                                                    if tag == "index" {
                                                        e_index()
                                                    } else {
                                                        if tag == "idx-set" {
                                                            e_idx_set()
                                                        } else {
                                                            if tag == "struct-lit" {
                                                                e_struct_lit()
                                                            } else {
                                                                if tag == "field" {
                                                                    e_field()
                                                                } else {
                                                                    if tag == "enum-lit" {
                                                                        e_enum_lit()
                                                                    } else {
                                                                        if tag == "match" {
                                                                            e_match()
                                                                        } else {
                                                                            if tag == "map-lit" {
                                                                                e_map_lit()
                                                                            } else {
                                                                                if tag == "method" {
                                                                                    e_method()
                                                                                } else {
                                                                                    if tag == "ref" {
                                                                                        e_ref()
                                                                                    } else {
                                                                                        if tag == "deref" {
                                                                                            e_deref()
                                                                                        } else {
                                                                                            if tag == "slice" {
                                                                                                e_slice()
                                                                                            } else {
                                                                                                if tag == "unwrap" {
                                                                                                    e_unwrap()
                                                                                                } else {
                                                                                                    if tag == "try" {
                                                                                                        e_unwrap()
                                                                                                    } else {
                                                                                                        if tag == "lambda" {
                                                                                                            EERR = EERR + 1
                                                                                                            print("emit error: lambda must be bound")
                                                                                                            ""
                                                                                                        } else {
                                                                                                            EERR = EERR + 1
                                                                                                            print("emit error: node needs a later group")
                                                                                                            print(tag)
                                                                                                            e_skip_balanced()
                                                                                                            ""
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
# Skip one balanced S-expr (or single token) for error recovery. Always
# consumes input (or hits end), so loops terminate. String-aware.
# Exact-consume the tail of an S-expr string (cursor after the `str`
# word): LEN, one space, LEN verbatim chars, `)`. Raw parens in string
# content must not disturb depth counting (see e_skip_depth).
fn e_skip_str_tail() -> i64 {
    e_skip()
    ln = e_read_num_raw()
    n = flint_str_to_i64(ln)
    if e_peek() == 32 {
        e_adv()
    } else {
        EERR = EERR + 1
        return 0
    }
    mut k: i64 = 0
    while k < n {
        e_adv()
        k = k + 1
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
        1
    } else {
        EERR = EERR + 1
        0
    }
}
fn e_skip_balanced() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        bw = e_word()
        if bw == "str" {
            e_skip_str_tail()
        } else {
            e_skip_depth(1)
        }
    } else {
        e_adv()
    }
    0
}
# ---- statements (sequential, into EOUT) ----
# (decl KIND NAME TYPE INIT): alloca + store. KIND ignored for codegen
# (mutability is check-time); TYPE `-` infers from init.
fn e_decl() -> i64 {
    k = e_word()
    nm = e_word()
    ty = e_word()
    e_skip()
    if e_peek() == 40 {
        psv = e_pos()
        e_adv()
        e_skip()
        tw = e_word()
        flint_vec_set(EC, 0, psv)
        if tw == "lambda" {
            e_adv()
            e_skip()
            e_word()
            e_decl_lambda(nm)
            if ELAMMAP.has(nm) == 1 {
                lh = ELAMMAP.get(nm)
                e_declare_var(nm, 8, "@lam." + flint_i64_to_string(lh))
                1
            } else {
                1
            }
        } else {
            e_decl_value(nm, ty)
        }
    } else {
        e_decl_value(nm, ty)
    }
}
# Non-lambda declarator (cursor at init, before it).
fn e_decl_value(nm: str, ty: str) -> i64 {
    init = e_expr()
    mut code: i64 = ETYPE
    if code == 0 {
        EERR = EERR + 1
        print("emit error: void initializer")
        return 0
    }
    if ty == "-" {
        1
    } else {
        code = e_ann_code(ty)
    }
    if code == 1 {
        e_declare_var(nm, 1, init)
    } else {
        if code == 2 {
            e_declare_var(nm, 2, init)
        } else {
            if code == 4 {
                e_declare_var(nm, 4, init)
            } else {
                if code == 3 {
                    e_declare_var(nm, 3, init)
                } else {
                    e_declare_var(nm, code, init)
                }
            }
        }
    }
    1
}
fn e_ann_code(ty: str) -> i64 {
    if ty == "i64" {
        1
    } else {
        if ty == "f64" {
            2
        } else {
            if ty == "str" {
                3
            } else {
                if ty == "bool" {
                    # bool is i64 0/1 in this codegen (comparisons zext).
                    1
                } else {
                    if ty == "[i64]" {
                        4
                    } else {
                        if ty == "map" {
                            6
                        } else {
                            if ty == "ptr" {
                                8
                            } else {
                                ec = e_ent_lookup(ty)
                                if ec == -1 {
                                    0
                                } else {
                                    ec
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
# (assign NAME EXPR): store to existing alloca.
fn e_assign() -> i64 {
    nm = e_word()
    if ELAMMAP.has(nm) == 1 {
        EERR = EERR + 1
        print("emit error: cannot reassign lambda")
        print(nm)
        return 0
    }
    init = e_expr()
    code = ETYPE
    if EMAP.has(nm) == 0 {
        EERR = EERR + 1
        print("emit error: assign to undeclared")
        print(nm)
        return 0
    }
    e_store_to(nm, init, code)
}
# Store value text (of given typecode) to a local alloca or @global.
fn e_store_to(nm: str, val: str, code: i64) -> i64 {
    if EGNAME.has(nm) == 1 {
        e_emit("  store " + e_llvm_typecode(code) + " " + val + ", ptr @" + nm + "\n")
        1
    } else {
        if code == 2 {
            e_emit("  store double " + val + ", ptr " + e_var_addr(nm) + "\n")
        } else {
            if code == 3 {
                e_emit("  store ptr " + val + ", ptr " + e_var_addr(nm) + "\n")
            } else {
                if code == 4 {
                    e_emit("  store {{ptr, i64}} " + val + ", ptr " + e_var_addr(nm) + "\n")
                } else {
                    if code == 1 {
                        e_emit("  store i64 " + val + ", ptr " + e_var_addr(nm) + "\n")
                    } else {
                        e_emit("  store " + e_llvm_typecode(code) + " " + val + ", ptr " + e_var_addr(nm) + "\n")
                    }
                }
            }
        }
        1
    }
}
# (compound-assign OP NAME VAL) statement: NAME = NAME OP VAL (mirrors the
# C++ desugar; strings/arrays reuse concat).
fn e_compound() -> i64 {
    e_skip()
    op = e_word()
    nm = e_word()
    if EMAP.has(nm) == 0 {
        EERR = EERR + 1
        print("emit error: assign to undeclared")
        print(nm)
        return 0
    }
    l = e_var_rd(nm)
    lc = ETYPE
    r = e_expr()
    rc = ETYPE
    if lc != rc {
        EERR = EERR + 1
        print("emit error: mixed-type binop needs conversion")
        return 0
    }
    mut v: str = ""
    if lc == 3 {
        v = e_bin_concat(op, l, r, lc)
    } else {
        if lc == 4 {
            v = e_bin_concat(op, l, r, lc)
        } else {
            if lc == 1 {
                v = e_bin_dispatch(op, l, r, 0)
            } else {
                if lc == 2 {
                    v = e_bin_dispatch(op, l, r, 1)
                } else {
                    EERR = EERR + 1
                    print("emit error: bad compound operand")
                    return 0
                }
            }
        }
    }
    vc = ETYPE
    e_store_to(nm, v, vc)
}
# (ref X): address of a variable (its alloca). Yields code 8 (opaque ptr).
fn e_ref() -> str {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        w = e_word()
        if w == "var" {
            e_skip()
            nm = e_word()
            e_skip()
            if e_peek() == 41 {
                e_adv()
            } else {
                EERR = EERR + 1
                return ""
            }
            if EMAP.has(nm) == 0 {
                EERR = EERR + 1
                print("emit error: ref of undeclared")
                print(nm)
                return ""
            }
            if EGNAME.has(nm) == 1 {
                ETYPE = 8
                "@" + nm
            } else {
                ETYPE = 8
                e_var_addr(nm)
            }
        } else {
            EERR = EERR + 1
            print("emit error: ref needs a variable in G7")
            ""
        }
    } else {
        EERR = EERR + 1
        print("emit error: ref needs a variable in G7")
        ""
    }
}
# (deref P): raw i64 load through a pointer value (any ptr family).
fn e_deref() -> str {
    p = e_expr()
    pc = ETYPE
    mut okp: i64 = 0
    if pc == 3 {
        okp = 1
    } else {
        if pc == 6 {
            okp = 1
        } else {
            if pc == 7 {
                okp = 1
            } else {
                if pc == 8 {
                    okp = 1
                }
            }
        }
    }
    if okp == 0 {
        EERR = EERR + 1
        print("emit error: deref needs a pointer")
        return ""
    }
    t = e_fresh()
    e_emit("  " + t + " = load i64, ptr " + p + "\n")
    ETYPE = 1
    t
}
# (return [X]). Bare: zero of current ret (void -> ret void). Valued:
# exact type, or i64->f64 promote. main truncates i64 to i32 exit code.
fn e_return() -> i64 {
    e_skip()
    if e_peek() == 41 {
        if EFNMAIN == 1 {
            e_emit("  ret i32 0\n")
            1
        } else {
            if EFNRET_CUR == 0 {
                e_emit("  ret void\n")
                1
            } else {
                e_emit("  ret " + e_llvm_typecode(EFNRET_CUR) + " " + e_llvm_zero(EFNRET_CUR) + "\n")
                1
            }
        }
    } else {
        v = e_expr()
        c = ETYPE
        if EFNMAIN == 1 {
            if c == 1 {
                r = e_fresh()
                e_emit("  " + r + " = trunc i64 " + v + " to i32\n")
                e_emit("  ret i32 " + r + "\n")
                1
            } else {
                EERR = EERR + 1
                print("emit error: main must return i64 in G2")
                0
            }
        } else {
            if c == EFNRET_CUR {
                e_emit("  ret " + e_llvm_typecode(c) + " " + v + "\n")
                1
            } else {
                if c == 1 {
                    if EFNRET_CUR == 2 {
                        t = e_fresh()
                        e_emit("  " + t + " = sitofp i64 " + v + " to double\n")
                        e_emit("  ret double " + t + "\n")
                        1
                    } else {
                        EERR = EERR + 1
                        print("emit error: return type mismatch")
                        0
                    }
                } else {
                    EERR = EERR + 1
                    print("emit error: return type mismatch")
                    0
                }
            }
        }
    }
}
# ---- G1: binops, if/while, break/continue, ETERM discipline ----
# ETERM protocol: return/break/continue set 1; e_block clears on entry;
# non-terminator statements clear it (via block loop reset — see e_block);
# e_block returns 0 error, 1 open, 2 terminated. if-stmt recomputes from
# arms; while never terminates outer; fn end emits implicit ret if open.
# (bin OP L R). G1: i64/i64 and f64/f64 (mixed -> G2 error).
# Int +-*: overflow intrinsic + panicBB; /, %: zero guard; comparisons and
# &&/||/!/not produce i64 0/1 (icmp/fcmp + zext, mirroring C++).
fn e_bin(op: str) -> str {
    l = e_expr()
    lc = ETYPE
    r = e_expr()
    rc = ETYPE
    mut isf: i64 = 0
    if lc == 2 {
        isf = 1
    } else {
        if rc == 2 {
            isf = 1
        }
    }
    if lc != rc {
        EERR = EERR + 1
        print("emit error: mixed-type binop needs conversion")
        return ""
    }
    # G3/G6: string/array ops via runtime. Factored for compound-assign.
    if lc == 3 {
        e_bin_concat(op, l, r, lc)
    } else {
        if lc == 4 {
            e_bin_concat(op, l, r, lc)
        } else {
            if lc == 1 {
                e_bin_dispatch(op, l, r, isf)
            } else {
                if lc == 2 {
                    e_bin_dispatch(op, l, r, isf)
                } else {
                    if lc == 0 {
                        EERR = EERR + 1
                        print("emit error: void binop operand")
                        ""
                    } else {
                        EERR = EERR + 1
                        print("emit error: binop needs numeric/str/array")
                        ""
                    }
                }
            }
        }
    }
}
# String/array binops via runtime calls (shared by e_bin, e_compound).
fn e_bin_concat(op: str, l: str, r: str, lc: i64) -> str {
    if lc == 3 {
        if op == "+" {
            t = e_fresh()
            e_emit("  " + t + " = call ptr @flint_str_concat(ptr " + l + ", ptr " + r + ")\n")
            ETYPE = 3
            t
        } else {
            if op == "==" {
                t = e_fresh()
                e_rt_declare("flint_str_compare", e_rt_sig("flint_str_compare"))
                e_emit("  " + t + " = call i64 @flint_str_compare(ptr " + l + ", ptr " + r + ")\n")
                t2 = e_fresh()
                e_emit("  " + t2 + " = icmp eq i64 " + t + ", 0\n")
                e_emit_to_i64(t2)
            } else {
                if op == "!=" {
                    t3 = e_fresh()
                    e_rt_declare("flint_str_compare", e_rt_sig("flint_str_compare"))
                    e_emit("  " + t3 + " = call i64 @flint_str_compare(ptr " + l + ", ptr " + r + ")\n")
                    t4 = e_fresh()
                    e_emit("  " + t4 + " = icmp ne i64 " + t3 + ", 0\n")
                    e_emit_to_i64(t4)
                } else {
                    EERR = EERR + 1
                    print("emit error: strings support only +/==/!= in G6")
                    ""
                }
            }
        }
    } else {
        if op == "+" {
            t5 = e_fresh()
            e_emit("  " + t5 + " = call {{ptr, i64}} @flint_array_concat({{ptr, i64}} " + l + ", {{ptr, i64}} " + r + ")\n")
            ETYPE = 4
            t5
        } else {
            EERR = EERR + 1
            print("emit error: arrays support only + in G3")
            ""
        }
    }
}
# Dispatch numeric binops (G1 bodies, factored for the G3 type gate).
fn e_bin_dispatch(op: str, l: str, r: str, isf: i64) -> str {
    if op == "+" {
        e_bin_add(l, r, isf)
    } else {
        if op == "-" {
            e_bin_sub(l, r, isf)
        } else {
            if op == "*" {
                e_bin_mul(l, r, isf)
            } else {
                if op == "/" {
                    e_bin_div(l, r, isf)
                } else {
                    if op == "%" {
                        e_bin_mod(l, r, isf)
                    } else {
                        e_bin_cmp(op, l, r, isf)
                    }
                }
            }
        }
    }
}
fn e_bin_add(l: str, r: str, isf: i64) -> str {
    if isf == 1 {
        t = e_fresh()
        e_emit("  " + t + " = fadd double " + l + ", " + r + "\n")
        ETYPE = 2
        t
    } else {
        ov = e_fresh()
        e_emit("  " + ov + " = call {{i64, i1}} @llvm.sadd.with.overflow.i64(i64 " + l + ", i64 " + r + ")\n")
        v = e_fresh()
        e_emit("  " + v + " = extractvalue {{i64, i1}} " + ov + ", 0\n")
        o = e_fresh()
        e_emit("  " + o + " = extractvalue {{i64, i1}} " + ov + ", 1\n")
        pb = e_label("arith_panic.")
        ob = e_label("arith_ok.")
        e_emit("  br i1 " + o + ", label %" + pb + ", label %" + ob + "\n")
        e_emit(pb + ":\n")
        m = e_panic_msg("integer overflow")
        e_emit("  call void @flint_panic(ptr " + m + ")\n")
        e_emit("  br label %" + ob + "\n")
        e_emit(ob + ":\n")
        ECUR = ob
        ETYPE = 1
        v
    }
}
fn e_bin_sub(l: str, r: str, isf: i64) -> str {
    if isf == 1 {
        t = e_fresh()
        e_emit("  " + t + " = fsub double " + l + ", " + r + "\n")
        ETYPE = 2
        t
    } else {
        ov = e_fresh()
        e_emit("  " + ov + " = call {{i64, i1}} @llvm.ssub.with.overflow.i64(i64 " + l + ", i64 " + r + ")\n")
        v = e_fresh()
        e_emit("  " + v + " = extractvalue {{i64, i1}} " + ov + ", 0\n")
        o = e_fresh()
        e_emit("  " + o + " = extractvalue {{i64, i1}} " + ov + ", 1\n")
        pb = e_label("arith_panic.")
        ob = e_label("arith_ok.")
        e_emit("  br i1 " + o + ", label %" + pb + ", label %" + ob + "\n")
        e_emit(pb + ":\n")
        m = e_panic_msg("integer overflow")
        e_emit("  call void @flint_panic(ptr " + m + ")\n")
        e_emit("  br label %" + ob + "\n")
        e_emit(ob + ":\n")
        ECUR = ob
        ETYPE = 1
        v
    }
}
fn e_bin_mul(l: str, r: str, isf: i64) -> str {
    if isf == 1 {
        t = e_fresh()
        e_emit("  " + t + " = fmul double " + l + ", " + r + "\n")
        ETYPE = 2
        t
    } else {
        ov = e_fresh()
        e_emit("  " + ov + " = call {{i64, i1}} @llvm.smul.with.overflow.i64(i64 " + l + ", i64 " + r + ")\n")
        v = e_fresh()
        e_emit("  " + v + " = extractvalue {{i64, i1}} " + ov + ", 0\n")
        o = e_fresh()
        e_emit("  " + o + " = extractvalue {{i64, i1}} " + ov + ", 1\n")
        pb = e_label("arith_panic.")
        ob = e_label("arith_ok.")
        e_emit("  br i1 " + o + ", label %" + pb + ", label %" + ob + "\n")
        e_emit(pb + ":\n")
        m = e_panic_msg("integer overflow")
        e_emit("  call void @flint_panic(ptr " + m + ")\n")
        e_emit("  br label %" + ob + "\n")
        e_emit(ob + ":\n")
        ECUR = ob
        ETYPE = 1
        v
    }
}
fn e_bin_div(l: str, r: str, isf: i64) -> str {
    if isf == 1 {
        t = e_fresh()
        e_emit("  " + t + " = fdiv double " + l + ", " + r + "\n")
        ETYPE = 2
        t
    } else {
        z = e_fresh()
        e_emit("  " + z + " = icmp eq i64 " + r + ", 0\n")
        pb = e_label("div_panic.")
        ob = e_label("div_ok.")
        e_emit("  br i1 " + z + ", label %" + pb + ", label %" + ob + "\n")
        e_emit(pb + ":\n")
        m = e_panic_msg("integer division by zero")
        e_emit("  call void @flint_panic(ptr " + m + ")\n")
        e_emit("  br label %" + ob + "\n")
        e_emit(ob + ":\n")
        t = e_fresh()
        e_emit("  " + t + " = sdiv i64 " + l + ", " + r + "\n")
        ECUR = ob
        ETYPE = 1
        t
    }
}
fn e_bin_mod(l: str, r: str, isf: i64) -> str {
    if isf == 1 {
        t = e_fresh()
        e_emit("  " + t + " = frem double " + l + ", " + r + "\n")
        ETYPE = 2
        t
    } else {
        z = e_fresh()
        e_emit("  " + z + " = icmp eq i64 " + r + ", 0\n")
        pb = e_label("mod_panic.")
        ob = e_label("mod_ok.")
        e_emit("  br i1 " + z + ", label %" + pb + ", label %" + ob + "\n")
        e_emit(pb + ":\n")
        m = e_panic_msg("integer modulo by zero")
        e_emit("  call void @flint_panic(ptr " + m + ")\n")
        e_emit("  br label %" + ob + "\n")
        e_emit(ob + ":\n")
        t = e_fresh()
        e_emit("  " + t + " = srem i64 " + l + ", " + r + "\n")
        ECUR = ob
        ETYPE = 1
        t
    }
}
# String global for a panic message; returns its name.
fn e_panic_msg(msg: str) -> str {
    nm = e_strname()
    tot = flint_str_length(msg) + 1
    e_emit_glob(nm + " = private unnamed_addr constant [" + flint_i64_to_string(tot) + " x i8] c\"" + msg + "\\00\"\n")
    nm
}
fn e_bin_cmp(op: str, l: str, r: str, isf: i64) -> str {
    if op == "&&" {
        lb = e_truthy(l, isf)
        rb = e_truthy(r, isf)
        t = e_fresh()
        e_emit("  " + t + " = and i1 " + lb + ", " + rb + "\n")
        e_emit_to_i64(t)
    } else {
        if op == "||" {
            lb = e_truthy(l, isf)
            rb = e_truthy(r, isf)
            t = e_fresh()
            e_emit("  " + t + " = or i1 " + lb + ", " + rb + "\n")
            e_emit_to_i64(t)
        } else {
            e_cmp_pred(op, l, r, isf)
        }
    }
}
# Value as i1 truthy (icmp/fcmp ne zero).
fn e_truthy(v: str, isf: i64) -> str {
    t = e_fresh()
    if isf == 1 {
        e_emit("  " + t + " = fcmp une double " + v + ", 0.0\n")
    } else {
        e_emit("  " + t + " = icmp ne i64 " + v + ", 0\n")
    }
    t
}
fn e_emit_to_i64(t: str) -> str {
    r = e_fresh()
    e_emit("  " + r + " = zext i1 " + t + " to i64\n")
    ETYPE = 1
    r
}
fn e_cmp_pred(op: str, l: str, r: str, isf: i64) -> str {
    mut pred: str = "eq"
    if op == "==" {
        pred = "eq"
    } else {
        if op == "!=" {
            pred = "ne"
        } else {
            if op == "<" {
                pred = "slt"
            } else {
                if op == ">" {
                    pred = "sgt"
                } else {
                    if op == "<=" {
                        pred = "sle"
                    } else {
                        if op == ">=" {
                            pred = "sge"
                        }
                    }
                }
            }
        }
    }
    t = e_fresh()
    if isf == 1 {
        mut fp: str = "oeq"
        if pred == "eq" {
            fp = "oeq"
        } else {
            if pred == "ne" {
                fp = "one"
            } else {
                if pred == "slt" {
                    fp = "olt"
                } else {
                    if pred == "sgt" {
                        fp = "ogt"
                    } else {
                        if pred == "sle" {
                            fp = "ole"
                        } else {
                            fp = "oge"
                        }
                    }
                }
            }
        }
        e_emit("  " + t + " = fcmp " + fp + " double " + l + ", " + r + "\n")
    } else {
        e_emit("  " + t + " = icmp " + pred + " i64 " + l + ", " + r + "\n")
    }
    e_emit_to_i64(t)
}
fn e_stmt() -> i64 {
    e_skip()
    if e_peek() == 40 {
        tag = e_peek_word()
        EBLOCKEXPR = 0
        mut r: i64 = 0
        if tag == "decl" {
            e_adv()
            e_skip()
            e_word()
            r = e_decl()
        } else {
            if tag == "assign" {
                e_adv()
                e_skip()
                e_word()
                r = e_assign()
            } else {
                if tag == "compound-assign" {
                    e_adv()
                    e_skip()
                    e_word()
                    r = e_compound()
                } else {
                    if tag == "return" {
                        e_adv()
                        e_skip()
                        e_word()
                        r = e_return()
                    } else {
                        if tag == "if" {
                            e_adv()
                            e_skip()
                            e_word()
                            r = e_if_stmt()
                        } else {
                            if tag == "while" {
                                e_adv()
                                e_skip()
                                e_word()
                                r = e_while()
                            } else {
                                if tag == "break" {
                                    e_adv()
                                    e_skip()
                                    e_word()
                                    r = e_break()
                                } else {
                                    if tag == "continue" {
                                        e_adv()
                                        e_skip()
                                        e_word()
                                        r = e_continue()
                                    } else {
                                        if tag == "for" {
                                            e_adv()
                                            e_skip()
                                            e_word()
                                            r = e_for()
                                        } else {
                                            # Expression statement: e_expr parses
                                            # from `(` itself INCLUDING its own
                                            # close, so return directly.
                                            e = e_expr()
                                            EBLOCKEXPR = 1
                                            EBLOCKVAL = e
                                            EBLOCKCODE = ETYPE
                                            return 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        e_skip()
        if e_peek() == 41 {
            e_adv()
            r
        } else {
            EERR = EERR + 1
            r
        }
    } else {
        EERR = EERR + 1
        e_adv()
        0
    }
}
# Lookahead: word after `(` (or "" if not there). Cursor untouched.
fn e_peek_word() -> str {
    n = flint_str_length(ESRC)
    mut p: i64 = e_pos()
    mut go: i64 = 1
    while go == 1 {
        if p < n {
            c = flint_str_char_at(ESRC, p)
            if c == 32 {
                p = p + 1
            } else {
                if c == 10 {
                    p = p + 1
                } else {
                    if c == 9 {
                        p = p + 1
                    } else {
                        if c == 13 {
                            p = p + 1
                        } else {
                            go = 0
                        }
                    }
                }
            }
        } else {
            go = 0
        }
    }
    if p < n {
        if flint_str_char_at(ESRC, p) == 40 {
            p = p + 1
            mut go2: i64 = 1
            while go2 == 1 {
                if p < n {
                    c = flint_str_char_at(ESRC, p)
                    if c == 32 {
                        p = p + 1
                    } else {
                        if c == 10 {
                            p = p + 1
                        } else {
                            go2 = 0
                        }
                    }
                } else {
                    go2 = 0
                }
            }
            sb = flint_sb_new()
            mut go3: i64 = 1
            while go3 == 1 {
                if p < n {
                    c = flint_str_char_at(ESRC, p)
                    if c == 32 {
                        go3 = 0
                    } else {
                        if c == 10 {
                            go3 = 0
                        } else {
                            if c == 40 {
                                go3 = 0
                            } else {
                                if c == 41 {
                                    go3 = 0
                                } else {
                                    flint_sb_append_char(sb, c)
                                    p = p + 1
                                }
                            }
                        }
                    }
                } else {
                    go3 = 0
                }
            }
            r = flint_sb_build(sb)
            flint_sb_free(sb)
            r
        } else {
            ""
        }
    } else {
        ""
    }
}
# Rewind past `(TAG ` so e_expr can reparse (for expression statements).
fn e_block() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        w = e_word()
        if w == "block" {
            1
        } else {
            EERR = EERR + 1
            return 0
        }
        # Fresh block: prior termination does not leak in.
        ETERM = 0
        mut go: i64 = 1
        while go == 1 {
            e_skip()
            if e_peek() == 41 {
                go = 0
            } else {
                if e_peek() == -1 {
                    go = 0
                } else {
                    if ETERM == 1 {
                        # Dead code after return/break/continue: consume for
                        # progress, emit nothing (keeps IR valid).
                        e_skip_balanced()
                    } else {
                        e_stmt()
                    }
                }
            }
        }
        e_skip()
        if e_peek() == 41 {
            e_adv()
            # 0 error, 1 open, 2 terminated.
            if ETERM == 1 {
                2
            } else {
                1
            }
        } else {
            EERR = EERR + 1
            0
        }
    } else {
        EERR = EERR + 1
        0
    }
}
# ---- module ----
# Truthiness: icmp ne against zero (i64 or f64).
fn e_truthy_emit(v: str, isf: i64) -> str {
    t = e_fresh()
    if isf == 1 {
        e_emit("  " + t + " = fcmp une double " + v + ", 0.0\n")
    } else {
        e_emit("  " + t + " = icmp ne i64 " + v + ", 0\n")
    }
    t
}
# ---- G1 control flow (br + phi, terminator tracking) ----
# Condition truthiness from a typecode: i64/f64 compare against zero,
# ptr-family (3/6/7/8) compares against null. Structs/arrays are not
# truthy (loud llvm error, mirrors C++ strictness).
fn e_cond_emit(v: str, code: i64) -> str {
    t = e_fresh()
    if code == 2 {
        e_emit("  " + t + " = fcmp une double " + v + ", 0.0\n")
    } else {
        if code == 3 {
            e_emit("  " + t + " = icmp ne ptr " + v + ", null\n")
        } else {
            if code == 6 {
                e_emit("  " + t + " = icmp ne ptr " + v + ", null\n")
            } else {
                if code == 7 {
                    e_emit("  " + t + " = icmp ne ptr " + v + ", null\n")
                } else {
                    if code == 8 {
                        e_emit("  " + t + " = icmp ne ptr " + v + ", null\n")
                    } else {
                        e_emit("  " + t + " = icmp ne i64 " + v + ", 0\n")
                    }
                }
            }
        }
    }
    t
}
# if statement: (if C T [E]) with block arms. Recomputes ETERM.
fn e_if_stmt() -> i64 {
    # Arm tail values for statement-position ifs (Flint if/else yields a
    # value when both arms end in expressions; merged with a phi like
    # if-expressions so fn-tail `if` returns correctly).
    mut a1v: str = ""
    mut a1c: i64 = 0
    mut a1x: i64 = 0
    mut a2v: str = ""
    mut a2c: i64 = 0
    mut a2x: i64 = 0
    mut in1: str = ""
    mut in2: str = ""
    c = e_expr()
    cc = ETYPE
    tb = e_label("if.then.")
    eb = e_label("if.else.")
    mb = e_label("if.end.")
    e_skip()
    if e_peek() == 41 {
        # No else: false goes straight to merge.
        e_emit("  br i1 " + e_cond_emit(c, cc) + ", label %" + tb + ", label %" + mb + "\n")
        e_emit(tb + ":\n")
        ECUR = tb
        t = e_block()
        mut then_term: i64 = 0
        if t == 2 {
            then_term = 1
        }
        if then_term == 0 {
            e_emit("  br label %" + mb + "\n")
        }
        e_emit(mb + ":\n")
        ECUR = mb
        ETERM = 0
        # No else: statement yields no value.
        EBLOCKEXPR = 0
        EBLOCKVAL = ""
        EBLOCKCODE = 0
        1
    } else {
        e_emit("  br i1 " + e_cond_emit(c, cc) + ", label %" + tb + ", label %" + eb + "\n")
        e_emit(tb + ":\n")
        ECUR = tb
        t = e_block()
        a1v = EBLOCKVAL
        a1c = EBLOCKCODE
        a1x = EBLOCKEXPR
        in1 = ECUR
        mut then_term: i64 = 0
        if t == 2 {
            then_term = 1
        }
        if then_term == 0 {
            e_emit("  br label %" + mb + "\n")
        }
        e_emit(eb + ":\n")
        ECUR = eb
        e_skip()
        if e_peek() == 41 {
            # No else form: false path falls straight to merge.
            e_emit("  br label %" + mb + "\n")
            e_emit(mb + ":\n")
            ECUR = mb
            ETERM = 0
            EBLOCKEXPR = 0
            EBLOCKVAL = ""
            EBLOCKCODE = 0
            1
        } else {
            e2 = e_block()
            a2v = EBLOCKVAL
            a2c = EBLOCKCODE
            a2x = EBLOCKEXPR
            in2 = ECUR
            mut else_term: i64 = 0
            if e2 == 2 {
                else_term = 1
            }
            if else_term == 0 {
                e_emit("  br label %" + mb + "\n")
            }
            e_emit(mb + ":\n")
            ECUR = mb
            if then_term == 1 {
                if else_term == 1 {
                    ETERM = 1
                } else {
                    ETERM = 0
                }
            } else {
                ETERM = 0
            }
            # Statement value: phi of arm tails when both arms fall through
            # with same-typed trailing expressions; otherwise no value.
            EBLOCKEXPR = 0
            EBLOCKVAL = ""
            EBLOCKCODE = 0
            if then_term == 0 {
                if else_term == 0 {
                    if a1x == 1 {
                        if a2x == 1 {
                            if a1c == a2c {
                                if a1c != 0 {
                                    mp = e_fresh()
                                    e_emit("  " + mp + " = phi " + e_llvm_typecode(a1c) + " [" + a1v + ", %" + in1 + "], [" + a2v + ", %" + in2 + "]\n")
                                    EBLOCKEXPR = 1
                                    EBLOCKVAL = mp
                                    EBLOCKCODE = a1c
                                }
                            }
                        }
                    }
                }
            }
            1
        }
    }
}
# if expression: (if C T E) required; arms must be single-expr blocks
# (covers all corpus uses; multi-stmt value blocks are G2).
fn e_if_expr() -> str {
    c = e_expr()
    cc = ETYPE
    tb = e_label("if.then.")
    eb = e_label("if.else.")
    mb = e_label("if.end.")
    e_emit("  br i1 " + e_cond_emit(c, cc) + ", label %" + tb + ", label %" + eb + "\n")
    e_emit(tb + ":\n")
    ECUR = tb
    t1 = e_block_single_expr()
    t1c = ETYPE
    in1 = ECUR
    e_emit("  br label %" + mb + "\n")
    e_emit(eb + ":\n")
    ECUR = eb
    t2 = e_block_single_expr()
    t2c = ETYPE
    in2 = ECUR
    e_emit("  br label %" + mb + "\n")
    e_emit(mb + ":\n")
    ECUR = mb
    if t1c != t2c {
        EERR = EERR + 1
        print("emit error: if-expr arms must match types in G1")
        return ""
    }
    mut ty: str = "i64"
    if t1c == 2 {
        ty = "double"
    }
    p = e_fresh()
    e_emit("  " + p + " = phi " + ty + " [" + t1 + ", %" + in1 + "], [" + t2 + ", %" + in2 + "]\n")
    ETYPE = t1c
    p
}
# Block with exactly one bare-expression statement; returns its value.
fn e_block_single_expr() -> str {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        w = e_word()
        if w == "block" {
            1
        } else {
            EERR = EERR + 1
            return ""
        }
        v = e_expr()
        e_skip()
        if e_peek() == 41 {
            e_adv()
            v
        } else {
            EERR = EERR + 1
            print("emit error: if-expr arms must be single expressions in G1")
            e_skip_balanced()
            ""
        }
    } else {
        EERR = EERR + 1
        ""
    }
}
# (for V ITER BODY): desugared counter/index loops. ITER is (range A B)
# or an array/str value. The loop variable is a fresh versioned i64 local;
# break/continue work via EBREAK/ECONT exactly like while.
fn e_for() -> i64 {
    e_skip()
    v = e_word()
    e_skip()
    pos0 = e_pos()
    mut isrange: i64 = 0
    if e_peek() == 40 {
        e_adv()
        e_skip()
        w = e_word()
        if w == "range" {
            isrange = 1
        } else {
            flint_vec_set(EC, 0, pos0)
        }
    } else {
        EERR = EERR + 1
        print("emit error: for needs an iterator")
        return 0
    }
    cb = e_label("for.cond.")
    bb = e_label("for.body.")
    sb = e_label("for.step.")
    eb = e_label("for.end.")
    if isrange == 1 {
        a = e_expr()
        ac = ETYPE
        b = e_expr()
        bc = ETYPE
        if ac != 1 {
            EERR = EERR + 1
            print("emit error: range bounds need i64")
            return 0
        }
        if bc != 1 {
            EERR = EERR + 1
            print("emit error: range bounds need i64")
            return 0
        }
        e_skip()
        if e_peek() == 41 {
            e_adv()
        } else {
            EERR = EERR + 1
            return 0
        }
        e_declare_var(v, 1, a)
        en = e_fresh()
        e_emit("  " + en + " = alloca i64\n")
        e_emit("  store i64 " + b + ", ptr " + en + "\n")
        e_emit("  br label %" + cb + "\n")
        e_emit(cb + ":\n")
        ECUR = cb
        cur = e_fresh()
        e_emit("  " + cur + " = load i64, ptr " + e_var_addr(v) + "\n")
        lim = e_fresh()
        e_emit("  " + lim + " = load i64, ptr " + en + "\n")
        cc = e_fresh()
        e_emit("  " + cc + " = icmp slt i64 " + cur + ", " + lim + "\n")
        e_emit("  br i1 " + cc + ", label %" + bb + ", label %" + eb + "\n")
        e_emit(bb + ":\n")
        ECUR = bb
        saved_b = EBREAK
        saved_c = ECONT
        EBREAK = eb
        ECONT = sb
        t = e_block()
        EBREAK = saved_b
        ECONT = saved_c
        if t == 2 {
            ETERM = 0
        } else {
            e_emit("  br label %" + sb + "\n")
            ETERM = 0
        }
        # Step: checked +1 (same overflow panic as `i = i + 1`).
        e_emit(sb + ":\n")
        ECUR = sb
        cur2 = e_fresh()
        e_emit("  " + cur2 + " = load i64, ptr " + e_var_addr(v) + "\n")
        ao = e_fresh()
        e_emit("  " + ao + " = call {{i64, i1}} @llvm.sadd.with.overflow.i64(i64 " + cur2 + ", i64 1)\n")
        av = e_fresh()
        e_emit("  " + av + " = extractvalue {{i64, i1}} " + ao + ", 0\n")
        af = e_fresh()
        e_emit("  " + af + " = extractvalue {{i64, i1}} " + ao + ", 1\n")
        pb = e_label("for.ovf.")
        okb = e_label("for.ok.")
        e_emit("  br i1 " + af + ", label %" + pb + ", label %" + okb + "\n")
        e_emit(pb + ":\n")
        mn = e_panic_msg("for increment overflow")
        e_emit("  call void @flint_panic(ptr " + mn + ")\n")
        e_emit("  br label %" + okb + "\n")
        e_emit(okb + ":\n")
        ECUR = okb
        e_emit("  store i64 " + av + ", ptr " + e_var_addr(v) + "\n")
        e_emit("  br label %" + cb + "\n")
        e_emit(eb + ":\n")
        ECUR = eb
        EBLOCKEXPR = 0
        EBLOCKVAL = ""
        EBLOCKCODE = 0
        1
    } else {
        it = e_expr()
        itc = ETYPE
        if itc != 4 {
            if itc != 3 {
                EERR = EERR + 1
                print("emit error: for needs range, array or str")
                return 0
            }
        }
        mut lval: str = ""
        if itc == 4 {
            ln = e_fresh()
            e_emit("  " + ln + " = extractvalue {{ptr, i64}} " + it + ", 1\n")
            lval = ln
        } else {
            ln2 = e_fresh()
            e_emit("  " + ln2 + " = call i64 @flint_str_length(ptr " + it + ")\n")
            lval = ln2
        }
        ix = e_fresh()
        e_emit("  " + ix + " = alloca i64\n")
        e_emit("  store i64 0, ptr " + ix + "\n")
        lh = e_fresh()
        e_emit("  " + lh + " = alloca i64\n")
        e_emit("  store i64 " + lval + ", ptr " + lh + "\n")
        e_emit("  br label %" + cb + "\n")
        e_emit(cb + ":\n")
        ECUR = cb
        cur = e_fresh()
        e_emit("  " + cur + " = load i64, ptr " + ix + "\n")
        lim = e_fresh()
        e_emit("  " + lim + " = load i64, ptr " + lh + "\n")
        cc = e_fresh()
        e_emit("  " + cc + " = icmp slt i64 " + cur + ", " + lim + "\n")
        e_emit("  br i1 " + cc + ", label %" + bb + ", label %" + eb + "\n")
        e_emit(bb + ":\n")
        ECUR = bb
        mut ev: str = ""
        if itc == 4 {
            dp = e_fresh()
            e_emit("  " + dp + " = extractvalue {{ptr, i64}} " + it + ", 0\n")
            ep = e_fresh()
            e_emit("  " + ep + " = getelementptr i64, ptr " + dp + ", i64 " + cur + "\n")
            evv = e_fresh()
            e_emit("  " + evv + " = load i64, ptr " + ep + "\n")
            ev = evv
        } else {
            ep2 = e_fresh()
            e_emit("  " + ep2 + " = getelementptr i8, ptr " + it + ", i64 " + cur + "\n")
            by = e_fresh()
            e_emit("  " + by + " = load i8, ptr " + ep2 + "\n")
            ev2 = e_fresh()
            e_emit("  " + ev2 + " = zext i8 " + by + " to i64\n")
            ev = ev2
        }
        e_declare_var(v, 1, ev)
        saved_b = EBREAK
        saved_c = ECONT
        EBREAK = eb
        ECONT = sb
        t = e_block()
        EBREAK = saved_b
        ECONT = saved_c
        if t == 2 {
            ETERM = 0
        } else {
            e_emit("  br label %" + sb + "\n")
            ETERM = 0
        }
        # Step: plain +1 (idx stays below len, cannot overflow).
        e_emit(sb + ":\n")
        ECUR = sb
        cur2 = e_fresh()
        e_emit("  " + cur2 + " = load i64, ptr " + ix + "\n")
        nxt = e_fresh()
        e_emit("  " + nxt + " = add i64 " + cur2 + ", 1\n")
        e_emit("  store i64 " + nxt + ", ptr " + ix + "\n")
        e_emit("  br label %" + cb + "\n")
        e_emit(eb + ":\n")
        ECUR = eb
        EBLOCKEXPR = 0
        EBLOCKVAL = ""
        EBLOCKCODE = 0
        1
    }
}
# ---- G5: structs, enums, match ----
# Named-type lookup: code (5+) or -1.
fn e_ent_lookup(name: str) -> i64 {
    if ENTMAP.has(name) == 1 {
        ENTMAP.get(name)
    } else {
        -1
    }
}
# Field/variant index by name, or -1.
fn e_ent_field(code: i64, fname: str) -> i64 {
    n = flint_vec_get(ENTN, code - 100)
    base = flint_vec_get(ENTBase, code - 100)
    mut i: i64 = 0
    mut found: i64 = -1
    while i < n {
        off = flint_vec_get(ENFNameOff, base + i)
        ln = flint_vec_get(ENFNameLen, base + i)
        fnm = flint_str_substring(ENTTEXT, off, off + ln)
        if fnm == fname {
            found = i
            i = n
        } else {
            i = i + 1
        }
    }
    found
}
# Named-type source name by code.
fn e_ent_name(code: i64) -> str {
    no = flint_vec_get(ENTNameOff, code - 100)
    nl = flint_vec_get(ENTNameLen, code - 100)
    flint_str_substring(ENTTEXT, no, no + nl)
}
# LP64 alloc size by typecode (all scalars are 8/8; named via ENTSIZE).
fn e_type_size(code: i64) -> i64 {
    if code == 1 {
        8
    } else {
        if code == 2 {
            8
        } else {
            if code == 3 {
                8
            } else {
                if code == 4 {
                    16
                } else {
                    if code == 6 {
                        8
                    } else {
                        if code == 7 {
                            8
                        } else {
                            if code == 8 {
                                8
                            } else {
                                if code >= 100 {
                                    flint_vec_get(ENTSIZE, code - 100)
                                } else {
                                    8
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
# Align-up off to multiple of 8 (all our alignments are 8).
fn e_align8(off: i64) -> i64 {
    t = off + 7
    t2 = t / 8
    t2 * 8
}
# Laid-out size of a variant struct {i8 tag, payloads...} (C++ mirror).
fn e_variant_size(code: i64, vidx: i64) -> i64 {
    base = flint_vec_get(ENTBase, code - 100)
    np = flint_vec_get(ENFNP, base + vidx)
    pb = flint_vec_get(ENFPB, base + vidx)
    mut off: i64 = 1
    mut k: i64 = 0
    while k < np {
        tc = flint_vec_get(ENFPT, pb + k)
        off = e_align8(off)
        off = off + e_type_size(tc)
        k = k + 1
    }
    e_align8(off)
}
# Byte offset of payload j in variant vidx (for manual layouts).
fn e_payload_off(code: i64, vidx: i64, j: i64) -> i64 {
    base = flint_vec_get(ENTBase, code - 100)
    pb = flint_vec_get(ENFPB, base + vidx)
    mut off: i64 = 1
    mut k: i64 = 0
    while k < j {
        tc = flint_vec_get(ENFPT, pb + k)
        off = e_align8(off)
        off = off + e_type_size(tc)
        k = k + 1
    }
    e_align8(off)
}
# LLVM struct text {i8, T0, ...} for variant vidx (bitcast/GEP use).
fn e_variant_type(code: i64, vidx: i64) -> str {
    base = flint_vec_get(ENTBase, code - 100)
    np = flint_vec_get(ENFNP, base + vidx)
    pb = flint_vec_get(ENFPB, base + vidx)
    sb = flint_sb_new()
    flint_sb_append(sb, "{{i8")
    mut k: i64 = 0
    while k < np {
        tc = flint_vec_get(ENFPT, pb + k)
        flint_sb_append(sb, ", ")
        flint_sb_append(sb, e_llvm_typecode(tc))
        k = k + 1
    }
    flint_sb_append(sb, "}")
    r = flint_sb_build(sb)
    flint_sb_free(sb)
    r
}
# Uniform single-payload signature of enum: count or code, -1 if none or
# heterogeneous (for unwrap, which needs a static result type).
fn e_enum_payload_sig(code: i64, which: i64) -> i64 {
    n = flint_vec_get(ENTN, code - 100)
    base = flint_vec_get(ENTBase, code - 100)
    mut cnt: i64 = -1
    mut cod: i64 = -1
    mut i: i64 = 0
    mut ok: i64 = 1
    while i < n {
        np = flint_vec_get(ENFNP, base + i)
        if np > 0 {
            pb = flint_vec_get(ENFPB, base + i)
            c0 = flint_vec_get(ENFPT, pb)
            if cnt == -1 {
                cnt = np
                cod = c0
            } else {
                if np != cnt {
                    ok = 0
                } else {
                    if c0 != cod {
                        ok = 0
                    }
                }
            }
        }
        i = i + 1
    }
    if ok == 0 {
        -1
    } else {
        if which == 0 {
            cnt
        } else {
            cod
        }
    }
}
# Scan `(struct NAME ((F TYPE)*))`; cursor past `struct`.
fn e_scan_struct() -> i64 {
    e_skip()
    nm = e_word()
    lk = e_ent_lookup(nm)
    if lk != -1 {
        EERR = EERR + 1
        print("emit error: duplicate type")
        print(nm)
        return 0
    }
    code = ENTNEXT
    ENTNEXT = ENTNEXT + 1
    ENTMAP.set(nm, code)
    noff = flint_str_length(ENTTEXT)
    ENTTEXT = ENTTEXT + nm
    flint_vec_push(ENTNameOff, noff)
    flint_vec_push(ENTNameLen, flint_str_length(nm))
    flint_vec_push(ENTKind, 0)
    flint_vec_push(ENTN, 0)
    flint_vec_push(ENTBase, flint_vec_len(ENFCode))
    flint_vec_push(ENTBodyOff, 0)
    flint_vec_push(ENTBodyLen, 0)
    flint_vec_push(ENTSIZE, 0)
    exs = e_expect(40)
    if exs == 0 {
        return 0
    }
    sb = flint_sb_new()
    mut n: i64 = 0
    mut go: i64 = 1
    mut ok: i64 = 1
    mut sz: i64 = 0
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                e_adv()
                e_skip()
                fn2 = e_word()
                ft = e_word()
                ftc = e_ann_code(ft)
                if ftc == 0 {
                    EERR = EERR + 1
                    print("emit error: bad struct field type")
                    print(fn2)
                    ok = 0
                }
                fx = e_ent_field(code, fn2)
                if fx != -1 {
                    EERR = EERR + 1
                    print("emit error: duplicate struct field")
                    print(fn2)
                    ok = 0
                }
                e_skip()
                if e_peek() == 41 {
                    e_adv()
                } else {
                    EERR = EERR + 1
                    ok = 0
                }
                off = flint_str_length(ENTTEXT)
                ENTTEXT = ENTTEXT + fn2
                flint_vec_push(ENFNameOff, off)
                flint_vec_push(ENFNameLen, flint_str_length(fn2))
                flint_vec_push(ENFCode, ftc)
                flint_vec_push(ENFNP, 0)
                flint_vec_push(ENFPB, 0)
                if n > 0 {
                    flint_sb_append(sb, ", ")
                }
                flint_sb_append(sb, e_llvm_typecode(ftc))
                sz = e_align8(sz)
                sz = sz + e_type_size(ftc)
                n = n + 1
                flint_vec_set(ENTN, code - 100, n)
            } else {
                EERR = EERR + 1
                ok = 0
                go = 0
            }
        }
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        ok = 0
    }
    flint_vec_set(ENTN, code - 100, n)
    flint_vec_set(ENTSIZE, code - 100, e_align8(sz))
    flint_sb_append(sb, "}")
    body = "{{" + flint_sb_build(sb)
    flint_sb_free(sb)
    boff = flint_str_length(ENTTEXT)
    ENTTEXT = ENTTEXT + body
    flint_vec_set(ENTBodyOff, code - 100, boff)
    flint_vec_set(ENTBodyLen, code - 100, flint_str_length(body))
    ok
}
# Skip `KIND NAME TYPE INIT` remainder of a scanned top-level global.
fn e_skip_global() -> i64 {
    e_word()
    e_word()
    e_word()
    e_skip_value()
}
# Top-level `fn` dispatch: first main wins (merged imports may repeat it).
fn e_fn_top() -> i64 {
    e_skip()
    pos0 = e_pos()
    nm = e_word()
    if nm == "main" {
        if EMAINDONE == 1 {
            flint_vec_set(EC, 0, pos0)
            e_word()
            e_skip_balanced_fn()
            e_skip_balanced()
            e_word()
            e_skip_balanced()
            1
        } else {
            flint_vec_set(EC, 0, pos0)
            e_fn_body()
        }
    } else {
        flint_vec_set(EC, 0, pos0)
        e_fn_body()
    }
}
# Skip `NAME (...)` remainder of an already-scanned type declaration.
fn e_skip_type_decl() -> i64 {
    e_word()
    e_skip_balanced()
}
# Scan `(enum NAME ((V)*))`; cursor past `enum`. Payload variants are
# rejected (need G7): only tag-only enums in G5.
fn e_scan_enum() -> i64 {
    e_skip()
    nm = e_word()
    lk = e_ent_lookup(nm)
    if lk != -1 {
        EERR = EERR + 1
        print("emit error: duplicate type")
        print(nm)
        return 0
    }
    code = ENTNEXT
    ENTNEXT = ENTNEXT + 1
    ENTMAP.set(nm, code)
    noff = flint_str_length(ENTTEXT)
    ENTTEXT = ENTTEXT + nm
    flint_vec_push(ENTNameOff, noff)
    flint_vec_push(ENTNameLen, flint_str_length(nm))
    flint_vec_push(ENTKind, 1)
    flint_vec_push(ENTN, 0)
    flint_vec_push(ENTBase, flint_vec_len(ENFCode))
    flint_vec_push(ENTBodyOff, 0)
    flint_vec_push(ENTBodyLen, 0)
    flint_vec_push(ENTSIZE, 0)
    exs = e_expect(40)
    if exs == 0 {
        return 0
    }
    mut n: i64 = 0
    mut go: i64 = 1
    mut ok: i64 = 1
    mut maxvsz: i64 = 0
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                e_adv()
                e_skip()
                vn = e_word()
                vx = e_ent_field(code, vn)
                if vx != -1 {
                    EERR = EERR + 1
                    print("emit error: duplicate variant")
                    print(vn)
                    ok = 0
                }
                # Payload types: words until `)` (multi-payload allowed).
                pbase = flint_vec_len(ENFPT)
                mut np: i64 = 0
                mut pg: i64 = 1
                while pg == 1 {
                    e_skip()
                    if e_peek() == 41 {
                        pg = 0
                    } else {
                        if e_peek() == 40 {
                            EERR = EERR + 1
                            print("emit error: bad payload type")
                            print(vn)
                            ok = 0
                            e_skip_balanced()
                        } else {
                            pt = e_word()
                            ptc = e_ann_code(pt)
                            if ptc == 0 {
                                EERR = EERR + 1
                                print("emit error: bad payload type")
                                print(vn)
                                ok = 0
                            } else {
                                flint_vec_push(ENFPT, ptc)
                                np = np + 1
                            }
                        }
                    }
                }
                e_skip()
                if e_peek() == 41 {
                    e_adv()
                } else {
                    EERR = EERR + 1
                    ok = 0
                }
                off = flint_str_length(ENTTEXT)
                ENTTEXT = ENTTEXT + vn
                flint_vec_push(ENFNameOff, off)
                flint_vec_push(ENFNameLen, flint_str_length(vn))
                flint_vec_push(ENFCode, 0)
                flint_vec_push(ENFNP, np)
                flint_vec_push(ENFPB, pbase)
                n = n + 1
                flint_vec_set(ENTN, code - 100, n)
                if np > 0 {
                    flint_vec_set(ENTKind, code - 100, 2)
                    vsz = e_variant_size(code, n - 1)
                    if vsz > maxvsz {
                        maxvsz = vsz
                    }
                }
            } else {
                EERR = EERR + 1
                ok = 0
                go = 0
            }
        }
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        ok = 0
    }
    kk = flint_vec_get(ENTKind, code - 100)
    if kk == 2 {
        if maxvsz < 2 {
            maxvsz = 2
        }
        arrn = maxvsz - 1
        bs = "{{i8, [" + flint_i64_to_string(arrn) + " x i8]" + "}"
        boff = flint_str_length(ENTTEXT)
        ENTTEXT = ENTTEXT + bs
        flint_vec_set(ENTBodyOff, code - 100, boff)
        flint_vec_set(ENTBodyLen, code - 100, flint_str_length(bs))
        flint_vec_set(ENTSIZE, code - 100, maxvsz)
    } else {
        flint_vec_set(ENTSIZE, code - 100, 8)
    }
    ok
}
# ---- Entry-hoist pre-pass (dominance for self-hosting) ----
# C++ rejects shadowing, so one slot per (function, name) is sound. The
# pre-pass walks each body BEFORE emission, bumping versions and emitting
# every alloca at function entry; the emit pass then stores only. Both
# passes traverse identically (superset collection, no ETERM pruning), so
# versions always agree. The pre-pass consumes NO counters (deterministic).
# Allocate (bump + alloca + maps) for a pre-pass decl. No store.
# Allocas emit only in pre-pass phase (EPHASE==1); scan-phase inference
# (global inits) updates maps only — top-level IR must stay clean.
fn e_pre_declare(nm: str, code: i64) -> i64 {
    mut ver: i64 = 0
    if EVERSION.has(nm) == 1 {
        ver = EVERSION.get(nm) + 1
    }
    EVERSION.set(nm, ver)
    if EPHASE == 1 {
        an = e_var_addr(nm)
        e_emit("  " + an + " = alloca " + e_llvm_typecode(code) + "\n")
    }
    EMAP.set(nm, ESCOPE)
    ETYPEMAP.set(nm, code)
    0
}
# Pre-pass params from the registry (names stored at scan).
fn e_pre_params(idx: i64) -> i64 {
    n = flint_vec_get(EFNN, idx)
    base = flint_vec_get(EFNPB, idx)
    mut pi: i64 = 0
    while pi < n {
        no = flint_vec_get(EFPNOff, base + pi)
        nl = flint_vec_get(EFPNLen, base + pi)
        pn = flint_str_substring(ESIGTEXT, no, no + nl)
        if pn != "..." {
            ptc = flint_vec_get(EFPTYPE, base + pi)
            e_pre_declare(pn, ptc)
        }
        pi = pi + 1
    }
    0
}
# Consume the closing paren of a pre-pass form (all paths converge here
# with the cursor before their own `)` except rest-skipped forms).
fn e_pre_close() -> i64 {
    e_skip()
    if e_peek() == 41 {
        e_adv()
        1
    } else {
        EERR = EERR + 1
        0
    }
}
# Pre-pass one statement (cursor at `(`): collect decls, skip the rest.
fn e_pre_stmt() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        tag = e_word()
        if tag == "decl" {
            e_skip()
            k = e_word()
            nm = e_word()
            ty = e_word()
            mut dc: i64 = 0
            if ty == "-" {
                dc = e_infer_init()
            } else {
                dc = e_ann_code(ty)
                e_skip()
                if e_peek() == 40 {
                    e_skip_balanced()
                } else {
                    e_word()
                }
            }
            e_pre_declare(nm, dc)
            e_pre_close()
        } else {
            if tag == "if" {
                e_skip_value()
                e_pre_block()
                e_skip()
                if e_peek() == 41 {
                    e_pre_close()
                } else {
                    e_pre_block()
                    e_pre_close()
                }
            } else {
                if tag == "while" {
                    e_skip_value()
                    e_pre_block()
                    e_pre_close()
                } else {
                    if tag == "for" {
                        e_skip()
                        v = e_word()
                        e_skip()
                        pos0 = e_pos()
                        mut isrange: i64 = 0
                        if e_peek() == 40 {
                            e_adv()
                            e_skip()
                            w = e_word()
                            if w == "range" {
                                isrange = 1
                            } else {
                                flint_vec_set(EC, 0, pos0)
                            }
                        }
                        if isrange == 1 {
                            e_skip_value()
                            e_skip_value()
                            e_skip()
                            if e_peek() == 41 {
                                e_adv()
                            }
                        } else {
                            e_skip_value()
                        }
                        e_pre_declare(v, 1)
                        e_pre_block()
                        e_pre_close()
                    } else {
                        if tag == "match" {
                            e_skip_value()
                            exs = e_expect(40)
                            if exs == 0 {
                                return 0
                            }
                            e_skip()
                            aw = e_word()
                            if aw != "arms" {
                                EERR = EERR + 1
                                return 0
                            }
                            mut go: i64 = 1
                            while go == 1 {
                                e_skip()
                                if e_peek() == 41 {
                                    go = 0
                                } else {
                                    if e_peek() == 40 {
                                        e_adv()
                                        e_skip()
                                        if e_peek() == 40 {
                                            e_adv()
                                            e_skip()
                                            e_word()
                                            e_skip()
                                            pen2 = e_word()
                                            pvn2 = e_word()
                                            pbd2 = e_word()
                                            e_skip()
                                            if e_peek() == 41 {
                                                e_adv()
                                            }
                                            if pbd2 != "-" {
                                                ecode = e_ent_lookup(pen2)
                                                if ecode != -1 {
                                                    ek = flint_vec_get(ENTKind, ecode - 100)
                                                    if ek == 2 {
                                                        ex2 = e_ent_field(ecode, pvn2)
                                                        if ex2 != -1 {
                                                            ebase = flint_vec_get(ENTBase, ecode - 100)
                                                            enp = flint_vec_get(ENFNP, ebase + ex2)
                                                            if enp > 0 {
                                                                epb = flint_vec_get(ENFPB, ebase + ex2)
                                                                ep0 = flint_vec_get(ENFPT, epb)
                                                                e_pre_declare(pbd2, ep0)
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        } else {
                                            e_skip_balanced()
                                        }
                                        e_skip()
                                        ppos = e_pos()
                                        if e_peek() == 40 {
                                            e_adv()
                                            e_skip()
                                            bw = e_word()
                                            flint_vec_set(EC, 0, ppos)
                                            if bw == "block" {
                                                e_pre_block()
                                            } else {
                                                e_pre_stmt()
                                            }
                                        }
                                        e_skip()
                                        if e_peek() == 41 {
                                            e_adv()
                                        }
                                    } else {
                                        go = 0
                                    }
                                }
                            }
                            e_skip()
                            if e_peek() == 41 {
                                e_adv()
                            }
                            e_pre_close()
                        } else {
                            e_skip_rest()
                        }
                    }
                }
            }
        }
        1
    } else {
        e_adv()
        0
    }
}
# Pre-pass one `(block ...)`: collect all textual decls.
fn e_pre_block() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        w = e_word()
        if w != "block" {
            EERR = EERR + 1
            return 0
        }
        mut go: i64 = 1
        while go == 1 {
            e_skip()
            if e_peek() == 41 {
                go = 0
            } else {
                if e_peek() == -1 {
                    go = 0
                } else {
                    e_pre_stmt()
                }
            }
        }
        e_skip()
        if e_peek() == 41 {
            e_adv()
            1
        } else {
            EERR = EERR + 1
            0
        }
    } else {
        EERR = EERR + 1
        0
    }
}
fn e_while() -> i64 {
    cb = e_label("while.cond.")
    bb = e_label("while.body.")
    eb = e_label("while.end.")
    e_emit("  br label %" + cb + "\n")
    e_emit(cb + ":\n")
    ECUR = cb
    c = e_expr()
    cc = ETYPE
    e_emit("  br i1 " + e_cond_emit(c, cc) + ", label %" + bb + ", label %" + eb + "\n")
    e_emit(bb + ":\n")
    ECUR = bb
    saved_b = EBREAK
    saved_c = ECONT
    EBREAK = eb
    ECONT = cb
    t = e_block()
    EBREAK = saved_b
    ECONT = saved_c
    if t == 2 {
        ETERM = 0
    } else {
        e_emit("  br label %" + cb + "\n")
        ETERM = 0
    }
    e_emit(eb + ":\n")
    ECUR = eb
    # While is a statement: yields no value.
    EBLOCKEXPR = 0
    EBLOCKVAL = ""
    EBLOCKCODE = 0
    1
}
fn e_break() -> i64 {
    if EBREAK == "" {
        EERR = EERR + 1
        print("emit error: break outside loop")
        return 0
    }
    e_emit("  br label %" + EBREAK + "\n")
    ETERM = 1
    1
}
fn e_continue() -> i64 {
    if ECONT == "" {
        EERR = EERR + 1
        print("emit error: continue outside loop")
        return 0
    }
    e_emit("  br label %" + ECONT + "\n")
    ETERM = 1
    1
}
fn e_prelude_text() -> str {
    "@flint_g_argc = external global i64\n@flint_g_argv = external global ptr\ndeclare void @flint_panic(ptr)\ndeclare void @flint_println_str(ptr)\ndeclare void @flint_println_i64(i64)\ndeclare void @flint_println_f64(double)\ndeclare void @flint_bounds_check(i64, i64)\ndeclare i64 @flint_str_length(ptr)\ndeclare ptr @flint_str_concat(ptr, ptr)\ndeclare {{ptr, i64}} @flint_array_concat({{ptr, i64}}, {{ptr, i64}})\n"
}
# (fn main (tparams) () RET (block ...)). G0: main only, no params.
# Skip one balanced paren group, returning its inner text (for tparams/params
# which G0 ignores beyond validation).
fn e_skip_balanced_fn() -> str {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        mut depth: i64 = 1
        sb = flint_sb_new()
        n = flint_str_length(ESRC)
        mut go: i64 = 1
        while go == 1 {
            if e_pos() < n {
                as = e_at_str()
                if as == 1 {
                    sp = e_pos()
                    e_skip_str()
                    ep = e_pos()
                    flint_sb_append(sb, flint_str_substring(ESRC, sp, ep))
                } else {
                    c = e_adv()
                    if c == 40 {
                        depth = depth + 1
                        flint_sb_append_char(sb, c)
                    } else {
                        if c == 41 {
                            depth = depth - 1
                            if depth == 0 {
                                go = 0
                            } else {
                                flint_sb_append_char(sb, c)
                            }
                        } else {
                            flint_sb_append_char(sb, c)
                        }
                    }
                }
            } else {
                go = 0
            }
        }
        r = flint_sb_build(sb)
        flint_sb_free(sb)
        r
    } else {
        EERR = EERR + 1
        ""
    }
}
# Read raw inner text of one paren group (params ignored in G0 except shape).
fn e_read_paren_text() -> str {
    e_skip_balanced_fn()
}
fn e_prog() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        w = e_word()
        if w == "prog" {
            1
        } else {
            EERR = EERR + 1
            return 0
        }
        mut go: i64 = 1
        while go == 1 {
            e_skip()
            if e_peek() == 41 {
                go = 0
            } else {
                if e_peek() == -1 {
                    go = 0
                } else {
                    e_form()
                }
            }
        }
        e_skip()
        if e_peek() == 41 {
            e_adv()
            e_drain_lambdas()
        } else {
            EERR = EERR + 1
            0
        }
    } else {
        EERR = EERR + 1
        0
    }
}
# (fn-decl ...) after tag (cursor past `fn-decl` word): emit `declare`.
fn e_fn_decl_body() -> i64 {
    e_skip()
    nm = e_word()
    tp = e_skip_balanced_fn()
    idx = e_sig_lookup(nm)
    if idx == -1 {
        EERR = EERR + 1
        print("emit error: unscanned declaration")
        print(nm)
        return 0
    }
    n = flint_vec_get(EFNN, idx)
    base = flint_vec_get(EFNPB, idx)
    varg = flint_vec_get(EFNVAR, idx)
    ret = flint_vec_get(EFNRET, idx)
    ex1 = e_expect(40)
    if ex1 == 0 {
        return 0
    }
    sb = flint_sb_new()
    mut pi: i64 = 0
    mut pok: i64 = 1
    while pi < n {
        e_skip()
        if e_peek() == 40 {
            e_adv()
            e_skip()
            pn = e_word()
            pt = e_word()
            e_skip()
            if e_peek() == 40 {
                e_skip_balanced_fn()
            } else {
                e_word()
            }
            e_skip()
            if e_peek() == 41 {
                e_adv()
            } else {
                EERR = EERR + 1
                pok = 0
            }
            if pn == "..." {
                flint_sb_append(sb, ", ...")
            } else {
                if pi > 0 {
                    flint_sb_append(sb, ", ")
                }
                flint_sb_append(sb, e_llvm_typecode(flint_vec_get(EFPTYPE, base + pi)))
            }
        } else {
            EERR = EERR + 1
            pok = 0
        }
        pi = pi + 1
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        pok = 0
    }
    ps = flint_sb_build(sb)
    flint_sb_free(sb)
    if pok == 0 {
        return 0
    }
    rt = e_word()
    e_emit("declare " + e_llvm_typecode(ret) + " @" + nm + "(" + ps + ")\n")
    1
}
# Top-level form: fn (emit) or extern/import (ignore: builtins predeclared).
fn e_form() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        tag = e_word()
        mut r: i64 = 1
        if tag == "fn" {
            r = e_fn_top()
        } else {
            if tag == "fn-decl" {
                r = e_fn_decl_body()
            } else {
                if tag == "struct" {
                    # Already registered in scan pass; no IR to emit.
                    e_skip_type_decl()
                    r = 1
                } else {
                    if tag == "enum" {
                        e_skip_type_decl()
                        r = 1
                    } else {
                        if tag == "decl" {
                            # Global: scanned already; init emits in main prologue.
                            e_skip_global()
                            r = 1
                        } else {
                            if tag == "extern" {
                                r = e_emit_extern()
                            } else {
                                if tag == "import" {
                                    e_word()
                                    r = 1
                                } else {
                                    EERR = EERR + 1
                                    print("emit error: bad top-level form")
                                    print(tag)
                                    e_skip_balanced_fn()
                                    r = 0
                                }
                            }
                        }
                    }
                }
            }
        }
        e_skip()
        if e_peek() == 41 {
            e_adv()
            r
        } else {
            EERR = EERR + 1
            0
        }
    } else {
        EERR = EERR + 1
        e_adv()
        0
    }
}
# `(extern "C" DECLS)` emission; cursor past `extern`.
fn e_emit_extern() -> i64 {
    e_skip()
    lang = e_word()
    if lang != "\"C\"" {
        EERR = EERR + 1
        print("emit error: only extern C supported")
        return 0
    }
    mut go: i64 = 1
    mut ok: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                e_adv()
                e_skip()
                tag = e_word()
                if tag == "fn-decl" {
                    dr = e_fn_decl_body()
                    if dr == 0 {
                        ok = 0
                    }
                } else {
                    EERR = EERR + 1
                    print("emit error: bad extern member")
                    ok = 0
                }
                ex2 = e_expect(41)
                if ex2 == 0 {
                    return 0
                }
            } else {
                EERR = EERR + 1
                return 0
            }
        }
    }
    ok
}
# (fn ...) body after tag (cursor past `fn` word). Any function; main gets
# the argv-wrapper treatment and truncates its i64 return to i32.
fn e_fn_body() -> i64 {
    e_skip()
    nm = e_word()
    tp = e_skip_balanced_fn()
    if tp != "tparams" {
        EERR = EERR + 1
        print("emit error: generics need G6")
        return 0
    }
    idx = e_sig_lookup(nm)
    if idx == -1 {
        EERR = EERR + 1
        print("emit error: unscanned function")
        print(nm)
        return 0
    }
    n = flint_vec_get(EFNN, idx)
    base = flint_vec_get(EFNPB, idx)
    varg = flint_vec_get(EFNVAR, idx)
    ret = flint_vec_get(EFNRET, idx)
    mut ismain: i64 = 0
    if nm == "main" {
        ismain = 1
    }
    ex3 = e_expect(40)
    if ex3 == 0 {
        return 0
    }
    # Emit "RET name(T0 %p0.arg, ...)" while binding params.
    pstart = e_pos()
    sb = flint_sb_new()
    mut pi: i64 = 0
    mut pok: i64 = 1
    while pi < n {
        e_skip()
        if e_peek() == 40 {
            e_adv()
            e_skip()
            pn = e_word()
            pt = e_word()
            e_skip()
            if e_peek() == 40 {
                e_skip_balanced_fn()
            } else {
                e_word()
            }
            e_skip()
            if e_peek() == 41 {
                e_adv()
            } else {
                EERR = EERR + 1
                pok = 0
            }
            if pn == "..." {
                flint_sb_append(sb, ", ...")
            } else {
                if pi > 0 {
                    flint_sb_append(sb, ", ")
                }
                flint_sb_append(sb, e_llvm_typecode(flint_vec_get(EFPTYPE, base + pi)) + " %" + pn + ".arg")
            }
        } else {
            EERR = EERR + 1
            pok = 0
        }
        pi = pi + 1
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        pok = 0
    }
    ps = flint_sb_build(sb)
    flint_sb_free(sb)
    if pok == 0 {
        return 0
    }
    rt = e_word()
    if ismain == 1 {
        if n != 0 {
            EERR = EERR + 1
            print("emit error: main takes no params in G2")
            return 0
        }
        EMAINDONE = 1
        e_emit("define noundef i32 @main(i64 %flint_argc, ptr %flint_argv) local_unnamed_addr {{\n")
        e_emit("entry:\n")
    } else {
        e_emit("define " + e_llvm_typecode(ret) + " @" + nm + "(" + ps + ") local_unnamed_addr {{\n")
        e_emit("entry:\n")
    }
    ESCOPE = ESCOPE + 1
    EFNID = EFNID + 1
    EFNCUR = EFNID
    EFNRET_CUR = ret
    EFNMAIN = ismain
    EBLOCKEXPR = 0
    EBLOCKCODE = 0
    ECUR = "entry"
    # Entry-hoist pre-pass: params + body decls allocate here (dominance).
    EPHASE = 1
    e_pre_params(idx)
    bodypos = e_pos()
    e_pre_block()
    flint_vec_set(EC, 0, bodypos)
    # Main prologue (argv + global inits) lands after the allocas.
    if ismain == 1 {
        e_emit("  store i64 %flint_argc, ptr @flint_g_argc, align 8\n")
        e_emit("  store ptr %flint_argv, ptr @flint_g_argv, align 8\n")
        if e_emit_prologue_globals() == 0 {
            ESCOPE = ESCOPE - 1
            return 0
        }
    }
    # Second walk over the params text (rewind): bind allocas. The first
    # walk left the cursor after the params list; pstart rewinds it.
    flint_vec_set(EC, 0, pstart)
    mut bi: i64 = 0
    mut bok: i64 = 1
    while bi < n {
        e_skip()
        if e_peek() == 40 {
            e_adv()
            e_skip()
            bn = e_word()
            e_word()
            e_skip()
            if e_peek() == 40 {
                e_skip_balanced_fn()
            } else {
                e_word()
            }
            e_skip()
            if e_peek() == 41 {
                e_adv()
            } else {
                EERR = EERR + 1
                bok = 0
            }
            if bn != "..." {
                btc = flint_vec_get(EFPTYPE, base + bi)
                e_declare_var(bn, btc, "%" + bn + ".arg")
            }
        } else {
            EERR = EERR + 1
            bok = 0
        }
        bi = bi + 1
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
    } else {
        EERR = EERR + 1
        bok = 0
    }
    rt2 = e_word()
    if bok == 0 {
        ESCOPE = ESCOPE - 1
        return 0
    }
    br = e_block()
    ESCOPE = ESCOPE - 1
    snapx = EBLOCKEXPR
    snapv = EBLOCKVAL
    snapc = EBLOCKCODE
    snapr = EFNRET_CUR
    if br == 0 {
        0
    } else {
        if br == 2 {
            e_emit("}\n")
            1
        } else {
            # Fell through: implicit return of trailing expr value, else
            # zero of ret type (mirrors C++ fn-end fallback).
            if snapx == 1 {
                if snapc != 0 {
                    if ismain == 1 {
                        if snapc == 1 {
                            fr = e_fresh()
                            e_emit("  " + fr + " = trunc i64 " + EBLOCKVAL + " to i32\n")
                            e_emit("  ret i32 " + fr + "\n")
                            e_emit("}\n")
                            1
                        } else {
                            EERR = EERR + 1
                            print("emit error: main must return i64 in G2")
                            0
                        }
                    } else {
                        if snapr == 0 {
                            e_emit("  ret void\n")
                            e_emit("}\n")
                            1
                        } else {
                            if snapc == snapr {
                                e_emit("  ret " + e_llvm_typecode(snapr) + " " + snapv + "\n")
                                e_emit("}\n")
                                1
                            } else {
                                if snapc == 1 {
                                    if snapr == 2 {
                                        ft = e_fresh()
                                        e_emit("  " + ft + " = sitofp i64 " + EBLOCKVAL + " to double\n")
                                        e_emit("  ret double " + ft + "\n")
                                        e_emit("}\n")
                                        1
                                    } else {
                                        EERR = EERR + 1
                                        print("emit error: return type mismatch")
                                        0
                                    }
                                } else {
                                    EERR = EERR + 1
                                    print("emit error: return type mismatch")
                                    0
                                }
                            }
                        }
                    }
                } else {
                    e_emit("  ret " + e_llvm_typecode(EFNRET_CUR) + " " + e_llvm_zero(EFNRET_CUR) + "\n")
                    e_emit("}\n")
                    1
                }
            } else {
                if ismain == 1 {
                    e_emit("  ret i32 0\n")
                    e_emit("}\n")
                    1
                } else {
                    if snapr == 0 {
                        e_emit("  ret void\n")
                        e_emit("}\n")
                        1
                    } else {
                        e_emit("  ret " + e_llvm_typecode(EFNRET_CUR) + " " + e_llvm_zero(EFNRET_CUR) + "\n")
                        e_emit("}\n")
                        1
                    }
                }
            }
        }
    }
}
# ---- G2: multi-fn, calls, params/defaults, extern, general return ----
# Two passes: e_scan_prog records every signature (enables recursion and
# forward refs); e_prog then emits. Defaults are stored as S-expr text and
# sub-emitted at call sites missing args (mirrors C++ cloneExpr fill).
fn e_llvm_typecode(code: i64) -> str {
    mut r: str = "void"
    if code == 1 {
        r = "i64"
    } else {
        if code == 2 {
            r = "double"
        } else {
            if code == 3 {
                r = "ptr"
            } else {
                if code == 4 {
                    r = "{{ptr, i64}}"
                } else {
                    if code == 6 {
                        r = "ptr"
                    } else {
                        if code == 7 {
                            r = "ptr"
                        } else {
                            if code == 8 {
                                r = "ptr"
                            } else {
                                if code >= 100 {
                                    k = flint_vec_get(ENTKind, code - 100)
                                    if k == 1 {
                                        r = "i64"
                                    } else {
                                        bo = flint_vec_get(ENTBodyOff, code - 100)
                                        bl = flint_vec_get(ENTBodyLen, code - 100)
                                        r = flint_str_substring(ENTTEXT, bo, bo + bl)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    r
}
fn e_llvm_zero(code: i64) -> str {
    mut z: str = "0"
    if code == 2 {
        z = "0.0"
    } else {
        if code == 3 {
            z = "null"
        } else {
            if code == 4 {
                z = "zeroinitializer"
            } else {
                if code == 6 {
                    z = "null"
                } else {
                    if code == 7 {
                        z = "null"
                    } else {
                        if code == 8 {
                            z = "null"
                        }
                    }
                }
            }
        }
    }
    z
}
# Signature lookup: fnidx or -1.
fn e_sig_lookup(name: str) -> i64 {
    if EFNMAP.has(name) == 1 {
        EFNMAP.get(name)
    } else {
        -1
    }
}
# Scan one (NAME TYPE DEF) param entry; cursor past `(`. Records flat slot.
# Variadic `(... - -)` must be last. Returns 1 ok, 0 error.
fn e_scan_param(fnidx: i64) -> i64 {
    e_skip()
    nm = e_word()
    tp = e_word()
    if nm == "..." {
        # Entry shape is `(... - -)`: consume TYPE and DEF words too.
        e_word()
        e_word()
        flint_vec_set(EFNVAR, fnidx, 1)
        flint_vec_push(EFPTYPE, 0)
        flint_vec_push(EFPOFF, -1)
        flint_vec_push(EFPLEN, 0)
        noff = flint_str_length(ESIGTEXT)
        ESIGTEXT = ESIGTEXT + nm
        flint_vec_push(EFPNOff, noff)
        flint_vec_push(EFPNLen, flint_str_length(nm))
        e_skip()
        if e_peek() == 41 {
            e_adv()
            1
        } else {
            EERR = EERR + 1
            print("emit error: variadic must be last param")
            0
        }
    } else {
        vv = flint_vec_get(EFNVAR, fnidx)
        if vv == 1 {
            EERR = EERR + 1
            print("emit error: param after variadic")
            print(nm)
            0
        } else {
            mut tc: i64 = e_ann_code(tp)
            if tp == "-" {
                # Untyped param: i64 like C++ (handles flow via conversions).
                tc = 1
            }
            if tc == 0 {
                EERR = EERR + 1
                print("emit error: param type needs G3+")
                print(nm)
                0
            } else {
                e_skip()
                mut dov: i64 = -1
                mut dln: i64 = 0
                if e_peek() == 40 {
                    inner = e_skip_balanced_fn()
                    dov = flint_str_length(ESIGTEXT)
                    dln = flint_str_length(inner)
                    ESIGTEXT = ESIGTEXT + inner
                } else {
                    w = e_word()
                    if w == "-" {
                        dov = -1
                    } else {
                        dov = flint_str_length(ESIGTEXT)
                        dln = flint_str_length(w)
                        ESIGTEXT = ESIGTEXT + w
                    }
                }
                flint_vec_push(EFPTYPE, tc)
                flint_vec_push(EFPOFF, dov)
                flint_vec_push(EFPLEN, dln)
                noff = flint_str_length(ESIGTEXT)
                ESIGTEXT = ESIGTEXT + nm
                flint_vec_push(EFPNOff, noff)
                flint_vec_push(EFPNLen, flint_str_length(nm))
                e_skip()
                if e_peek() == 41 {
                    e_adv()
                    1
                } else {
                    EERR = EERR + 1
                    0
                }
            }
        }
    }
}
# Scan `(fn NAME TP (PARAMS) RET [BODY])` or `(fn-decl ...)`; cursor past
# the tag word. ext=1 for extern declarations. Skips bodies. Returns 1/0.
fn e_scan_fn(isdecl: i64, ext: i64) -> i64 {
    e_skip()
    nm = e_word()
    if nm == "print" {
        EERR = EERR + 1
        print("emit error: print is reserved")
        return 0
    }
    lk = e_sig_lookup(nm)
    if lk != -1 {
        if nm == "main" {
            # Merged duplicate main: consume and ignore (first wins).
            e_skip_balanced_fn()
            e_skip_balanced()
            e_word()
            e_skip()
            if e_peek() == 40 {
                e_skip_balanced()
            }
            return 1
        }
        EERR = EERR + 1
        print("emit error: duplicate function")
        print(nm)
        return 0
    }
    tp = e_skip_balanced_fn()
    if tp != "tparams" {
        EERR = EERR + 1
        print("emit error: generics need G6")
        print(nm)
        return 0
    }
    fnidx = flint_vec_len(EFNN)
    flint_vec_push(EFNN, 0)
    flint_vec_push(EFNRET, 0)
    flint_vec_push(EFNVAR, 0)
    flint_vec_push(EFNPB, flint_vec_len(EFPTYPE))
    flint_vec_push(EFNEXT, ext)
    EFNMAP.set(nm, fnidx)
    ex4 = e_expect(40)
    if ex4 == 0 {
        return 0
    }
    mut n: i64 = 0
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == -1 {
                EERR = EERR + 1
                return 0
            } else {
                if e_peek() == 40 {
                    e_adv()
                    pr = e_scan_param(fnidx)
                    if pr == 0 {
                        return 0
                    }
                    n = n + 1
                } else {
                    EERR = EERR + 1
                    return 0
                }
            }
        }
    }
    ex5 = e_expect(41)
    if ex5 == 0 {
        return 0
    }
    flint_vec_set(EFNN, fnidx, n)
    ret = e_word()
    if ret == "-" {
        if nm == "main" {
            flint_vec_set(EFNRET, fnidx, 1)
        } else {
            EERR = EERR + 1
            print("emit error: return annotation needed in G2")
            print(nm)
            return 0
        }
    } else {
        rc = e_ann_code(ret)
        if rc == 0 {
            EERR = EERR + 1
            print("emit error: return type needs G3+")
            print(nm)
            return 0
        }
        flint_vec_set(EFNRET, fnidx, rc)
    }
    e_skip()
    if isdecl == 0 {
        if e_peek() == 40 {
            e_skip_balanced()
        } else {
            EERR = EERR + 1
            print("emit error: fn body must be a block")
            print(nm)
            return 0
        }
    }
    1
}
# Scan `(extern "C" DECLS)`; cursor past `extern`.
fn e_scan_extern() -> i64 {
    e_skip()
    lang = e_word()
    if lang != "\"C\"" {
        EERR = EERR + 1
        print("emit error: only extern C supported")
        return 0
    }
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == 40 {
                e_adv()
                e_skip()
                tag = e_word()
                if tag == "fn-decl" {
                    sr = e_scan_fn(1, 1)
                    if sr == 0 {
                        return 0
                    }
                } else {
                    EERR = EERR + 1
                    print("emit error: bad extern member")
                    print(tag)
                    return 0
                }
                ex6 = e_expect(41)
                if ex6 == 0 {
                    return 0
                }
            } else {
                EERR = EERR + 1
                return 0
            }
        }
    }
    1
}
# Scan one top-level form (no output). Returns 1 ok, 0 error.
fn e_scan_form() -> i64 {
    e_skip()
    if e_peek() == 40 {
        e_adv()
        e_skip()
        tag = e_word()
        mut r: i64 = 1
        if tag == "fn" {
            r = e_scan_fn(0, 0)
        } else {
            if tag == "struct" {
                r = e_scan_struct()
            } else {
                if tag == "enum" {
                    r = e_scan_enum()
                } else {
                    if tag == "decl" {
                        r = e_scan_global()
                    } else {
                        if tag == "fn-decl" {
                            r = e_scan_fn(1, 0)
                        } else {
                            if tag == "extern" {
                                r = e_scan_extern()
                            } else {
                                if tag == "import" {
                                    e_word()
                                    r = 1
                                } else {
                                    EERR = EERR + 1
                                    print("emit error: bad top-level form")
                                    print(tag)
                                    e_skip_balanced_fn()
                                    r = 0
                                }
                            }
                        }
                    }
                }
            }
        }
        e_skip()
        if e_peek() == 41 {
            e_adv()
            r
        } else {
            EERR = EERR + 1
            0
        }
    } else {
        EERR = EERR + 1
        e_adv()
        0
    }
}
# Pass 1: register all signatures. Cursor must be at 0.
fn e_scan_prog() -> i64 {
    e_skip()
    ex0 = e_expect(40)
    if ex0 == 0 {
        return 0
    }
    e_skip()
    w0 = e_word()
    if w0 != "prog" {
        EERR = EERR + 1
        return 0
    }
    mut go: i64 = 1
    while go == 1 {
        e_skip()
        if e_peek() == 41 {
            go = 0
        } else {
            if e_peek() == -1 {
                go = 0
            } else {
                e_scan_form()
            }
        }
    }
    e_skip()
    if e_peek() == 41 {
        e_adv()
        1
    } else {
        EERR = EERR + 1
        0
    }
}
# Sub-emit a stored default S-expr (inner text at off/len) in the CALLER's
# scope. Defaults referencing params fail with undefined-variable.
fn e_eval_default(off: i64, len: i64) -> str {
    saved = ESRC
    savedp = e_pos()
    ESRC = "(" + flint_str_substring(ESIGTEXT, off, off + len) + ")"
    flint_vec_set(EC, 0, 0)
    v = e_expr()
    c = ETYPE
    ESRC = saved
    flint_vec_set(EC, 0, savedp)
    ETYPE = c
    v
}
# ---- driver ----
fn main() -> i64 {
    if flint_arg_count() < 3 {
        print("usage: flint_emit <prog.sexp> <out.ll>")
        return 1
    }
    path = flint_get_arg(1)
    outp = flint_get_arg(2)
    ESRC = flint_read_file(path)
    if flint_err_occurred() == 1 {
        print("cannot read file")
        return 1
    }
    if flint_vec_len(EC) == 0 {
        flint_vec_push(EC, 0)
    } else {
        flint_vec_set(EC, 0, 0)
    }
    EERR = 0
    # Prelude-declared runtime fns must not be re-declared by auto-declare.
    ERTDECL.set("flint_panic", 1)
    ERTDECL.set("flint_println_str", 1)
    ERTDECL.set("flint_println_i64", 1)
    ERTDECL.set("flint_println_f64", 1)
    ERTDECL.set("flint_bounds_check", 1)
    ERTDECL.set("flint_str_length", 1)
    ERTDECL.set("flint_str_concat", 1)
    ERTDECL.set("flint_array_concat", 1)
    # Pass 1: signatures. Pass 2: rewind and emit.
    e_scan_prog()
    if EERR > 0 {
        print("emit failed")
        return 1
    }
    flint_vec_set(EC, 0, 0)
    e_prog()
    if EERR > 0 {
        print("emit failed")
        return 1
    }
    # Assemble: prelude + string globals + body (globals must precede use).
    body = flint_sb_build(EOUT)
    flint_sb_free(EOUT)
    globs = flint_sb_build(EGLOB)
    flint_sb_free(EGLOB)
    txt = e_prelude_text() + globs + body
    r = flint_write_file(outp, txt)
    if r == 0 {
        0
    } else {
        print("cannot write file")
        1
    }
}
