#!/data/data/com.termux/files/usr/bin/env python3
"""flint-doc — Documentation generator for Flint source files.

Extracts comments, function/struct/enum signatures, and generates
rich Markdown documentation.

Usage: flint-doc [--output <file.md>] <file.fl> [file2.fl ...]
"""

import sys
import re
import os

# Reuse the lexer
FLINT_KEYWORDS = {
    "fn", "let", "mut", "var", "def", "if", "else", "elif", "while", "for",
    "in", "return", "break", "match", "enum", "struct", "import", "extern",
    "python", "try", "parallel", "i64", "f64", "str", "bool", "ptr",
    "true", "false",
}

def tokenize(source):
    tokens = []
    i = 0
    line = 1
    col = 1
    while i < len(source):
        c = source[i]
        start_col = col
        if c in " \t\r":
            i += 1
            col += 1
            continue
        if c == "\n":
            line += 1
            col = 1
            i += 1
            tokens.append(("NEWLINE", "\n", line, col))
            continue
        if c == "#":
            start = i
            while i < len(source) and source[i] != "\n":
                i += 1
                col += 1
            tokens.append(("COMMENT", source[start:i], line, col - (i - start)))
            continue
        if c == "/" and i + 1 < len(source) and source[i + 1] == "/":
            start = i
            while i < len(source) and source[i] != "\n":
                i += 1
                col += 1
            tokens.append(("COMMENT", source[start:i], line, col - (i - start)))
            continue
        if c == '"':
            i += 1
            col += 1
            start = i
            while i < len(source) and source[i] != '"':
                if source[i] == "\\": i += 1; col += 1
                i += 1
                col += 1
            if i < len(source):
                tokens.append(("STRING", source[start:i], line, start_col))
                i += 1
                col += 1
            continue
        if c.isalpha() or c == "_":
            start = i
            while i < len(source) and (source[i].isalnum() or source[i] == "_"):
                i += 1
                col += 1
            word = source[start:i]
            tt = "KEYWORD" if word in FLINT_KEYWORDS else "IDENTIFIER"
            tokens.append((tt, word, line, start_col))
            continue
        if c.isdigit():
            start = i
            while i < len(source) and source[i].isdigit():
                i += 1
                col += 1
            if i < len(source) and source[i] == ".":
                i += 1
                col += 1
                while i < len(source) and source[i].isdigit():
                    i += 1
                    col += 1
            tokens.append(("NUMBER", source[start:i], line, start_col))
            continue
        pairs = {
            "==": "OP", "!=": "OP", "<=": "OP", ">=": "OP",
            ":=": "OP", "|>": "OP", "->": "OP", "..": "OP",
            "||": "OP", "&&": "OP",
        }
        if i + 1 < len(source) and source[i:i+2] in pairs:
            tokens.append((pairs[source[i:i+2]], source[i:i+2], line, col))
            i += 2; col += 2; continue
        SINGLE = {
            "(": "LPAREN", ")": "RPAREN", "{": "LBRACE", "}": "RBRACE",
            "[": "LBRACKET", "]": "RBRACKET", ";": "SEMICOLON", ",": "COMMA",
            ":": "COLON", ".": "DOT", "+": "PLUS", "-": "MINUS", "*": "STAR",
            "/": "SLASH", "%": "MOD", "=": "ASSIGN", "<": "LT", ">": "GT",
            "!": "NOT", "&": "AMPERSAND", "@": "AT", "|": "PIPE", "?": "QUESTION",
        }
        if c in SINGLE:
            tokens.append((SINGLE[c], c, line, col))
            i += 1; col += 1; continue
        i += 1; col += 1
    return tokens

def extract_doc(source, filepath):
    tokens = tokenize(source)
    lines = source.split("\n")
    out = []
    filename = os.path.basename(filepath)
    out.append(f"## {filename} (`{filepath}`)")
    out.append("")

    # Find comment blocks and their following declarations
    i = 0
    while i < len(tokens):
        tt, text, t_line, t_col = tokens[i]
        if tt == "COMMENT":
            comment_lines = [text]
            j = i + 1
            while j < len(tokens) and tokens[j][0] == "COMMENT":
                comment_lines.append(tokens[j][1])
                j += 1
            # Check what follows the comment block
            # Skip NEWLINEs
            k = j
            while k < len(tokens) and tokens[k][0] == "NEWLINE":
                k += 1
            if k < len(tokens) and tokens[k][0] == "KEYWORD" and tokens[k][1] in ("fn", "struct", "enum"):
                # This comment documents the following declaration
                kw = tokens[k][1]
                # Skip to get the name
                k2 = k + 1
                while k2 < len(tokens) and tokens[k2][0] in ("NEWLINE",):
                    k2 += 1
                decl_name = tokens[k2][1] if k2 < len(tokens) and tokens[k2][0] == "IDENTIFIER" else ""
                # Collect signature until '{' or end
                sig_parts = []
                sig_k = k
                while sig_k < len(tokens) and tokens[sig_k][0] not in ("NEWLINE",):
                    tok_text = tokens[sig_k][1]
                    sig_parts.append(tok_text)
                    if tok_text == "{":
                        sig_k += 1
                        break
                    sig_k += 1
                sig = ""
                for sp in sig_parts:
                    if sp in ("(", ")", "[", "]", ",", ";", ":") and sig and sig[-1] == " ":
                        sig = sig.rstrip()
                    sig += sp
                    if sp not in ("(", "["):
                        sig += " "
                sig = sig.strip()
                out.append(f"### {kw} `{decl_name}`")
                out.append("")
                out.append(f"```flint\n{sig}\n```")
                out.append("")
                # Emit comment as description
                doc_text = []
                for cl in comment_lines:
                    cl_text = cl.lstrip("# ")
                    doc_text.append(cl_text)
                out.append("\n".join(doc_text))
                out.append("")
            else:
                # Orphan comment - emit as-is
                for cl in comment_lines:
                    out.append(cl.lstrip("#"))
                out.append("")
            i = j
        elif tt == "KEYWORD" and text in ("fn", "struct", "enum") and (i == 0 or tokens[i-1][0] != "COMMENT"):
            # Declaration without preceding comment
            kw = text
            sig_parts = []
            k = i
            while k < len(tokens) and tokens[k][0] not in ("NEWLINE",):
                tok_text = tokens[k][1]
                sig_parts.append(tok_text)
                if tok_text == "{":
                    k += 1
                    break
                k += 1
            sig = ""
            for sp in sig_parts:
                if sp in ("(", ")", "[", "]", ",", ";", ":") and sig and sig[-1] == " ":
                    sig = sig.rstrip()
                sig += sp
                if sp not in ("(", "["):
                    sig += " "
            sig = sig.strip()
            out.append(f"### {kw}")
            out.append("")
            out.append(f"```flint\n{sig}\n```")
            out.append("")
            i = k
        else:
            i += 1

    return "\n".join(out)

def main():
    output_path = None
    files = []
    args = sys.argv[1:]
    while args:
        a = args.pop(0)
        if a == "--output" and args:
            output_path = args.pop(0)
        else:
            files.append(a)

    if not files:
        print("Usage: flint-doc [--output <file.md>] <file.fl> [file2.fl ...]", file=sys.stderr)
        sys.exit(1)

    parts = ["# Flint Documentation", ""]
    for path in files:
        if not os.path.exists(path):
            print(f"error: file not found: {path}", file=sys.stderr)
            sys.exit(1)
        with open(path) as f:
            source = f.read()
        parts.append(extract_doc(source, path))

    result = "\n".join(parts)
    if output_path:
        with open(output_path, "w") as f:
            f.write(result)
        print(f"wrote: {output_path}")
    else:
        print(result)

if __name__ == "__main__":
    main()
