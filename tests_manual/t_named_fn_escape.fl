# A NAMED function's value may cross a return boundary.
#
# It used to be refused ("cannot return a function value: it would escape
# its defining frame"). A named function captures nothing, so its box is a
# module-level constant -- it does not depend on the frame that is going
# away, and a value that depends on no frame may escape.
#
# The other half of the rule (a closure that DOES capture still cannot) is
# pinned by t_capturing_escape.fl.

fn inc(x: i64) -> i64 { return x + 1 }

fn get() -> fn(i64) -> i64 {
    h = inc
    return h
}

fn main() {
    f = get()
    print(f(5))
}
